msgctxt "Addon Summary"
msgid "Jellyfin client for seamless Kodi integration"
msgstr "Jellyfin-client voor naadloze Kodi-integratie"

msgctxt "Addon Description"
msgid "Play movies, shows & music from a Jellyfin server."
msgstr "Speel films, series en muziek af van een Jellyfin-server."

msgctxt "#30010"
msgid "Play with transcoding"
msgstr "Afspelen met transcoderen"

msgctxt "#30011"
msgid "Quick Connect"
msgstr "Quick Connect"

msgctxt "#30012"
msgid "Username and password"
msgstr "Gebruikersnaam en wachtwoord"

msgctxt "#30013"
msgid "Username"
msgstr "Gebruikersnaam"

msgctxt "#30014"
msgid "Password"
msgstr "Wachtwoord"

msgctxt "#30015"
msgid "Enter code [B]%s[/B] in the Jellyfin app or web interface."
msgstr "Voer code [B]%s[/B] in de Jellyfin-app of webinterface in."

msgctxt "#30016"
msgid "Logged in as %s"
msgstr "Aangemeld als %s"

msgctxt "#30017"
msgid "Login failed: wrong username or password"
msgstr "Aanmelden mislukt: verkeerde gebruikersnaam of wachtwoord"

msgctxt "#30018"
msgid "Server unreachable"
msgstr "Server onbereikbaar"

msgctxt "#30019"
msgid "Log out from %s?"
msgstr "Afmelden bij %s?"

msgctxt "#30020"
msgid "Logged out"
msgstr "Afgemeld"

msgctxt "#30021"
msgid "Connection OK — %s (%s)"
msgstr "Verbinding OK — %s (%s)"

msgctxt "#30022"
msgid "Session rejected — log in again from the Account tab"
msgstr "Sessie geweigerd — meld je opnieuw aan op het tabblad Account"

msgctxt "#30023"
msgid "Restarting the Kofin service"
msgstr "Kofin-dienst wordt herstart"

msgctxt "#30024"
msgid "Quick Connect timed out"
msgstr "Time-out van Quick Connect"

msgctxt "#30025"
msgid "Already logged in"
msgstr "Al aangemeld"

msgctxt "#30026"
msgid "Not logged in"
msgstr "Niet aangemeld"

msgctxt "#30027"
msgid "Log in to %s"
msgstr "Aanmelden bij %s"

msgctxt "#30050"
msgid "Account"
msgstr "Account"

msgctxt "#30051"
msgid "Connect to your Jellyfin server and manage the session."
msgstr "Maak verbinding met je Jellyfin-server en beheer de sessie."

msgctxt "#30052"
msgid "Server address"
msgstr "Serveradres"

msgctxt "#30053"
msgid "Host name, IP address or full URL of the Jellyfin server. A bare host uses http on port 8096."
msgstr "Hostnaam, IP-adres of volledige URL van de Jellyfin-server. Een kale hostnaam gebruikt http op poort 8096."

msgctxt "#30054"
msgid "Log in…"
msgstr "Aanmelden…"

msgctxt "#30055"
msgid "Connect to the server above using Quick Connect or a username and password."
msgstr "Maak verbinding met de server hierboven via Quick Connect of met een gebruikersnaam en wachtwoord."

msgctxt "#30056"
msgid "Server"
msgstr "Server"

msgctxt "#30057"
msgid "The connected Jellyfin server."
msgstr "De verbonden Jellyfin-server."

msgctxt "#30058"
msgid "Logged-in user"
msgstr "Aangemelde gebruiker"

msgctxt "#30059"
msgid "The Jellyfin user this device plays and reports as."
msgstr "De Jellyfin-gebruiker waarmee dit apparaat afspeelt en rapporteert."

msgctxt "#30060"
msgid "Test connection"
msgstr "Verbinding testen"

msgctxt "#30061"
msgid "Check that the server is reachable and the session is still valid."
msgstr "Controleer of de server bereikbaar is en de sessie nog geldig is."

msgctxt "#30062"
msgid "Log out"
msgstr "Afmelden"

msgctxt "#30063"
msgid "End the session on the server and forget it on this device. The server address is kept."
msgstr "Beëindig de sessie op de server en vergeet die op dit apparaat. Het serveradres blijft bewaard."

msgctxt "#30064"
msgid "Restart Kofin"
msgstr "Kofin herstarten"

msgctxt "#30065"
msgid "Restart the background service without restarting Kodi."
msgstr "Herstart de achtergronddienst zonder Kodi te herstarten."

msgctxt "#30066"
msgid "Verify SSL certificate"
msgstr "SSL-certificaat verifiëren"

msgctxt "#30067"
msgid "Disable only for servers with self-signed certificates."
msgstr "Schakel dit alleen uit voor servers met een zelfondertekend certificaat."

msgctxt "#30068"
msgid "Device name"
msgstr "Apparaatnaam"

msgctxt "#30069"
msgid "How this device appears in the Jellyfin dashboard and cast menus."
msgstr "Hoe dit apparaat verschijnt in het Jellyfin-dashboard en in castmenu's."

msgctxt "#30070"
msgid "Connection"
msgstr "Verbinding"

msgctxt "#30071"
msgid "Advanced"
msgstr "Geavanceerd"

msgctxt "#30072"
msgid "SSL verification and other advanced options."
msgstr "SSL-verificatie en andere geavanceerde opties."

msgctxt "#30073"
msgid "Enable Delete from server"
msgstr "Verwijderen van server inschakelen"

msgctxt "#30074"
msgid "Adds a Delete entry to an item's 'Jellyfin actions' context menu. Deletion is permanent: the file itself is removed on the Jellyfin server, for every user."
msgstr "Voegt een optie 'Verwijderen' toe aan het contextmenu 'Jellyfin-acties' van een item. Verwijderen is definitief: het bestand zelf wordt van de Jellyfin-server verwijderd, voor alle gebruikers."

msgctxt "#30075"
msgid "Delete without confirmation"
msgstr "Verwijderen zonder bevestiging"

msgctxt "#30076"
msgid "Delete the item as soon as the entry is picked, with no 'are you sure?' prompt. The deletion is still permanent and applies on the server."
msgstr "Verwijder het item zodra de optie wordt gekozen, zonder 'weet je het zeker?'-vraag. Het verwijderen is nog steeds definitief en geldt op de server."

msgctxt "#30077"
msgid "Offer to delete after watching"
msgstr "Verwijderen aanbieden na het kijken"

msgctxt "#30078"
msgid "When a movie or episode finishes, ask whether to delete it from the server. Always asks, whatever 'Delete without confirmation' is set to."
msgstr "Vraag na afloop van een film of aflevering of die van de server verwijderd moet worden. Vraagt altijd, ongeacht hoe 'Verwijderen zonder bevestiging' is ingesteld."

msgctxt "#30079"
msgid "Who's watching shortlist"
msgstr "Shortlist voor 'Wie kijkt er?'"

msgctxt "#30080"
msgid "Choose which server users the addon's Who's watching? entry offers. \"All\" offers everyone. With nothing selected the entry is hidden and anyone already on the session is removed."
msgstr "Kies welke servergebruikers de optie 'Wie kijkt er?' van de add-on aanbiedt. \"Alle\" biedt iedereen aan. Zonder selectie verdwijnt de optie en wordt iedereen die al in de sessie zit verwijderd."

msgctxt "#30030"
msgid "All"
msgstr "Alles"

msgctxt "#30031"
msgid "Recently added"
msgstr "Recent toegevoegd"

msgctxt "#30032"
msgid "Next up"
msgstr "Volgende aflevering"

msgctxt "#30033"
msgid "In progress"
msgstr "Bezig met kijken"

msgctxt "#30034"
msgid "Unwatched"
msgstr "Niet bekeken"

msgctxt "#30035"
msgid "Favourites"
msgstr "Favorieten"

msgctxt "#30036"
msgid "Genres"
msgstr "Genres"

msgctxt "#30037"
msgid "Random"
msgstr "Willekeurig"

msgctxt "#30038"
msgid "Sets"
msgstr "Filmreeksen"

msgctxt "#30039"
msgid "Artists"
msgstr "Artiesten"

msgctxt "#30040"
msgid "Albums"
msgstr "Albums"

msgctxt "#30049"
msgid "Continue watching"
msgstr "Verder kijken"

msgctxt "#30100"
msgid "Transcoding"
msgstr "Transcoderen"

msgctxt "#30101"
msgid "When and how the server converts media for this device."
msgstr "Wanneer en hoe de server media omzet voor dit apparaat."

msgctxt "#30102"
msgid "Force direct play"
msgstr "Direct afspelen forceren"

msgctxt "#30103"
msgid "Always play the original video file. Overrides every other video transcoding setting; playback fails if the device cannot handle the media. Music is unaffected — see 'Transcode music'."
msgstr "Speel altijd het originele videobestand af. Overschrijft alle andere instellingen voor videotranscodering; het afspelen mislukt als het apparaat de media niet aankan. Muziek valt hierbuiten — zie 'Muziek transcoderen'."

msgctxt "#30104"
msgid "Force remux"
msgstr "Remuxen forceren"

msgctxt "#30105"
msgid "Repackage the stream without re-encoding video. Use when the container causes problems but the codecs are fine."
msgstr "Verpak de stream opnieuw zonder de video te hercoderen. Gebruik dit wanneer de container problemen geeft maar de codecs in orde zijn."

msgctxt "#30106"
msgid "Force transcode"
msgstr "Transcoderen forceren"

msgctxt "#30107"
msgid "Always re-encode on the server. Highest server load; use for troubleshooting or very constrained clients."
msgstr "Hercodeer altijd op de server. Hoogste serverbelasting; gebruik dit voor probleemoplossing of zeer beperkte clients."

msgctxt "#30108"
msgid "Direct play video codecs"
msgstr "Videocodecs voor direct afspelen"

msgctxt "#30109"
msgid "Video formats this device can decode. Media using formats not selected here is transcoded."
msgstr "Videoformaten die dit apparaat kan decoderen. Media in niet-geselecteerde formaten worden getranscodeerd."

msgctxt "#30110"
msgid "Direct play audio codecs"
msgstr "Audiocodecs voor direct afspelen"

msgctxt "#30111"
msgid "Audio formats this device can decode or pass through. Others are transcoded."
msgstr "Audioformaten die dit apparaat kan decoderen of doorgeven. Andere worden getranscodeerd."

msgctxt "#30112"
msgid "Allowed HDR types"
msgstr "Toegestane HDR-typen"

msgctxt "#30113"
msgid "HDR formats the display accepts. Media in formats not selected is tone-mapped or transcoded to SDR/HDR10 by the server."
msgstr "HDR-formaten die het scherm accepteert. Media in niet-geselecteerde formaten worden door de server via tone-mapping of transcodering omgezet naar SDR/HDR10."

msgctxt "#30114"
msgid "Preferred video codec"
msgstr "Voorkeurscodec voor video"

msgctxt "#30115"
msgid "The codec the server targets when it must transcode video."
msgstr "De codec die de server nastreeft wanneer video getranscodeerd moet worden."

msgctxt "#30116"
msgid "Preferred audio codec"
msgstr "Voorkeurscodec voor audio"

msgctxt "#30117"
msgid "The codec the server targets when it must transcode audio."
msgstr "De codec die de server nastreeft wanneer audio getranscodeerd moet worden."

msgctxt "#30118"
msgid "Maximum audio channels"
msgstr "Maximaal aantal audiokanalen"

msgctxt "#30119"
msgid "Maximum number of audio channels allowed when transcoding. Streams with more channels will be downmixed. No effect on direct playback."
msgstr "Maximaal aantal audiokanalen dat bij het transcoderen is toegestaan. Streams met meer kanalen worden gedownmixt. Geen effect op direct afspelen."

msgctxt "#30120"
msgid "Maximum streaming bitrate"
msgstr "Maximale streamingbitrate"

msgctxt "#30121"
msgid "Media above this bitrate is transcoded down to it. Unlimited suits LAN playback."
msgstr "Media boven deze bitrate worden ernaartoe getranscodeerd. Onbeperkt is geschikt voor afspelen in het lokale netwerk."

msgctxt "#30122"
msgid "Maximum resolution"
msgstr "Maximale resolutie"

msgctxt "#30123"
msgid "Wider media is downscaled by the server."
msgstr "Bredere media worden door de server verkleind."

msgctxt "#30124"
msgid "Transcode audio bitrate"
msgstr "Audiobitrate bij transcoderen"

msgctxt "#30125"
msgid "Bitrate for the audio track when video is transcoded."
msgstr "Bitrate voor het audiospoor wanneer video wordt getranscodeerd."

msgctxt "#30126"
msgid "Context menu bitrates"
msgstr "Bitrates in het contextmenu"

msgctxt "#30127"
msgid "Bitrates offered by 'Play with transcoding'. With exactly one selected the popup is skipped."
msgstr "Bitrates die 'Afspelen met transcoderen' aanbiedt. Bij precies één selectie wordt de pop-up overgeslagen."

msgctxt "#30128"
msgid "Music"
msgstr "Muziek"

msgctxt "#30129"
msgid "Maximum music bitrate"
msgstr "Maximale muziekbitrate"

msgctxt "#30130"
msgid "Music above this bitrate is transcoded using the codec and bitrate below. Unlimited never transcodes."
msgstr "Muziek boven deze bitrate wordt getranscodeerd met de codec en bitrate hieronder. Onbeperkt transcodeert nooit."

msgctxt "#30131"
msgid "Music transcode codec"
msgstr "Codec voor muziektranscodering"

msgctxt "#30132"
msgid "Codec for transcoded music streams."
msgstr "Codec voor getranscodeerde muziekstreams."

msgctxt "#30133"
msgid "Music transcode bitrate"
msgstr "Bitrate voor muziektranscodering"

msgctxt "#30134"
msgid "Bitrate for transcoded music streams."
msgstr "Bitrate voor getranscodeerde muziekstreams."

msgctxt "#30135"
msgid "Transcode music"
msgstr "Muziek transcoderen"

msgctxt "#30136"
msgid "Route music playback through the add-on so the settings below apply. Off, songs stream straight from the server untouched. Changing this needs a library repair of your music libraries to rewrite their paths."
msgstr "Leid het afspelen van muziek via de add-on, zodat de instellingen hieronder gelden. Staat dit uit, dan streamen nummers ongewijzigd rechtstreeks van de server. Een wijziging vereist een bibliotheekreparatie van je muziekbibliotheken om hun paden te herschrijven."

