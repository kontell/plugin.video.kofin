msgctxt "#30250"
msgid "Library"
msgstr "Bibliotheek"

msgctxt "#30251"
msgid "Select and manage the Jellyfin libraries mirrored into Kodi's own database."
msgstr "Selecteer en beheer de Jellyfin-bibliotheken die naar Kodi's eigen database worden gespiegeld."

msgctxt "#30252"
msgid "Select libraries to sync"
msgstr "Bibliotheken kiezen om te synchroniseren"

msgctxt "#30253"
msgid "Choose which server libraries are mirrored into the Kodi library. Changes apply when you confirm the selection."
msgstr "Kies welke serverbibliotheken naar de Kodi-bibliotheek worden gespiegeld. Wijzigingen gaan in zodra je de selectie bevestigt."

msgctxt "#30254"
msgid "Synced libraries"
msgstr "Gesynchroniseerde bibliotheken"

msgctxt "#30255"
msgid "The libraries currently mirrored into the Kodi database."
msgstr "De bibliotheken die momenteel naar de Kodi-database worden gespiegeld."

msgctxt "#30256"
msgid "Update libraries"
msgstr "Bibliotheken bijwerken"

msgctxt "#30257"
msgid "Catch up with server changes and prune removed items from the libraries you pick. Runs when you confirm the selection."
msgstr "Loop serverwijzigingen in en verwijder gewiste items uit de bibliotheken die je kiest. Wordt uitgevoerd zodra je de selectie bevestigt."

msgctxt "#30258"
msgid "Repair libraries"
msgstr "Bibliotheken repareren"

msgctxt "#30259"
msgid "Remove and re-sync the libraries you pick from scratch, restoring watched state from the server. Runs when you confirm the selection."
msgstr "Verwijder de bibliotheken die je kiest en synchroniseer ze helemaal opnieuw, waarbij de bekeken-status van de server wordt hersteld. Wordt uitgevoerd zodra je de selectie bevestigt."

msgctxt "#30260"
msgid "Refresh boxsets"
msgstr "Filmreeksen vernieuwen"

msgctxt "#30261"
msgid "Rebuild movie set links from the server's collections. Runs immediately."
msgstr "Bouw de koppelingen van filmreeksen opnieuw op uit de collecties van de server. Wordt meteen uitgevoerd."

msgctxt "#30262"
msgid "Sync status"
msgstr "Synchronisatiestatus"

msgctxt "#30263"
msgid "Companion plugin tier and schema-gate state."
msgstr "Niveau van de companion-plug-in en status van de schemacontrole."

msgctxt "#30264"
msgid "Remove synced library?"
msgstr "Gesynchroniseerde bibliotheek verwijderen?"

msgctxt "#30265"
msgid "Remove %s from the Kodi library? The items are deleted from this device only."
msgstr "%s uit de Kodi-bibliotheek verwijderen? De items worden alleen van dit apparaat verwijderd."

msgctxt "#30266"
msgid "Repair which libraries?"
msgstr "Welke bibliotheken repareren?"

msgctxt "#30267"
msgid "All"
msgstr "Alles"

msgctxt "#30268"
msgid "Select libraries"
msgstr "Bibliotheken selecteren"

msgctxt "#30269"
msgid "No libraries available"
msgstr "Geen bibliotheken beschikbaar"

msgctxt "#30270"
msgid "Update which libraries?"
msgstr "Welke bibliotheken bijwerken?"

msgctxt "#30300"
msgid "Sync"
msgstr "Synchronisatie"

msgctxt "#30301"
msgid "How library changes are downloaded and written."
msgstr "Hoe bibliotheekwijzigingen worden gedownload en weggeschreven."

msgctxt "#30302"
msgid "Hide update status below (items)"
msgstr "Statusweergave hieronder verbergen (items)"

msgctxt "#30303"
msgid "Hide Kodi's library-update progress for syncs smaller than this. 0 always shows it."
msgstr "Verberg Kodi's voortgangsweergave voor bibliotheekupdates bij synchronisaties kleiner dan dit. 0 toont die altijd."

msgctxt "#30306"
msgid "Sync during video playback"
msgstr "Synchroniseren tijdens het afspelen van video"

msgctxt "#30307"
msgid "Keep applying library updates while a video is playing."
msgstr "Blijf bibliotheekupdates toepassen terwijl er een video speelt."

msgctxt "#30310"
msgid "Items per request"
msgstr "Items per aanvraag"

msgctxt "#30311"
msgid "Page size for library downloads. Recommended: 50."
msgstr "Paginagrootte voor bibliotheekdownloads. Aanbevolen: 50."

msgctxt "#30312"
msgid "Download threads"
msgstr "Downloadthreads"

msgctxt "#30313"
msgid "Parallel download connections during sync. Recommended: 3; raise only for a fast server."
msgstr "Parallelle downloadverbindingen tijdens de synchronisatie. Aanbevolen: 3; verhoog dit alleen bij een snelle server."

msgctxt "#30314"
msgid "Artwork"
msgstr "Afbeeldingen"

msgctxt "#30318"
msgid "Compress artwork"
msgstr "Afbeeldingen comprimeren"

msgctxt "#30319"
msgid "Re-encode capped artwork at JPEG quality 90. No effect without a resolution cap."
msgstr "Hercodeer begrensde afbeeldingen met JPEG-kwaliteit 90. Zonder resolutiebegrenzing heeft dit geen effect."

msgctxt "#30320"
msgid "Maximum artwork resolution"
msgstr "Maximale resolutie van afbeeldingen"

msgctxt "#30321"
msgid "Cap the height of synced artwork. Original keeps the server size."
msgstr "Begrens de hoogte van gesynchroniseerde afbeeldingen. 'Origineel' behoudt de grootte van de server."

msgctxt "#30322"
msgid "Original"
msgstr "Origineel"

msgctxt "#30323"
msgid "720p"
msgstr "720p"

msgctxt "#30324"
msgid "1080p"
msgstr "1080p"

msgctxt "#30325"
msgid "2160p"
msgstr "2160p"

