msgstr "Reaguj na segmenty multimediów"

msgctxt "#30454"
msgid "Fetch Jellyfin media segments (intro, credits, recap, preview, commercial) during playback and act on them per type."
msgstr "Pobiera segmenty multimediów Jellyfin (czołówka, napisy końcowe, streszczenie, zapowiedź, reklama) podczas odtwarzania i reaguje na nie zależnie od typu."

msgctxt "#30455"
msgid "Intros"
msgstr "Czołówki"

msgctxt "#30456"
msgid "Off ignores intro segments, Auto skips past them, Ask shows a skip button."
msgstr "Wyłączone ignoruje segmenty czołówki, Automatycznie je pomija, Pytaj pokazuje przycisk pominięcia."

msgctxt "#30457"
msgid "Credits"
msgstr "Napisy końcowe"

msgctxt "#30458"
msgid "Off ignores credits, Auto seeks past them, Ask offers Skip Outro — with Play Next when a next episode exists."
msgstr "Wyłączone ignoruje napisy końcowe, Automatycznie je przewija, Pytaj proponuje Pomiń napisy końcowe — a gdy istnieje następny odcinek, także Odtwórz następny."

msgctxt "#30459"
msgid "Recaps"
msgstr "Streszczenia"

msgctxt "#30460"
msgid "Off ignores recap segments, Auto skips past them, Ask shows a skip button."
msgstr "Wyłączone ignoruje segmenty streszczenia, Automatycznie je pomija, Pytaj pokazuje przycisk pominięcia."

msgctxt "#30461"
msgid "Previews"
msgstr "Zapowiedzi"

msgctxt "#30462"
msgid "Off ignores preview segments, Auto skips past them, Ask shows a skip button."
msgstr "Wyłączone ignoruje segmenty zapowiedzi, Automatycznie je pomija, Pytaj pokazuje przycisk pominięcia."

msgctxt "#30463"
msgid "Commercials"
msgstr "Reklamy"

msgctxt "#30464"
msgid "Off ignores commercial segments, Auto skips past them, Ask shows a skip button."
msgstr "Wyłączone ignoruje segmenty reklam, Automatycznie je pomija, Pytaj pokazuje przycisk pominięcia."

