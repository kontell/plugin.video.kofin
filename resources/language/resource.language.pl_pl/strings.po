msgstr "Pomiń czołówkę"

msgctxt "#30482"
msgid "Skip Outro"
msgstr "Pomiń napisy końcowe"

msgctxt "#30483"
msgid "Skip Recap"
msgstr "Pomiń streszczenie"

msgctxt "#30484"
msgid "Skip Preview"
msgstr "Pomiń zapowiedź"

msgctxt "#30485"
