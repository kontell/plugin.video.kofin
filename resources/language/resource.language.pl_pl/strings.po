msgctxt "#30041"
msgid "Who's watching?"
msgstr "Kto ogląda?"

msgctxt "#30042"
msgid "Add a user"
msgstr "Dodaj użytkownika"

msgctxt "#30043"
msgid "Remove a user"
msgstr "Usuń użytkownika"

msgctxt "#30044"
msgid "Select user"
msgstr "Wybierz użytkownika"

msgctxt "#30045"
msgid "No active session on the server yet"
msgstr "Brak aktywnej sesji na serwerze"

msgctxt "#30046"
msgid "Who's watching? (%s)"
msgstr "Kto ogląda? (%s)"

msgctxt "#30047"
msgid "Who's watching with %s?"
msgstr "Kto ogląda razem z %s?"

msgctxt "#30048"
msgid "Who can be added to the session"
msgstr "Kogo można dodać do sesji"

msgctxt "#30250"
msgid "Library"
msgstr "Biblioteka"

msgctxt "#30251"
msgid "Select and manage the Jellyfin libraries mirrored into Kodi's own database."
msgstr "Wybieraj biblioteki Jellyfin odwzorowywane w bazie danych Kodi i zarządzaj nimi."

msgctxt "#30252"
msgid "Select libraries to sync"
msgstr "Wybierz biblioteki do synchronizacji"

msgctxt "#30253"
msgid "Choose which server libraries are mirrored into the Kodi library. Changes apply when you confirm the selection."
msgstr "Wybierz, które biblioteki serwera są odwzorowywane w bibliotece Kodi. Zmiany zostaną zastosowane po zatwierdzeniu wyboru."

msgctxt "#30254"
msgid "Synced libraries"
msgstr "Zsynchronizowane biblioteki"

msgctxt "#30255"
msgid "The libraries currently mirrored into the Kodi database."
msgstr "Biblioteki obecnie odwzorowane w bazie danych Kodi."

msgctxt "#30256"
msgid "Update libraries"
msgstr "Aktualizuj biblioteki"

msgctxt "#30257"
msgid "Catch up with server changes and prune removed items from the libraries you pick. Runs when you confirm the selection."
msgstr "Nadrabia zmiany z serwera i usuwa skasowane pozycje z wybranych bibliotek. Uruchamia się po zatwierdzeniu wyboru."

msgctxt "#30258"
msgid "Repair libraries"
msgstr "Napraw biblioteki"

msgctxt "#30259"
msgid "Remove and re-sync the libraries you pick from scratch, restoring watched state from the server. Runs when you confirm the selection."
msgstr "Usuwa i synchronizuje wybrane biblioteki od zera, przywracając stan obejrzenia z serwera. Uruchamia się po zatwierdzeniu wyboru."

msgctxt "#30260"
msgid "Refresh boxsets"
msgstr "Odśwież kolekcje"

msgctxt "#30261"
msgid "Rebuild movie set links from the server's collections. Runs immediately."
msgstr "Odbudowuje powiązania kolekcji filmowych na podstawie kolekcji z serwera. Uruchamia się natychmiast."

msgctxt "#30262"
msgid "Sync status"
msgstr "Stan synchronizacji"

msgctxt "#30263"
msgid "Companion plugin tier and schema-gate state."
msgstr "Poziom wtyczki towarzyszącej i stan bramki schematu bazy."

msgctxt "#30264"
msgid "Remove synced library?"
msgstr "Usunąć zsynchronizowaną bibliotekę?"

msgctxt "#30265"
msgid "Remove %s from the Kodi library? The items are deleted from this device only."
msgstr "Usunąć %s z biblioteki Kodi? Pozycje zostaną skasowane tylko na tym urządzeniu."

msgctxt "#30266"
msgid "Repair which libraries?"
msgstr "Które biblioteki naprawić?"

msgctxt "#30267"
msgid "All"
msgstr "Wszystkie"

msgctxt "#30268"
msgid "Select libraries"
msgstr "Wybierz biblioteki"

msgctxt "#30269"
msgid "No libraries available"
msgstr "Brak dostępnych bibliotek"

msgctxt "#30270"
msgid "Update which libraries?"
msgstr "Które biblioteki zaktualizować?"

msgctxt "#30300"
msgid "Sync"
msgstr "Synchronizacja"

msgctxt "#30301"
msgid "How library changes are downloaded and written."
msgstr "Jak zmiany w bibliotece są pobierane i zapisywane."

msgctxt "#30302"
msgid "Hide update status below (items)"
msgstr "Ukryj status aktualizacji poniżej (pozycji)"

msgctxt "#30303"
msgid "Hide Kodi's library-update progress for syncs smaller than this. 0 always shows it."
