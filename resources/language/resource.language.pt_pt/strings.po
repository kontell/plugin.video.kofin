msgstr "Reproduzir a seguir"

msgctxt "#30469"
msgid "Offer Play Next"
msgstr "Oferecer Reproduzir a seguir"

msgctxt "#30470"
msgid "Offer the next episode at the credits, or near the end when no credits segment exists."
msgstr "Oferece o episódio seguinte nos créditos, ou perto do fim quando não existe segmento de créditos."

msgctxt "#30471"
msgid "Play Next lead time"
msgstr "Antecedência de Reproduzir a seguir"

msgctxt "#30472"
msgid "Seconds before the end to show the Play Next prompt for content without a credits segment."
msgstr "Segundos antes do fim para mostrar o aviso de Reproduzir a seguir em conteúdos sem segmento de créditos."

msgctxt "#30473"
msgid "Autoplay next episode"
msgstr "Reproduzir o episódio seguinte automaticamente"

msgctxt "#30474"
msgid "Count down on the Play Next prompt and start the next episode automatically."
msgstr "Faz a contagem decrescente no aviso de Reproduzir a seguir e inicia o episódio seguinte automaticamente."

msgctxt "#30475"
