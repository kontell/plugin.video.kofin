msgctxt "#30041"
msgid "Who's watching?"
msgstr "Quem está a ver?"

msgctxt "#30042"
msgid "Add a user"
msgstr "Adicionar um utilizador"

msgctxt "#30043"
msgid "Remove a user"
msgstr "Remover um utilizador"

msgctxt "#30044"
msgid "Select user"
msgstr "Selecionar utilizador"

msgctxt "#30045"
msgid "No active session on the server yet"
msgstr "Ainda não há sessão ativa no servidor"

msgctxt "#30046"
msgid "Who's watching? (%s)"
msgstr "Quem está a ver? (%s)"

msgctxt "#30047"
msgid "Who's watching with %s?"
msgstr "Quem está a ver com %s?"

msgctxt "#30048"
msgid "Who can be added to the session"
msgstr "Quem pode ser adicionado à sessão"

msgctxt "#30250"
msgid "Library"
msgstr "Biblioteca"

msgctxt "#30251"
msgid "Select and manage the Jellyfin libraries mirrored into Kodi's own database."
msgstr "Selecione e faça a gestão das bibliotecas Jellyfin espelhadas na base de dados do próprio Kodi."

msgctxt "#30252"
msgid "Select libraries to sync"
msgstr "Selecionar bibliotecas a sincronizar"

msgctxt "#30253"
msgid "Choose which server libraries are mirrored into the Kodi library. Changes apply when you confirm the selection."
msgstr "Escolha que bibliotecas do servidor são espelhadas na biblioteca do Kodi. As alterações aplicam-se ao confirmar a seleção."

msgctxt "#30254"
msgid "Synced libraries"
msgstr "Bibliotecas sincronizadas"

msgctxt "#30255"
msgid "The libraries currently mirrored into the Kodi database."
msgstr "As bibliotecas atualmente espelhadas na base de dados do Kodi."

msgctxt "#30256"
msgid "Update libraries"
msgstr "Atualizar bibliotecas"

msgctxt "#30257"
msgid "Catch up with server changes and prune removed items from the libraries you pick. Runs when you confirm the selection."
msgstr "Recupera as alterações do servidor e remove os itens eliminados das bibliotecas que escolher. Executa ao confirmar a seleção."

msgctxt "#30258"
msgid "Repair libraries"
msgstr "Reparar bibliotecas"

msgctxt "#30259"
msgid "Remove and re-sync the libraries you pick from scratch, restoring watched state from the server. Runs when you confirm the selection."
msgstr "Remove e volta a sincronizar de raiz as bibliotecas que escolher, restaurando o estado de visualização a partir do servidor. Executa ao confirmar a seleção."

msgctxt "#30260"
msgid "Refresh boxsets"
msgstr "Atualizar coleções"

msgctxt "#30261"
msgid "Rebuild movie set links from the server's collections. Runs immediately."
msgstr "Reconstrói as ligações das coleções de filmes a partir das coleções do servidor. Executa de imediato."

msgctxt "#30262"
msgid "Sync status"
msgstr "Estado da sincronização"

msgctxt "#30263"
msgid "Companion plugin tier and schema-gate state."
msgstr "Nível do complemento e estado do controlo de esquema."

msgctxt "#30264"
msgid "Remove synced library?"
msgstr "Remover biblioteca sincronizada?"

msgctxt "#30265"
msgid "Remove %s from the Kodi library? The items are deleted from this device only."
msgstr "Remover %s da biblioteca do Kodi? Os itens são eliminados apenas deste dispositivo."

msgctxt "#30266"
msgid "Repair which libraries?"
msgstr "Reparar que bibliotecas?"

msgctxt "#30267"
msgid "All"
msgstr "Todas"

msgctxt "#30268"
msgid "Select libraries"
msgstr "Selecionar bibliotecas"

msgctxt "#30269"
msgid "No libraries available"
msgstr "Não há bibliotecas disponíveis"

msgctxt "#30270"
msgid "Update which libraries?"
msgstr "Atualizar que bibliotecas?"

msgctxt "#30300"
msgid "Sync"
msgstr "Sincronização"

msgctxt "#30301"
msgid "How library changes are downloaded and written."
msgstr "Como as alterações da biblioteca são transferidas e escritas."

msgctxt "#30302"
msgid "Hide update status below (items)"
msgstr "Ocultar o estado de atualização abaixo de (itens)"

msgctxt "#30303"
msgid "Hide Kodi's library-update progress for syncs smaller than this. 0 always shows it."
msgstr "Oculta o progresso de atualização da biblioteca do Kodi em sincronizações menores do que este valor. 0 mostra-o sempre."

msgctxt "#30306"
msgid "Sync during video playback"
msgstr "Sincronizar durante a reprodução de vídeo"

msgctxt "#30307"
msgid "Keep applying library updates while a video is playing."
msgstr "Continua a aplicar as atualizações da biblioteca enquanto um vídeo está a ser reproduzido."

msgctxt "#30310"
msgid "Items per request"
msgstr "Itens por pedido"

msgctxt "#30311"
msgid "Page size for library downloads. Recommended: 50."
msgstr "Tamanho da página nas transferências da biblioteca. Recomendado: 50."

msgctxt "#30312"
msgid "Download threads"
msgstr "Threads de transferência"

msgctxt "#30313"
msgid "Parallel download connections during sync. Recommended: 3; raise only for a fast server."
msgstr "Ligações de transferência em paralelo durante a sincronização. Recomendado: 3; aumente apenas para um servidor rápido."

msgctxt "#30314"
msgid "Artwork"
msgstr "Imagens"

msgctxt "#30318"
msgid "Compress artwork"
msgstr "Comprimir as imagens"

msgctxt "#30319"
msgid "Re-encode capped artwork at JPEG quality 90. No effect without a resolution cap."
msgstr "Recodifica as imagens limitadas com qualidade JPEG 90. Sem efeito se não houver limite de resolução."

msgctxt "#30320"
msgid "Maximum artwork resolution"
msgstr "Resolução máxima das imagens"

msgctxt "#30321"
msgid "Cap the height of synced artwork. Original keeps the server size."
msgstr "Limita a altura das imagens sincronizadas. Original mantém o tamanho do servidor."

msgctxt "#30322"
msgid "Original"
msgstr "Original"

msgctxt "#30323"
msgid "720p"
msgstr "720p"

msgctxt "#30324"
msgid "1080p"
msgstr "1080p"

msgctxt "#30325"
msgid "2160p"
msgstr "2160p"

msgctxt "#30326"
