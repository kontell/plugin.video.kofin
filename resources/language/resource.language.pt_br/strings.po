msgstr "Perguntar"

msgctxt "#30468"
msgid "Play next"
msgstr "Reproduzir a seguir"

msgctxt "#30469"
msgid "Offer Play Next"
msgstr "Oferecer Reproduzir a seguir"

msgctxt "#30470"
msgid "Offer the next episode at the credits, or near the end when no credits segment exists."
msgstr "Oferece o próximo episódio nos créditos, ou perto do fim quando não existe um segmento de créditos."

msgctxt "#30471"
msgid "Play Next lead time"
msgstr "Antecedência de Reproduzir a seguir"

msgctxt "#30472"
msgid "Seconds before the end to show the Play Next prompt for content without a credits segment."
msgstr "Segundos antes do fim para mostrar o aviso de Reproduzir a seguir em conteúdos sem segmento de créditos."

msgctxt "#30473"
msgid "Autoplay next episode"
msgstr "Reproduzir o próximo episódio automaticamente"

msgctxt "#30474"
msgid "Count down on the Play Next prompt and start the next episode automatically."
msgstr "Faz a contagem regressiva no aviso de Reproduzir a seguir e inicia o próximo episódio automaticamente."

msgctxt "#30475"
msgid "Resume offset (seconds)"
msgstr "Recuo ao retomar (segundos)"

msgctxt "#30476"
msgid "Seconds to rewind before the stored resume point, so playback picks up a moment earlier."
msgstr "Segundos para voltar antes do ponto de retomada salvo, para que a reprodução comece um pouco antes."

msgctxt "#30477"
