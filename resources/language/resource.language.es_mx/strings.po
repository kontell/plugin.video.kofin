msgctxt "#30042"
msgid "Add a user"
msgstr "Agregar un usuario"

msgctxt "#30043"
msgid "Remove a user"
msgstr "Quitar un usuario"

msgctxt "#30044"
msgid "Select user"
msgstr "Seleccionar usuario"

msgctxt "#30045"
msgid "No active session on the server yet"
msgstr "Aún no hay ninguna sesión activa en el servidor"

msgctxt "#30046"
msgid "Who's watching? (%s)"
msgstr "¿Quién está viendo? (%s)"

msgctxt "#30047"
msgid "Who's watching with %s?"
msgstr "¿Quién está viendo con %s?"

msgctxt "#30048"
msgid "Who can be added to the session"
msgstr "Quién puede agregarse a la sesión"

msgctxt "#30250"
msgid "Library"
msgstr "Biblioteca"

msgctxt "#30251"
msgid "Select and manage the Jellyfin libraries mirrored into Kodi's own database."
msgstr "Selecciona y administra las bibliotecas de Jellyfin reflejadas en la propia base de datos de Kodi."

msgctxt "#30252"
msgid "Select libraries to sync"
msgstr "Elegir bibliotecas a sincronizar"

msgctxt "#30253"
msgid "Choose which server libraries are mirrored into the Kodi library. Changes apply when you confirm the selection."
msgstr "Elige qué bibliotecas del servidor se reflejan en la biblioteca de Kodi. Los cambios se aplican al confirmar la selección."

msgctxt "#30254"
msgid "Synced libraries"
msgstr "Bibliotecas sincronizadas"

msgctxt "#30255"
msgid "The libraries currently mirrored into the Kodi database."
msgstr "Las bibliotecas reflejadas actualmente en la base de datos de Kodi."

msgctxt "#30256"
msgid "Update libraries"
msgstr "Actualizar bibliotecas"

msgctxt "#30257"
msgid "Catch up with server changes and prune removed items from the libraries you pick. Runs when you confirm the selection."
msgstr "Ponte al día con los cambios del servidor y elimina los elementos borrados de las bibliotecas que elijas. Se ejecuta al confirmar la selección."

msgctxt "#30258"
msgid "Repair libraries"
msgstr "Reparar bibliotecas"

msgctxt "#30259"
msgid "Remove and re-sync the libraries you pick from scratch, restoring watched state from the server. Runs when you confirm the selection."
msgstr "Elimina y vuelve a sincronizar desde cero las bibliotecas que elijas, restaurando el estado de visto desde el servidor. Se ejecuta al confirmar la selección."

msgctxt "#30260"
msgid "Refresh boxsets"
msgstr "Actualizar conjuntos"

msgctxt "#30261"
msgid "Rebuild movie set links from the server's collections. Runs immediately."
msgstr "Reconstruye los enlaces de los conjuntos de películas a partir de las colecciones del servidor. Se ejecuta de inmediato."

msgctxt "#30262"
msgid "Sync status"
msgstr "Estado de la sincronización"

msgctxt "#30263"
msgid "Companion plugin tier and schema-gate state."
msgstr "Nivel del complemento acompañante y estado de la verificación del esquema."

msgctxt "#30264"
msgid "Remove synced library?"
msgstr "¿Quitar la biblioteca sincronizada?"

msgctxt "#30265"
msgid "Remove %s from the Kodi library? The items are deleted from this device only."
msgstr "¿Quitar %s de la biblioteca de Kodi? Los elementos se eliminan solo de este dispositivo."

msgctxt "#30266"
msgid "Repair which libraries?"
msgstr "¿Qué bibliotecas quieres reparar?"

msgctxt "#30267"
msgid "All"
msgstr "Todas"

msgctxt "#30268"
msgid "Select libraries"
msgstr "Seleccionar bibliotecas"

msgctxt "#30269"
msgid "No libraries available"
msgstr "No hay bibliotecas disponibles"

msgctxt "#30270"
msgid "Update which libraries?"
msgstr "¿Qué bibliotecas quieres actualizar?"

msgctxt "#30300"
msgid "Sync"
msgstr "Sincronización"

msgctxt "#30301"
msgid "How library changes are downloaded and written."
msgstr "Cómo se descargan y se escriben los cambios de la biblioteca."

msgctxt "#30302"
msgid "Hide update status below (items)"
msgstr "Ocultar el estado por debajo de (elementos)"

msgctxt "#30303"
msgid "Hide Kodi's library-update progress for syncs smaller than this. 0 always shows it."
msgstr "Oculta el progreso de actualización de la biblioteca de Kodi en sincronizaciones menores que esto. Con 0 se muestra siempre."

msgctxt "#30306"
msgid "Sync during video playback"
msgstr "Sincronizar durante la reproducción de video"

msgctxt "#30307"
msgid "Keep applying library updates while a video is playing."
msgstr "Sigue aplicando las actualizaciones de la biblioteca mientras se reproduce un video."

msgctxt "#30310"
msgid "Items per request"
msgstr "Elementos por solicitud"

msgctxt "#30311"
msgid "Page size for library downloads. Recommended: 50."
msgstr "Tamaño de página para las descargas de la biblioteca. Recomendado: 50."

msgctxt "#30312"
msgid "Download threads"
msgstr "Hilos de descarga"

msgctxt "#30313"
msgid "Parallel download connections during sync. Recommended: 3; raise only for a fast server."
msgstr "Conexiones de descarga en paralelo durante la sincronización. Recomendado: 3; súbelo solo con un servidor rápido."

msgctxt "#30314"
msgid "Artwork"
msgstr "Imágenes"

msgctxt "#30318"
msgid "Compress artwork"
msgstr "Comprimir las imágenes"

msgctxt "#30319"
msgid "Re-encode capped artwork at JPEG quality 90. No effect without a resolution cap."
msgstr "Recodifica con calidad JPEG 90 las imágenes limitadas. No tiene efecto sin un límite de resolución."

msgctxt "#30320"
msgid "Maximum artwork resolution"
msgstr "Resolución máxima de las imágenes"

msgctxt "#30321"
msgid "Cap the height of synced artwork. Original keeps the server size."
msgstr "Limita la altura de las imágenes sincronizadas. Original conserva el tamaño del servidor."

msgctxt "#30322"
msgid "Original"
msgstr "Original"

msgctxt "#30323"
msgid "720p"
msgstr "720p"

msgctxt "#30324"
msgid "1080p"
msgstr "1080p"

