msgctxt "#30470"
msgid "Offer the next episode at the credits, or near the end when no credits segment exists."
msgstr "Ofrece el episodio siguiente en los créditos, o cerca del final cuando no hay segmento de créditos."

msgctxt "#30471"
msgid "Play Next lead time"
msgstr "Anticipación de Reproducir siguiente"

