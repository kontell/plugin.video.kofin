msgctxt "#30041"
msgid "Who's watching?"
msgstr "Kdo se dívá?"

msgctxt "#30042"
msgid "Add a user"
msgstr "Přidat uživatele"

msgctxt "#30043"
msgid "Remove a user"
msgstr "Odebrat uživatele"

msgctxt "#30044"
msgid "Select user"
msgstr "Vyberte uživatele"

msgctxt "#30045"
msgid "No active session on the server yet"
msgstr "Na serveru zatím není žádná aktivní relace"

msgctxt "#30046"
msgid "Who's watching? (%s)"
msgstr "Kdo se dívá? (%s)"

msgctxt "#30047"
msgid "Who's watching with %s?"
msgstr "Kdo se dívá s %s?"

msgctxt "#30048"
msgid "Who can be added to the session"
msgstr "Koho lze přidat do relace"

msgctxt "#30250"
msgid "Library"
msgstr "Knihovna"

msgctxt "#30251"
msgid "Select and manage the Jellyfin libraries mirrored into Kodi's own database."
msgstr "Vyberte a spravujte knihovny Jellyfin zrcadlené do vlastní databáze Kodi."

msgctxt "#30252"
msgid "Select libraries to sync"
msgstr "Vyberte knihovny k synchronizaci"

msgctxt "#30253"
msgid "Choose which server libraries are mirrored into the Kodi library. Changes apply when you confirm the selection."
msgstr "Vyberte, které knihovny serveru se zrcadlí do knihovny Kodi. Změny se projeví po potvrzení výběru."

msgctxt "#30254"
msgid "Synced libraries"
msgstr "Synchronizované knihovny"

msgctxt "#30255"
msgid "The libraries currently mirrored into the Kodi database."
msgstr "Knihovny aktuálně zrcadlené do databáze Kodi."

msgctxt "#30256"
msgid "Update libraries"
msgstr "Aktualizovat knihovny"

msgctxt "#30257"
msgid "Catch up with server changes and prune removed items from the libraries you pick. Runs when you confirm the selection."
msgstr "Dožene změny ze serveru a odstraní smazané položky z knihoven, které vyberete. Spustí se po potvrzení výběru."

msgctxt "#30258"
msgid "Repair libraries"
msgstr "Opravit knihovny"

msgctxt "#30259"
msgid "Remove and re-sync the libraries you pick from scratch, restoring watched state from the server. Runs when you confirm the selection."
msgstr "Odstraní a od začátku znovu synchronizuje knihovny, které vyberete, a obnoví stav zhlédnutí ze serveru. Spustí se po potvrzení výběru."

msgctxt "#30260"
msgid "Refresh boxsets"
msgstr "Obnovit kolekce"

msgctxt "#30261"
msgid "Rebuild movie set links from the server's collections. Runs immediately."
msgstr "Znovu sestaví vazby filmových kolekcí podle kolekcí na serveru. Spustí se ihned."

msgctxt "#30262"
msgid "Sync status"
msgstr "Stav synchronizace"

msgctxt "#30263"
msgid "Companion plugin tier and schema-gate state."
msgstr "Úroveň doprovodného pluginu a stav kontroly schématu databáze."

msgctxt "#30264"
msgid "Remove synced library?"
msgstr "Odebrat synchronizovanou knihovnu?"

msgctxt "#30265"
msgid "Remove %s from the Kodi library? The items are deleted from this device only."
msgstr "Odebrat %s z knihovny Kodi? Položky budou smazány pouze z tohoto zařízení."

msgctxt "#30266"
msgid "Repair which libraries?"
msgstr "Které knihovny opravit?"

msgctxt "#30267"
msgid "All"
msgstr "Všechny"

msgctxt "#30268"
msgid "Select libraries"
msgstr "Vybrat knihovny"

msgctxt "#30269"
msgid "No libraries available"
msgstr "Nejsou dostupné žádné knihovny"

msgctxt "#30270"
msgid "Update which libraries?"
msgstr "Které knihovny aktualizovat?"

msgctxt "#30300"
msgid "Sync"
msgstr "Synchronizace"

msgctxt "#30301"
msgid "How library changes are downloaded and written."
msgstr "Jak se změny v knihovně stahují a zapisují."

msgctxt "#30302"
msgid "Hide update status below (items)"
msgstr "Skrýt stav aktualizace pod (položek)"

msgctxt "#30303"
msgid "Hide Kodi's library-update progress for syncs smaller than this. 0 always shows it."
msgstr "Skryje průběh aktualizace knihovny Kodi u synchronizací menších než tato hodnota. 0 jej zobrazuje vždy."

msgctxt "#30306"
