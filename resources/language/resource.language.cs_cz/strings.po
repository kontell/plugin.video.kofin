msgstr "Synchronizovat hudební seznamy stop"

msgctxt "#30612"
msgid "Download Jellyfin music playlists into Kodi as native playlists under Music → Playlists → Kofin."
msgstr "Stáhne hudební seznamy stop z Jellyfinu do Kodi jako nativní seznamy stop v Hudba → Seznamy stop → Kofin."

msgctxt "#30613"
msgid "Audio and subtitle streams"
msgstr "Zvukové stopy a titulky"

msgctxt "#30614"
msgid "Audio stream"
msgstr "Zvuková stopa"

msgctxt "#30615"
