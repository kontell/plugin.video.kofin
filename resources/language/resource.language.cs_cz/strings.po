msgctxt "Addon Summary"
msgid "Jellyfin client for seamless Kodi integration"
msgstr "Klient Jellyfin pro plynulou integraci s Kodi"

msgctxt "Addon Description"
msgid "Play movies, shows & music from a Jellyfin server."
msgstr "Přehrávejte filmy, seriály a hudbu ze serveru Jellyfin."

msgctxt "#30010"
msgid "Play with transcoding"
msgstr "Přehrát s překódováním"

msgctxt "#30011"
msgid "Quick Connect"
msgstr "Quick Connect"

msgctxt "#30012"
msgid "Username and password"
msgstr "Uživatelské jméno a heslo"

msgctxt "#30013"
msgid "Username"
msgstr "Uživatelské jméno"

msgctxt "#30014"
msgid "Password"
msgstr "Heslo"

msgctxt "#30015"
msgid "Enter code [B]%s[/B] in the Jellyfin app or web interface."
msgstr "Zadejte kód [B]%s[/B] v aplikaci Jellyfin nebo ve webovém rozhraní."

msgctxt "#30016"
msgid "Logged in as %s"
msgstr "Přihlášeno jako %s"

msgctxt "#30017"
msgid "Login failed: wrong username or password"
msgstr "Přihlášení se nezdařilo: chybné jméno nebo heslo"

msgctxt "#30018"
msgid "Server unreachable"
msgstr "Server je nedostupný"

msgctxt "#30019"
msgid "Log out from %s?"
msgstr "Odhlásit se od %s?"

msgctxt "#30020"
msgid "Logged out"
msgstr "Odhlášeno"

msgctxt "#30021"
msgid "Connection OK — %s (%s)"
msgstr "Připojení v pořádku — %s (%s)"

msgctxt "#30022"
msgid "Session rejected — log in again from the Account tab"
msgstr "Relace odmítnuta — přihlaste se znovu na kartě Účet"

msgctxt "#30023"
msgid "Restarting the Kofin service"
msgstr "Restartuje se služba Kofin"

msgctxt "#30024"
msgid "Quick Connect timed out"
msgstr "Vypršel časový limit Quick Connect"

msgctxt "#30025"
msgid "Already logged in"
msgstr "Již přihlášeno"

msgctxt "#30026"
msgid "Not logged in"
msgstr "Nepřihlášeno"

msgctxt "#30027"
msgid "Log in to %s"
msgstr "Přihlásit se k %s"

msgctxt "#30050"
msgid "Account"
msgstr "Účet"

msgctxt "#30051"
msgid "Connect to your Jellyfin server and manage the session."
msgstr "Připojte se k serveru Jellyfin a spravujte relaci."

msgctxt "#30052"
msgid "Server address"
msgstr "Adresa serveru"

msgctxt "#30053"
msgid "Host name, IP address or full URL of the Jellyfin server. A bare host uses http on port 8096."
msgstr "Název hostitele, IP adresa nebo úplná URL serveru Jellyfin. Samotný hostitel použije http na portu 8096."

msgctxt "#30054"
msgid "Log in…"
msgstr "Přihlásit se…"

msgctxt "#30055"
msgid "Connect to the server above using Quick Connect or a username and password."
msgstr "Připojte se k výše uvedenému serveru pomocí Quick Connect nebo uživatelského jména a hesla."

msgctxt "#30056"
msgid "Server"
msgstr "Server"

msgctxt "#30057"
msgid "The connected Jellyfin server."
msgstr "Připojený server Jellyfin."

msgctxt "#30058"
msgid "Logged-in user"
msgstr "Přihlášený uživatel"

msgctxt "#30059"
msgid "The Jellyfin user this device plays and reports as."
msgstr "Uživatel Jellyfin, pod kterým toto zařízení přehrává a hlásí přehrávání."

msgctxt "#30060"
msgid "Test connection"
msgstr "Otestovat připojení"

msgctxt "#30061"
msgid "Check that the server is reachable and the session is still valid."
msgstr "Ověřte, že je server dostupný a že relace je stále platná."

msgctxt "#30062"
msgid "Log out"
msgstr "Odhlásit se"

msgctxt "#30063"
msgid "End the session on the server and forget it on this device. The server address is kept."
msgstr "Ukončí relaci na serveru a zapomene ji na tomto zařízení. Adresa serveru zůstane zachována."

msgctxt "#30064"
msgid "Restart Kofin"
msgstr "Restartovat Kofin"

msgctxt "#30065"
msgid "Restart the background service without restarting Kodi."
msgstr "Restartuje službu na pozadí bez restartu Kodi."

msgctxt "#30066"
msgid "Verify SSL certificate"
msgstr "Ověřovat certifikát SSL"

msgctxt "#30067"
msgid "Disable only for servers with self-signed certificates."
msgstr "Vypněte pouze pro servery s vlastnoručně podepsanými certifikáty."

msgctxt "#30071"
msgid "Advanced"
msgstr "Pokročilé"

msgctxt "#30072"
msgid "SSL verification and other advanced options."
msgstr "Ověřování SSL a další pokročilé volby."

msgctxt "#30073"
msgid "Enable Delete from server"
msgstr "Povolit mazání ze serveru"

msgctxt "#30074"
msgid "Adds a Delete entry to an item's 'Jellyfin actions' context menu. Deletion is permanent: the file itself is removed on the Jellyfin server, for every user."
msgstr "Přidá položku Smazat do kontextové nabídky „Akce Jellyfin“ dané položky. Smazání je trvalé: samotný soubor je odstraněn na serveru Jellyfin, pro všechny uživatele."

msgctxt "#30075"
msgid "Delete without confirmation"
msgstr "Mazat bez potvrzení"

msgctxt "#30076"
msgid "Delete the item as soon as the entry is picked, with no 'are you sure?' prompt. The deletion is still permanent and applies on the server."
msgstr "Smaže položku ihned po zvolení, bez dotazu „opravdu?“. Smazání je stále trvalé a projeví se na serveru."

msgctxt "#30077"
msgid "Offer to delete after watching"
msgstr "Nabídnout smazání po zhlédnutí"

msgctxt "#30078"
msgid "When a movie or episode finishes, ask whether to delete it from the server. Always asks, whatever 'Delete without confirmation' is set to."
msgstr "Po skončení filmu nebo epizody se zeptá, zda ji smazat ze serveru. Ptá se vždy, bez ohledu na nastavení „Mazat bez potvrzení“."

msgctxt "#30079"
msgid "Who's watching shortlist"
msgstr "Užší výběr pro „Kdo se dívá?“"

msgctxt "#30080"
msgid "Choose which server users the addon's Who's watching? entry offers. \"All\" offers everyone. With nothing selected the entry is hidden and anyone already on the session is removed."
msgstr "Vyberte, které uživatele serveru nabízí položka doplňku „Kdo se dívá?“. Volba \"Všichni\" nabídne všechny. Když nevyberete nikoho, položka se skryje a kdokoli už je v relaci, bude odebrán."

msgctxt "#30030"
msgid "All"
msgstr "Vše"

msgctxt "#30031"
msgid "Recently added"
msgstr "Naposledy přidané"

msgctxt "#30032"
msgid "Next up"
msgstr "Další na řadě"

msgctxt "#30033"
msgid "In progress"
msgstr "Rozkoukané"

msgctxt "#30034"
msgid "Unwatched"
msgstr "Nezhlédnuté"

msgctxt "#30035"
msgid "Favourites"
msgstr "Oblíbené"

msgctxt "#30036"
msgid "Genres"
msgstr "Žánry"

msgctxt "#30037"
msgid "Random"
msgstr "Náhodné"

msgctxt "#30038"
msgid "Sets"
msgstr "Kolekce"

msgctxt "#30039"
msgid "Artists"
msgstr "Interpreti"

msgctxt "#30040"
msgid "Albums"
msgstr "Alba"

msgctxt "#30049"
msgid "Continue watching"
msgstr "Pokračovat ve sledování"

msgctxt "#30100"
msgid "Transcoding"
msgstr "Překódování"

msgctxt "#30101"
msgid "When and how the server converts media for this device."
msgstr "Kdy a jak server převádí média pro toto zařízení."

msgctxt "#30102"
msgid "Force direct play"
msgstr "Vynutit přímé přehrávání"

msgctxt "#30103"
msgid "Always play the original video file. Overrides every other video transcoding setting; playback fails if the device cannot handle the media. Music is unaffected — see 'Transcode music'."
msgstr "Vždy přehraje původní videosoubor. Má přednost před všemi ostatními nastaveními překódování videa; přehrávání selže, pokud zařízení dané médium nezvládne. Hudby se to netýká — viz „Překódovat hudbu“."

msgctxt "#30104"
msgid "Force remux"
msgstr "Vynutit remux"

msgctxt "#30105"
msgid "Remux into HLS and copy the source codecs. Does not use Maximum audio channels, Maximum streaming bitrate or Transcode audio bitrate below — those would re-encode a listed codec. Direct play codecs, Allowed HDR types and Maximum resolution still apply."
msgstr "Remuxuje do HLS a zkopíruje zdrojové kodeky. Nepoužívá «Maximální počet zvukových kanálů», «Maximální datový tok streamování» ani «Datový tok zvuku při překódování» níže — ty by znovu zakódovaly uvedený kodek. Kodeky přímého přehrávání, «Povolené typy HDR» a «Maximální rozlišení» platí dál."

msgctxt "#30106"
msgid "Force transcode"
msgstr "Vynutit překódování"

msgctxt "#30107"
msgid "Always re-encode video and audio to the preferred codecs. Honours the bitrate cap, the channel cap, allowed codecs, HDR types and resolution."
msgstr "Vždy znovu zakóduje video i zvuk do preferovaných kodeků. Dodržuje limit datového toku, limit kanálů, povolené kodeky, typy HDR i rozlišení."

msgctxt "#30108"
msgid "Direct play video codecs"
msgstr "Videokodeky pro přímé přehrávání"

msgctxt "#30109"
msgid "Video formats this device can decode. Media using formats not selected here is transcoded."
msgstr "Formáty videa, které toto zařízení umí dekódovat. Média ve formátech, které zde nejsou vybrány, se překódují."

msgctxt "#30110"
msgid "Direct play audio codecs"
msgstr "Zvukové kodeky pro přímé přehrávání"

msgctxt "#30111"
msgid "Audio formats this device can decode or pass through. Others are transcoded."
msgstr "Formáty zvuku, které toto zařízení umí dekódovat nebo předat dál. Ostatní se překódují."

msgctxt "#30112"
msgid "Allowed HDR types"
msgstr "Povolené typy HDR"

msgctxt "#30113"
msgid "HDR formats the display accepts. Media in formats not selected is tone-mapped or transcoded to SDR/HDR10 by the server."
msgstr "Formáty HDR, které displej přijímá. Média ve formátech, které nejsou vybrány, server tónově mapuje nebo překóduje do SDR/HDR10."

msgctxt "#30114"
msgid "Preferred video codec"
msgstr "Preferovaný videokodek"

msgctxt "#30115"
msgid "The codec the client asks for when video must be transcoded."
msgstr "Kodek, o který klient žádá, když se video musí překódovat."

msgctxt "#30116"
msgid "Preferred audio codec"
msgstr "Preferovaný zvukový kodek"

msgctxt "#30117"
msgid "The codec the client asks for when audio must be transcoded."
msgstr "Kodek, o který klient žádá, když se zvuk musí překódovat."

msgctxt "#30118"
msgid "Maximum audio channels"
msgstr "Maximální počet zvukových kanálů"

msgctxt "#30119"
msgid "Maximum number of audio channels allowed when transcoding. Streams with more channels will be downmixed. No effect on direct playback."
msgstr "Maximální počet zvukových kanálů povolený při překódování. Streamy s více kanály budou smíchány dolů. Bez vlivu na přímé přehrávání."

msgctxt "#30120"
msgid "Maximum streaming bitrate"
msgstr "Maximální datový tok streamování"

msgctxt "#30121"
msgid "Media above this bitrate is transcoded down to it."
msgstr "Média nad tímto datovým tokem se na něj překódují."

msgctxt "#30122"
msgid "Maximum resolution"
msgstr "Maximální rozlišení"

msgctxt "#30123"
msgid "Wider media is downscaled by the server."
msgstr "Širší média server zmenší."

msgctxt "#30124"
msgid "Transcode audio bitrate"
msgstr "Datový tok zvuku při překódování"

msgctxt "#30125"
msgid "Bitrate for the audio track when video is transcoded."
msgstr "Datový tok zvukové stopy, když se překódovává video."

msgctxt "#30126"
msgid "Context menu bitrates"
msgstr "Datové toky v kontextové nabídce"

msgctxt "#30127"
msgid "Bitrates offered by 'Play with transcoding'. With one selected the popup is skipped."
msgstr "Datové toky nabízené volbou „Přehrát s překódováním“. Když je vybrán jen jeden, okno se přeskočí."

msgctxt "#30129"
msgid "Maximum music bitrate"
msgstr "Maximální datový tok hudby"

msgctxt "#30130"
msgid "Music above this bitrate is transcoded using the codec and bitrate below. Unlimited never transcodes."
msgstr "Hudba nad tímto datovým tokem se překóduje kodekem a datovým tokem níže. Neomezeno nepřekódovává nikdy."

msgctxt "#30131"
msgid "Music transcode codec"
msgstr "Kodek pro překódování hudby"

msgctxt "#30132"
msgid "Codec for transcoded music streams."
msgstr "Kodek pro překódované hudební streamy."

msgctxt "#30133"
msgid "Music transcode bitrate"
msgstr "Datový tok překódované hudby"

msgctxt "#30134"
msgid "Bitrate for transcoded music streams."
msgstr "Datový tok překódovaných hudebních streamů."

msgctxt "#30135"
msgid "Transcode music"
msgstr "Překódovat hudbu"

