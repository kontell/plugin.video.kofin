msgstr "Αναπαραγωγή επόμενου"

msgctxt "#30487"
msgid "Close"
msgstr "Κλείσιμο"

msgctxt "#30488"
msgid "Skipped %s"
msgstr "Παραλείφθηκε: %s"

msgctxt "#30489"
msgid "Up next: %s"
msgstr "Ακολουθεί: %s"

