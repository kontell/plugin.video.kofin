msgstr "Παράλειψη εισαγωγής"

msgctxt "#30482"
msgid "Skip Outro"
msgstr "Παράλειψη τίτλων"

msgctxt "#30483"
msgid "Skip Recap"
msgstr "Παράλειψη ανακεφαλαίωσης"

msgctxt "#30484"
msgid "Skip Preview"
msgstr "Παράλειψη προεπισκόπησης"

msgctxt "#30485"
