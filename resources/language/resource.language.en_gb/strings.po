# 30550-30599 — SyncPlay (settings group 30550-30558, menu/toasts 30560+;
# fork ids 33262-33302 remapped)

msgctxt "#30550"
msgid "SyncPlay"
msgstr ""

msgctxt "#30551"
msgid "Enable SyncPlay"
msgstr ""

msgctxt "#30552"
msgid "Adds a SyncPlay entry to the addon root for watching in sync with other Jellyfin clients. Off means no group menu and no SyncPlay threads. Leave Kodi's 'Sync playback to display' off: with it on, playback follows the display rate, so unless that rate is a whole multiple of the video frame rate the picture runs fast or slow and the group cannot stay in sync"
msgstr ""

# 30553-30556 — retired with the SyncPlay drift controller (the Player.SetTempo
# ladder and its tolerance slider). Kept, never reused, for the reason given at
# #30744. Why the feature went rather than being retuned: tempo needs Kodi's
# sync-to-display, which slaves the media clock to the panel, so a refresh rate
# that is not a whole multiple of the frame rate imposes a rate error the ladder
# cannot reach — measured at 0.5% to 4.3% on three Piers devices
# (docs/syncplay-drift-shakedown.md §10). #30552 now warns about that instead.
msgctxt "#30553"
msgid "Drift correction"
msgstr ""

msgctxt "#30554"
msgid "Gently adjusts playback speed to hold position with the group (needs Kodi's 'Sync playback to display'). Off: follow scheduled commands only."
msgstr ""

msgctxt "#30555"
msgid "Sync tolerance (ms)"
msgstr ""

msgctxt "#30556"
msgid "Drift below this is left alone; correction engages only past it. Lower is tighter but corrects more often."
msgstr ""

msgctxt "#30557"
msgid "Group notifications"
msgstr ""

msgctxt "#30558"
msgid "Show member join/leave and group-waiting notifications. Errors are always shown."
msgstr ""

msgctxt "#30560"
