msgctxt "Addon Summary"
msgid "Jellyfin client for seamless Kodi integration"
msgstr "Jellyfin-klient for sømløs Kodi-integrasjon"

msgctxt "Addon Description"
msgid "Play movies, shows & music from a Jellyfin server."
msgstr "Spill av filmer, serier og musikk fra en Jellyfin-server."

msgctxt "#30010"
msgid "Play with transcoding"
msgstr "Spill av med transkoding"

msgctxt "#30011"
msgid "Quick Connect"
msgstr "Quick Connect"

msgctxt "#30012"
msgid "Username and password"
msgstr "Brukernavn og passord"

msgctxt "#30013"
msgid "Username"
msgstr "Brukernavn"

msgctxt "#30014"
msgid "Password"
msgstr "Passord"

msgctxt "#30015"
msgid "Enter code [B]%s[/B] in the Jellyfin app or web interface."
msgstr "Skriv inn koden [B]%s[/B] i Jellyfin-appen eller nettgrensesnittet."

msgctxt "#30016"
msgid "Logged in as %s"
msgstr "Logget inn som %s"

msgctxt "#30017"
msgid "Login failed: wrong username or password"
msgstr "Innlogging mislyktes: feil brukernavn eller passord"

msgctxt "#30018"
msgid "Server unreachable"
msgstr "Serveren er ikke tilgjengelig"

msgctxt "#30019"
msgid "Log out from %s?"
msgstr "Logge ut fra %s?"

msgctxt "#30020"
msgid "Logged out"
msgstr "Logget ut"

msgctxt "#30021"
msgid "Connection OK — %s (%s)"
msgstr "Tilkobling OK — %s (%s)"

msgctxt "#30022"
msgid "Session rejected — log in again from the Account tab"
msgstr "Økten ble avvist — logg inn på nytt fra Konto-fanen"

msgctxt "#30023"
msgid "Restarting the Kofin service"
msgstr "Starter Kofin-tjenesten på nytt"

msgctxt "#30024"
msgid "Quick Connect timed out"
msgstr "Tidsavbrudd for Quick Connect"

msgctxt "#30025"
msgid "Already logged in"
msgstr "Allerede logget inn"

msgctxt "#30026"
msgid "Not logged in"
msgstr "Ikke logget inn"

msgctxt "#30027"
msgid "Log in to %s"
msgstr "Logg inn på %s"

msgctxt "#30050"
msgid "Account"
msgstr "Konto"

msgctxt "#30051"
msgid "Connect to your Jellyfin server and manage the session."
msgstr "Koble til Jellyfin-serveren din og administrer økten."

msgctxt "#30052"
msgid "Server address"
msgstr "Serveradresse"

msgctxt "#30053"
msgid "Host name, IP address or full URL of the Jellyfin server. A bare host uses http on port 8096."
msgstr "Vertsnavn, IP-adresse eller full URL til Jellyfin-serveren. Bare et vertsnavn bruker http på port 8096."

msgctxt "#30054"
msgid "Log in…"
msgstr "Logg inn…"

msgctxt "#30055"
msgid "Connect to the server above using Quick Connect or a username and password."
msgstr "Koble til serveren ovenfor med Quick Connect eller med brukernavn og passord."

msgctxt "#30056"
msgid "Server"
msgstr "Server"

msgctxt "#30057"
msgid "The connected Jellyfin server."
msgstr "Jellyfin-serveren som er tilkoblet."

msgctxt "#30058"
msgid "Logged-in user"
msgstr "Innlogget bruker"

msgctxt "#30059"
msgid "The Jellyfin user this device plays and reports as."
msgstr "Jellyfin-brukeren denne enheten spiller av og rapporterer som."

msgctxt "#30060"
msgid "Test connection"
msgstr "Test tilkobling"

msgctxt "#30061"
msgid "Check that the server is reachable and the session is still valid."
msgstr "Kontroller at serveren er tilgjengelig og at økten fortsatt er gyldig."

msgctxt "#30062"
msgid "Log out"
msgstr "Logg ut"

msgctxt "#30063"
msgid "End the session on the server and forget it on this device. The server address is kept."
msgstr "Avslutt økten på serveren og glem den på denne enheten. Serveradressen beholdes."

msgctxt "#30064"
msgid "Restart Kofin"
msgstr "Start Kofin på nytt"

msgctxt "#30065"
msgid "Restart the background service without restarting Kodi."
msgstr "Start bakgrunnstjenesten på nytt uten å starte Kodi på nytt."

msgctxt "#30066"
msgid "Verify SSL certificate"
msgstr "Verifiser SSL-sertifikat"

msgctxt "#30067"
msgid "Disable only for servers with self-signed certificates."
msgstr "Slå av bare for servere med selvsignerte sertifikater."

msgctxt "#30068"
msgid "Device name"
msgstr "Enhetsnavn"

msgctxt "#30069"
msgid "How this device appears in the Jellyfin dashboard and cast menus."
msgstr "Hvordan denne enheten vises i Jellyfin-panelet og i cast-menyer."

msgctxt "#30070"
msgid "Connection"
msgstr "Tilkobling"

msgctxt "#30071"
msgid "Advanced"
msgstr "Avansert"

msgctxt "#30072"
msgid "SSL verification and other advanced options."
msgstr "SSL-verifisering og andre avanserte valg."

msgctxt "#30073"
msgid "Enable Delete from server"
msgstr "Aktiver Slett fra server"

msgctxt "#30074"
msgid "Adds a Delete entry to an item's 'Jellyfin actions' context menu. Deletion is permanent: the file itself is removed on the Jellyfin server, for every user."
msgstr "Legger til en Slett-oppføring i kontekstmenyen «Jellyfin-handlinger» for et element. Sletting er permanent: selve filen fjernes på Jellyfin-serveren, for alle brukere."

msgctxt "#30075"
msgid "Delete without confirmation"
msgstr "Slett uten bekreftelse"

msgctxt "#30076"
msgid "Delete the item as soon as the entry is picked, with no 'are you sure?' prompt. The deletion is still permanent and applies on the server."
msgstr "Slett elementet så snart oppføringen velges, uten et «er du sikker?»-spørsmål. Slettingen er fortsatt permanent og gjelder på serveren."

msgctxt "#30077"
msgid "Offer to delete after watching"
msgstr "Tilby sletting etter visning"

msgctxt "#30078"
msgid "When a movie or episode finishes, ask whether to delete it from the server. Always asks, whatever 'Delete without confirmation' is set to."
msgstr "Når en film eller episode er ferdig, spør om den skal slettes fra serveren. Spør alltid, uansett hva «Slett uten bekreftelse» er satt til."

msgctxt "#30079"
msgid "Who's watching shortlist"
msgstr "Kortliste for «Hvem ser på?»"

msgctxt "#30080"
msgid "Choose which server users the addon's Who's watching? entry offers. \"All\" offers everyone. With nothing selected the entry is hidden and anyone already on the session is removed."
msgstr "Velg hvilke serverbrukere tilleggets «Hvem ser på?»-oppføring tilbyr. \"Alle\" tilbyr alle. Er ingen valgt, skjules oppføringen, og de som allerede er i økten, fjernes."

msgctxt "#30030"
msgid "All"
msgstr "Alle"

msgctxt "#30031"
msgid "Recently added"
msgstr "Nylig lagt til"

msgctxt "#30032"
msgid "Next up"
msgstr "Neste på tur"

msgctxt "#30033"
msgid "In progress"
msgstr "Påbegynt"

msgctxt "#30034"
msgid "Unwatched"
msgstr "Usett"

msgctxt "#30035"
msgid "Favourites"
msgstr "Favoritter"

msgctxt "#30036"
msgid "Genres"
msgstr "Sjangere"

msgctxt "#30037"
msgid "Random"
msgstr "Tilfeldig"

msgctxt "#30038"
msgid "Sets"
msgstr "Filmsamlinger"

msgctxt "#30039"
msgid "Artists"
msgstr "Artister"

msgctxt "#30040"
msgid "Albums"
msgstr "Album"

msgctxt "#30049"
msgid "Continue watching"
msgstr "Fortsett å se"

msgctxt "#30100"
msgid "Transcoding"
msgstr "Transkoding"

msgctxt "#30101"
msgid "When and how the server converts media for this device."
msgstr "Når og hvordan serveren konverterer medier for denne enheten."

msgctxt "#30102"
msgid "Force direct play"
msgstr "Tving direkteavspilling"

msgctxt "#30103"
msgid "Always play the original video file. Overrides every other video transcoding setting; playback fails if the device cannot handle the media. Music is unaffected — see 'Transcode music'."
msgstr "Spill alltid av den originale videofilen. Overstyrer alle andre innstillinger for videotranskoding; avspillingen mislykkes hvis enheten ikke takler mediet. Musikk påvirkes ikke — se «Transkode musikk»."

msgctxt "#30104"
msgid "Force remux"
msgstr "Tving remuksing"

msgctxt "#30105"
msgid "Repackage the stream without re-encoding video. Use when the container causes problems but the codecs are fine."
msgstr "Pakk om strømmen uten å kode om videoen. Bruk dette når beholderen skaper problemer, men kodekene er i orden."

msgctxt "#30106"
msgid "Force transcode"
msgstr "Tving transkoding"

msgctxt "#30107"
msgid "Always re-encode on the server. Highest server load; use for troubleshooting or very constrained clients."
msgstr "Kod alltid om på serveren. Høyest serverbelastning; bruk det til feilsøking eller svært begrensede klienter."

msgctxt "#30108"
msgid "Direct play video codecs"
msgstr "Videokodeker for direkteavspilling"

msgctxt "#30109"
msgid "Video formats this device can decode. Media using formats not selected here is transcoded."
msgstr "Videoformater denne enheten kan dekode. Medier i formater som ikke er valgt her, transkodes."

msgctxt "#30110"
msgid "Direct play audio codecs"
msgstr "Lydkodeker for direkteavspilling"

msgctxt "#30111"
msgid "Audio formats this device can decode or pass through. Others are transcoded."
msgstr "Lydformater denne enheten kan dekode eller sende videre uendret. Andre transkodes."

msgctxt "#30112"
msgid "Allowed HDR types"
msgstr "Tillatte HDR-typer"

msgctxt "#30113"
msgid "HDR formats the display accepts. Media in formats not selected is tone-mapped or transcoded to SDR/HDR10 by the server."
msgstr "HDR-formater skjermen godtar. Medier i formater som ikke er valgt, tonemappes eller transkodes til SDR/HDR10 av serveren."

msgctxt "#30114"
msgid "Preferred video codec"
msgstr "Foretrukket videokodek"

msgctxt "#30115"
msgid "The codec the server targets when it must transcode video."
msgstr "Kodeken serveren sikter mot når den må transkode video."

msgctxt "#30116"
msgid "Preferred audio codec"
msgstr "Foretrukket lydkodek"

msgctxt "#30117"
msgid "The codec the server targets when it must transcode audio."
msgstr "Kodeken serveren sikter mot når den må transkode lyd."

msgctxt "#30118"
msgid "Maximum audio channels"
msgstr "Maksimalt antall lydkanaler"

msgctxt "#30119"
msgid "Maximum number of audio channels allowed when transcoding. Streams with more channels will be downmixed. No effect on direct playback."
msgstr "Maksimalt antall lydkanaler som tillates ved transkoding. Strømmer med flere kanaler nedmikses. Ingen effekt på direkteavspilling."

msgctxt "#30120"
msgid "Maximum streaming bitrate"
msgstr "Maksimal strømmebitrate"

msgctxt "#30121"
msgid "Media above this bitrate is transcoded down to it. Unlimited suits LAN playback."
msgstr "Medier over denne bitraten transkodes ned til den. Ubegrenset passer for avspilling i lokalnettet."

msgctxt "#30122"
msgid "Maximum resolution"
msgstr "Maksimal oppløsning"

msgctxt "#30123"
msgid "Wider media is downscaled by the server."
msgstr "Bredere medier nedskaleres av serveren."

msgctxt "#30124"
msgid "Transcode audio bitrate"
msgstr "Bitrate for transkodet lyd"

msgctxt "#30125"
msgid "Bitrate for the audio track when video is transcoded."
msgstr "Bitrate for lydsporet når videoen transkodes."

msgctxt "#30126"
msgid "Context menu bitrates"
msgstr "Bitrater i kontekstmenyen"

msgctxt "#30127"
msgid "Bitrates offered by 'Play with transcoding'. With exactly one selected the popup is skipped."
msgstr "Bitrater som tilbys av «Spill av med transkoding». Med nøyaktig én valgt hoppes dialogen over."

msgctxt "#30128"
msgid "Music"
msgstr "Musikk"

msgctxt "#30129"
msgid "Maximum music bitrate"
msgstr "Maksimal musikkbitrate"

msgctxt "#30130"
msgid "Music above this bitrate is transcoded using the codec and bitrate below. Unlimited never transcodes."
msgstr "Musikk over denne bitraten transkodes med kodeken og bitraten nedenfor. Ubegrenset transkoder aldri."

msgctxt "#30131"
msgid "Music transcode codec"
msgstr "Kodek for musikktranskoding"

msgctxt "#30132"
msgid "Codec for transcoded music streams."
msgstr "Kodek for transkodede musikkstrømmer."

msgctxt "#30133"
msgid "Music transcode bitrate"
msgstr "Bitrate for musikktranskoding"

msgctxt "#30134"
msgid "Bitrate for transcoded music streams."
msgstr "Bitrate for transkodede musikkstrømmer."

msgctxt "#30135"
msgid "Transcode music"
msgstr "Transkode musikk"

msgctxt "#30136"
msgid "Route music playback through the add-on so the settings below apply. Off, songs stream straight from the server untouched. Changing this needs a library repair of your music libraries to rewrite their paths."
msgstr "Send musikkavspillingen gjennom tillegget, slik at innstillingene nedenfor gjelder. Av strømmes sangene rett fra serveren, uendret. Å endre dette krever en bibliotekreparasjon av musikkbibliotekene dine for å skrive om banene deres."

