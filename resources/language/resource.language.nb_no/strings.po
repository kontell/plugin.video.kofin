msgstr "Legg til en bruker"

msgctxt "#30043"
msgid "Remove a user"
msgstr "Fjern en bruker"

msgctxt "#30044"
msgid "Select user"
msgstr "Velg bruker"

msgctxt "#30045"
msgid "No active session on the server yet"
msgstr "Ingen aktiv økt på serveren ennå"

msgctxt "#30046"
msgid "Who's watching? (%s)"
msgstr "Hvem ser på? (%s)"

msgctxt "#30047"
