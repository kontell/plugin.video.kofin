msgstr "Hvem ser på sammen med %s?"

msgctxt "#30048"
msgid "Who can be added to the session"
msgstr "Hvem som kan legges til i økten"

msgctxt "#30250"
msgid "Library"
msgstr "Bibliotek"

msgctxt "#30251"
msgid "Select and manage the Jellyfin libraries mirrored into Kodi's own database."
msgstr "Velg og administrer Jellyfin-bibliotekene som speiles inn i Kodis egen database."

msgctxt "#30252"
msgid "Select libraries to sync"
msgstr "Velg bibliotek som skal synkroniseres"

msgctxt "#30253"
msgid "Choose which server libraries are mirrored into the Kodi library. Changes apply when you confirm the selection."
msgstr "Velg hvilke serverbibliotek som speiles inn i Kodi-biblioteket. Endringene trer i kraft når du bekrefter valget."

msgctxt "#30254"
msgid "Synced libraries"
msgstr "Synkroniserte bibliotek"

msgctxt "#30255"
msgid "The libraries currently mirrored into the Kodi database."
msgstr "Bibliotekene som nå speiles inn i Kodi-databasen."

msgctxt "#30256"
msgid "Update libraries"
msgstr "Oppdater bibliotek"

msgctxt "#30257"
msgid "Catch up with server changes and prune removed items from the libraries you pick. Runs when you confirm the selection."
msgstr "Hent inn endringer fra serveren og fjern slettede elementer fra bibliotekene du velger. Kjøres når du bekrefter valget."

msgctxt "#30258"
msgid "Repair libraries"
msgstr "Reparer bibliotek"

msgctxt "#30259"
msgid "Remove and re-sync the libraries you pick from scratch, restoring watched state from the server. Runs when you confirm the selection."
msgstr "Fjern bibliotekene du velger og synkroniser dem på nytt fra bunnen av, med sett-status hentet tilbake fra serveren. Kjøres når du bekrefter valget."

msgctxt "#30260"
msgid "Refresh boxsets"
msgstr "Oppdater filmsamlinger"

msgctxt "#30261"
msgid "Rebuild movie set links from the server's collections. Runs immediately."
msgstr "Bygg opp igjen koblingene til filmsamlinger fra serverens samlinger. Kjøres umiddelbart."

msgctxt "#30262"
msgid "Sync status"
msgstr "Synkroniseringsstatus"

msgctxt "#30263"
msgid "Companion plugin tier and schema-gate state."
msgstr "Nivå på følgetillegget og status for skjemasperren."

msgctxt "#30264"
msgid "Remove synced library?"
msgstr "Fjerne synkronisert bibliotek?"

msgctxt "#30265"
msgid "Remove %s from the Kodi library? The items are deleted from this device only."
msgstr "Fjerne %s fra Kodi-biblioteket? Elementene slettes bare fra denne enheten."

msgctxt "#30266"
msgid "Repair which libraries?"
msgstr "Hvilke bibliotek skal repareres?"

msgctxt "#30267"
msgid "All"
msgstr "Alle"

msgctxt "#30268"
msgid "Select libraries"
msgstr "Velg bibliotek"

msgctxt "#30269"
msgid "No libraries available"
msgstr "Ingen bibliotek tilgjengelig"

msgctxt "#30270"
msgid "Update which libraries?"
msgstr "Hvilke bibliotek skal oppdateres?"

msgctxt "#30300"
msgid "Sync"
msgstr "Synkronisering"

msgctxt "#30301"
msgid "How library changes are downloaded and written."
msgstr "Hvordan bibliotekendringer lastes ned og skrives."

msgctxt "#30302"
msgid "Hide update status below (items)"
msgstr "Skjul oppdateringsstatus under (elementer)"

msgctxt "#30303"
msgid "Hide Kodi's library-update progress for syncs smaller than this. 0 always shows it."
msgstr "Skjul Kodis fremdriftsvisning for bibliotekoppdateringer ved synkroniseringer mindre enn dette. 0 viser den alltid."

msgctxt "#30306"
msgid "Sync during video playback"
msgstr "Synkroniser under videoavspilling"

msgctxt "#30307"
msgid "Keep applying library updates while a video is playing."
msgstr "Fortsett å ta i bruk bibliotekoppdateringer mens en video spilles av."

msgctxt "#30310"
msgid "Items per request"
msgstr "Elementer per forespørsel"

msgctxt "#30311"
msgid "Page size for library downloads. Recommended: 50."
msgstr "Sidestørrelse for bibliotek-nedlastinger. Anbefalt: 50."

msgctxt "#30312"
msgid "Download threads"
msgstr "Nedlastingstråder"

msgctxt "#30313"
msgid "Parallel download connections during sync. Recommended: 3; raise only for a fast server."
msgstr "Parallelle nedlastingstilkoblinger under synkronisering. Anbefalt: 3; øk bare for en rask server."

msgctxt "#30314"
msgid "Artwork"
msgstr "Bildemateriale"

msgctxt "#30318"
msgid "Compress artwork"
msgstr "Komprimer bildemateriale"

msgctxt "#30319"
msgid "Re-encode capped artwork at JPEG quality 90. No effect without a resolution cap."
msgstr "Kod om begrenset bildemateriale med JPEG-kvalitet 90. Ingen effekt uten en oppløsningsgrense."

msgctxt "#30320"
msgid "Maximum artwork resolution"
msgstr "Maksimal bildeoppløsning"

msgctxt "#30321"
msgid "Cap the height of synced artwork. Original keeps the server size."
msgstr "Begrens høyden på synkronisert bildemateriale. Original beholder serverens størrelse."

msgctxt "#30322"
msgid "Original"
msgstr "Original"

msgctxt "#30323"
msgid "720p"
msgstr "720p"

msgctxt "#30324"
msgid "1080p"
msgstr "1080p"

msgctxt "#30325"
msgid "2160p"
msgstr "2160p"

msgctxt "#30326"
msgid "Notify on server connection changes"
msgstr "Varsle ved endringer i servertilkoblingen"

msgctxt "#30327"
msgid "Show a notification when the server connects, disconnects or restarts."
msgstr "Vis et varsel når serveren kobler til, kobler fra eller starter på nytt."

msgctxt "#30350"
msgid "Recently added"
msgstr "Nylig lagt til"

msgctxt "#30351"
