msgstr "Reprodueix l'episodi següent automàticament"

msgctxt "#30474"
msgid "Count down on the Play Next prompt and start the next episode automatically."
msgstr "Fa un compte enrere a l'avís de Reprodueix el següent i inicia l'episodi següent automàticament."

msgctxt "#30475"
msgid "Resume offset (seconds)"
msgstr "Desplaçament de la represa (segons)"

