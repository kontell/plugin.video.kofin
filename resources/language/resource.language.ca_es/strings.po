msgctxt "#30041"
msgid "Who's watching?"
msgstr "Qui està mirant?"

msgctxt "#30042"
msgid "Add a user"
msgstr "Afegeix un usuari"

msgctxt "#30043"
msgid "Remove a user"
msgstr "Elimina un usuari"

msgctxt "#30044"
msgid "Select user"
msgstr "Seleccioneu un usuari"

msgctxt "#30045"
msgid "No active session on the server yet"
msgstr "Encara no hi ha cap sessió activa al servidor"

msgctxt "#30046"
msgid "Who's watching? (%s)"
msgstr "Qui està mirant? (%s)"

msgctxt "#30047"
msgid "Who's watching with %s?"
msgstr "Qui està mirant amb %s?"

msgctxt "#30048"
msgid "Who can be added to the session"
msgstr "Qui es pot afegir a la sessió"

msgctxt "#30250"
msgid "Library"
msgstr "Biblioteca"

msgctxt "#30251"
msgid "Select and manage the Jellyfin libraries mirrored into Kodi's own database."
msgstr "Seleccioneu i gestioneu les biblioteques del Jellyfin reflectides a la base de dades del Kodi."

msgctxt "#30252"
msgid "Select libraries to sync"
msgstr "Selecciona les biblioteques per sincronitzar"

msgctxt "#30253"
msgid "Choose which server libraries are mirrored into the Kodi library. Changes apply when you confirm the selection."
msgstr "Trieu quines biblioteques del servidor es reflecteixen a la biblioteca del Kodi. Els canvis s'apliquen quan confirmeu la selecció."

msgctxt "#30254"
msgid "Synced libraries"
msgstr "Biblioteques sincronitzades"

msgctxt "#30255"
msgid "The libraries currently mirrored into the Kodi database."
msgstr "Les biblioteques reflectides actualment a la base de dades del Kodi."

msgctxt "#30256"
msgid "Update libraries"
msgstr "Actualitza les biblioteques"

msgctxt "#30257"
msgid "Catch up with server changes and prune removed items from the libraries you pick. Runs when you confirm the selection."
msgstr "Recupera els canvis del servidor i elimina els elements suprimits de les biblioteques que trieu. S'executa quan confirmeu la selecció."

msgctxt "#30258"
msgid "Repair libraries"
msgstr "Repara les biblioteques"

msgctxt "#30259"
msgid "Remove and re-sync the libraries you pick from scratch, restoring watched state from the server. Runs when you confirm the selection."
msgstr "Elimina i torna a sincronitzar des de zero les biblioteques que trieu, restaurant l'estat de visualització des del servidor. S'executa quan confirmeu la selecció."

msgctxt "#30260"
msgid "Refresh boxsets"
msgstr "Actualitza les col·leccions"

msgctxt "#30261"
msgid "Rebuild movie set links from the server's collections. Runs immediately."
msgstr "Reconstrueix els enllaços de les col·leccions de pel·lícules a partir de les col·leccions del servidor. S'executa immediatament."

msgctxt "#30262"
msgid "Sync status"
msgstr "Estat de la sincronització"

msgctxt "#30263"
msgid "Companion plugin tier and schema-gate state."
msgstr "Nivell del connector complementari i estat del control d'esquema."

msgctxt "#30264"
msgid "Remove synced library?"
msgstr "Voleu eliminar la biblioteca sincronitzada?"

msgctxt "#30265"
msgid "Remove %s from the Kodi library? The items are deleted from this device only."
msgstr "Voleu eliminar %s de la biblioteca del Kodi? Els elements només se suprimeixen d'aquest dispositiu."

msgctxt "#30266"
msgid "Repair which libraries?"
msgstr "Quines biblioteques voleu reparar?"

msgctxt "#30267"
msgid "All"
msgstr "Totes"

msgctxt "#30268"
msgid "Select libraries"
msgstr "Seleccioneu les biblioteques"

msgctxt "#30269"
msgid "No libraries available"
msgstr "No hi ha cap biblioteca disponible"

msgctxt "#30270"
msgid "Update which libraries?"
msgstr "Quines biblioteques voleu actualitzar?"

msgctxt "#30300"
msgid "Sync"
msgstr "Sincronització"

msgctxt "#30301"
msgid "How library changes are downloaded and written."
msgstr "Com es baixen i s'escriuen els canvis de la biblioteca."

msgctxt "#30302"
msgid "Hide update status below (items)"
msgstr "Amaga l'estat d'actualització per sota de (elements)"

msgctxt "#30303"
msgid "Hide Kodi's library-update progress for syncs smaller than this. 0 always shows it."
msgstr "Amaga el progrés d'actualització de la biblioteca del Kodi per a sincronitzacions més petites que aquest valor. Amb 0 es mostra sempre."

msgctxt "#30306"
msgid "Sync during video playback"
msgstr "Sincronitza durant la reproducció de vídeo"

msgctxt "#30307"
msgid "Keep applying library updates while a video is playing."
msgstr "Continua aplicant les actualitzacions de la biblioteca mentre es reprodueix un vídeo."

msgctxt "#30310"
msgid "Items per request"
msgstr "Elements per petició"

msgctxt "#30311"
msgid "Page size for library downloads. Recommended: 50."
msgstr "Mida de pàgina per a les baixades de la biblioteca. Recomanat: 50."

msgctxt "#30312"
msgid "Download threads"
msgstr "Fils de baixada"

msgctxt "#30313"
msgid "Parallel download connections during sync. Recommended: 3; raise only for a fast server."
