msgstr "Passa a un complement de lletres"

msgctxt "#30611"
msgid "Sync music playlists"
msgstr "Sincronitza les llistes de reproducció de música"

msgctxt "#30612"
msgid "Download Jellyfin music playlists into Kodi as native playlists under Music → Playlists → Kofin."
msgstr "Baixa les llistes de reproducció de música del Jellyfin al Kodi com a llistes natives dins de Música → Llistes de reproducció → Kofin."

msgctxt "#30613"
msgid "Audio and subtitle streams"
msgstr "Fluxos d'àudio i de subtítols"

msgctxt "#30614"
msgid "Audio stream"
msgstr "Flux d'àudio"

msgctxt "#30615"
msgid "Subtitles"
msgstr "Subtítols"

msgctxt "#30616"
