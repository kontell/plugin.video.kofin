# 30250-30299 — Library tab

msgctxt "#30250"
msgid "Library"
msgstr "Bibliotek"

msgctxt "#30251"
msgid "Select and manage the Jellyfin libraries mirrored into Kodi's own database."
msgstr "Vælg og administrer de Jellyfin-biblioteker, der spejles ind i Kodis egen database."

msgctxt "#30252"
msgid "Select libraries to sync"
msgstr "Vælg biblioteker, der skal synkroniseres"

msgctxt "#30253"
msgid "Choose which server libraries are mirrored into the Kodi library. Changes apply when you confirm the selection."
msgstr "Vælg, hvilke serverbiblioteker der spejles ind i Kodi-biblioteket. Ændringerne træder i kraft, når du bekræfter valget."

msgctxt "#30254"
msgid "Synced libraries"
msgstr "Synkroniserede biblioteker"

msgctxt "#30255"
msgid "The libraries currently mirrored into the Kodi database."
msgstr "De biblioteker, der lige nu spejles ind i Kodi-databasen."

msgctxt "#30256"
msgid "Update libraries"
msgstr "Opdater biblioteker"

msgctxt "#30257"
msgid "Catch up with server changes and prune removed items from the libraries you pick. Runs when you confirm the selection."
msgstr "Hent ændringer fra serveren, og fjern slettede elementer fra de biblioteker, du vælger. Kører, når du bekræfter valget."

msgctxt "#30258"
msgid "Repair libraries"
msgstr "Reparer biblioteker"

msgctxt "#30259"
msgid "Remove and re-sync the libraries you pick from scratch, restoring watched state from the server. Runs when you confirm the selection."
msgstr "Fjern de biblioteker, du vælger, og synkroniser dem forfra, med set-status hentet tilbage fra serveren. Kører, når du bekræfter valget."

msgctxt "#30260"
msgid "Refresh boxsets"
msgstr "Opdater filmsamlinger"

msgctxt "#30261"
msgid "Rebuild movie set links from the server's collections. Runs immediately."
msgstr "Genopbyg links til filmsamlinger ud fra serverens samlinger. Kører med det samme."

msgctxt "#30262"
msgid "Sync status"
msgstr "Synkroniseringsstatus"

msgctxt "#30263"
msgid "Companion plugin tier and schema-gate state."
msgstr "Niveau for følgetilføjelsen og status for skemaspærren."

msgctxt "#30264"
msgid "Remove synced library?"
msgstr "Fjern synkroniseret bibliotek?"

msgctxt "#30265"
msgid "Remove %s from the Kodi library? The items are deleted from this device only."
msgstr "Fjern %s fra Kodi-biblioteket? Elementerne slettes kun fra denne enhed."

msgctxt "#30266"
msgid "Repair which libraries?"
msgstr "Hvilke biblioteker skal repareres?"

msgctxt "#30267"
msgid "All"
msgstr "Alle"

msgctxt "#30268"
msgid "Select libraries"
msgstr "Vælg biblioteker"

msgctxt "#30269"
msgid "No libraries available"
msgstr "Ingen biblioteker tilgængelige"

msgctxt "#30270"
msgid "Update which libraries?"
msgstr "Hvilke biblioteker skal opdateres?"

# 30300-30349 — Sync tab

msgctxt "#30300"
msgid "Sync"
msgstr "Synkronisering"

msgctxt "#30301"
msgid "How library changes are downloaded and written."
msgstr "Hvordan biblioteksændringer hentes og skrives."

msgctxt "#30302"
msgid "Hide update status below (items)"
msgstr "Skjul opdateringsstatus under (elementer)"

msgctxt "#30303"
msgid "Hide Kodi's library-update progress for syncs smaller than this. 0 always shows it."
msgstr "Skjul Kodis statusvisning for biblioteksopdateringer ved synkroniseringer, der er mindre end dette. 0 viser den altid."

msgctxt "#30306"
msgid "Sync during video playback"
msgstr "Synkroniser under videoafspilning"

msgctxt "#30307"
msgid "Keep applying library updates while a video is playing."
msgstr "Bliv ved med at anvende biblioteksopdateringer, mens en video afspilles."

msgctxt "#30310"
msgid "Items per request"
msgstr "Elementer pr. forespørgsel"

msgctxt "#30311"
msgid "Page size for library downloads. Recommended: 50."
msgstr "Sidestørrelse for bibliotekshentninger. Anbefalet: 50."

msgctxt "#30312"
msgid "Download threads"
msgstr "Downloadtråde"

msgctxt "#30313"
msgid "Parallel download connections during sync. Recommended: 3; raise only for a fast server."
msgstr "Parallelle downloadforbindelser under synkronisering. Anbefalet: 3; hæv kun for en hurtig server."

msgctxt "#30314"
msgid "Artwork"
msgstr "Billedmateriale"



msgctxt "#30318"
msgid "Compress artwork"
msgstr "Komprimer billedmateriale"

msgctxt "#30319"
msgid "Re-encode capped artwork at JPEG quality 90. No effect without a resolution cap."
msgstr "Genkod begrænset billedmateriale med JPEG-kvalitet 90. Ingen effekt uden en opløsningsgrænse."

msgctxt "#30320"
msgid "Maximum artwork resolution"
msgstr "Maksimal billedopløsning"

msgctxt "#30321"
msgid "Cap the height of synced artwork. Original keeps the server size."
msgstr "Begræns højden på synkroniseret billedmateriale. Original beholder serverens størrelse."

msgctxt "#30322"
msgid "Original"
msgstr "Original"

msgctxt "#30323"
