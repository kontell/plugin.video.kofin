# Add-on browser metadata. These must stay in step with the en_GB <summary> and
# <description> in addon.xml, which remain the fallback for untranslated locales.

msgctxt "Addon Summary"
msgid "Jellyfin client for seamless Kodi integration"
msgstr "Jellyfin-klient til problemfri Kodi-integration"

msgctxt "Addon Description"
msgid "Play movies, shows & music from a Jellyfin server."
msgstr "Afspil film, serier og musik fra en Jellyfin-server."

# 30000-30049 — general / dialogs

msgctxt "#30010"
msgid "Play with transcoding"
msgstr "Afspil med transkodning"

msgctxt "#30011"
msgid "Quick Connect"
msgstr "Quick Connect"

msgctxt "#30012"
msgid "Username and password"
msgstr "Brugernavn og adgangskode"

msgctxt "#30013"
msgid "Username"
msgstr "Brugernavn"

msgctxt "#30014"
msgid "Password"
msgstr "Adgangskode"

msgctxt "#30015"
msgid "Enter code [B]%s[/B] in the Jellyfin app or web interface."
msgstr "Indtast koden [B]%s[/B] i Jellyfin-appen eller webgrænsefladen."

msgctxt "#30016"
msgid "Logged in as %s"
msgstr "Logget ind som %s"

msgctxt "#30017"
msgid "Login failed: wrong username or password"
msgstr "Login mislykkedes: forkert brugernavn eller adgangskode"

msgctxt "#30018"
msgid "Server unreachable"
msgstr "Serveren kan ikke nås"

msgctxt "#30019"
msgid "Log out from %s?"
msgstr "Log ud fra %s?"

msgctxt "#30020"
msgid "Logged out"
msgstr "Logget ud"

msgctxt "#30021"
msgid "Connection OK — %s (%s)"
msgstr "Forbindelse OK — %s (%s)"

msgctxt "#30022"
msgid "Session rejected — log in again from the Account tab"
msgstr "Sessionen blev afvist — log ind igen på fanen Konto"

msgctxt "#30023"
msgid "Restarting the Kofin service"
msgstr "Genstarter Kofin-tjenesten"

msgctxt "#30024"
msgid "Quick Connect timed out"
msgstr "Quick Connect fik timeout"

msgctxt "#30025"
msgid "Already logged in"
msgstr "Allerede logget ind"

msgctxt "#30026"
msgid "Not logged in"
msgstr "Ikke logget ind"

msgctxt "#30027"
msgid "Log in to %s"
msgstr "Log ind på %s"

# 30050-30099 — Account tab (30066-30067 and 30071-30080: Advanced tab)

msgctxt "#30050"
msgid "Account"
msgstr "Konto"

msgctxt "#30051"
msgid "Connect to your Jellyfin server and manage the session."
msgstr "Opret forbindelse til din Jellyfin-server, og administrer sessionen."

msgctxt "#30052"
msgid "Server address"
msgstr "Serveradresse"

msgctxt "#30053"
msgid "Host name, IP address or full URL of the Jellyfin server. A bare host uses http on port 8096."
msgstr "Værtsnavn, IP-adresse eller fuld URL på Jellyfin-serveren. Kun et værtsnavn bruger http på port 8096."

msgctxt "#30054"
msgid "Log in…"
msgstr "Log ind…"

msgctxt "#30055"
msgid "Connect to the server above using Quick Connect or a username and password."
msgstr "Opret forbindelse til serveren ovenfor med Quick Connect eller med brugernavn og adgangskode."

msgctxt "#30056"
msgid "Server"
msgstr "Server"

msgctxt "#30057"
msgid "The connected Jellyfin server."
msgstr "Den tilsluttede Jellyfin-server."

msgctxt "#30058"
msgid "Logged-in user"
msgstr "Indlogget bruger"

msgctxt "#30059"
msgid "The Jellyfin user this device plays and reports as."
msgstr "Den Jellyfin-bruger, denne enhed afspiller og rapporterer som."

msgctxt "#30060"
msgid "Test connection"
msgstr "Test forbindelse"

msgctxt "#30061"
msgid "Check that the server is reachable and the session is still valid."
msgstr "Kontrollér, at serveren kan nås, og at sessionen stadig er gyldig."

msgctxt "#30062"
msgid "Log out"
msgstr "Log ud"

msgctxt "#30063"
msgid "End the session on the server and forget it on this device. The server address is kept."
msgstr "Afslut sessionen på serveren, og glem den på denne enhed. Serveradressen beholdes."

msgctxt "#30064"
msgid "Restart Kofin"
msgstr "Genstart Kofin"

msgctxt "#30065"
msgid "Restart the background service without restarting Kodi."
msgstr "Genstart baggrundstjenesten uden at genstarte Kodi."

msgctxt "#30066"
msgid "Verify SSL certificate"
msgstr "Verificér SSL-certifikat"

msgctxt "#30067"
msgid "Disable only for servers with self-signed certificates."
msgstr "Slå kun fra for servere med selvsignerede certifikater."

msgctxt "#30068"
msgid "Device name"
msgstr "Enhedsnavn"

msgctxt "#30069"
msgid "How this device appears in the Jellyfin dashboard and cast menus."
msgstr "Sådan vises denne enhed i Jellyfins kontrolpanel og i cast-menuer."

msgctxt "#30070"
msgid "Connection"
msgstr "Forbindelse"

msgctxt "#30071"
msgid "Advanced"
msgstr "Avanceret"

msgctxt "#30072"
msgid "SSL verification and other advanced options."
msgstr "SSL-verifikation og andre avancerede indstillinger."

msgctxt "#30073"
msgid "Enable Delete from server"
msgstr "Aktivér Slet fra server"

msgctxt "#30074"
msgid "Adds a Delete entry to an item's 'Jellyfin actions' context menu. Deletion is permanent: the file itself is removed on the Jellyfin server, for every user."
msgstr "Tilføjer en Slet-post i elementets kontekstmenu »Jellyfin-handlinger«. Sletning er permanent: selve filen fjernes på Jellyfin-serveren, for alle brugere."

msgctxt "#30075"
msgid "Delete without confirmation"
msgstr "Slet uden bekræftelse"

msgctxt "#30076"
msgid "Delete the item as soon as the entry is picked, with no 'are you sure?' prompt. The deletion is still permanent and applies on the server."
msgstr "Slet elementet, så snart posten vælges, uden et »er du sikker?«-spørgsmål. Sletningen er stadig permanent og gælder på serveren."

msgctxt "#30077"
msgid "Offer to delete after watching"
msgstr "Tilbyd sletning efter visning"

msgctxt "#30078"
msgid "When a movie or episode finishes, ask whether to delete it from the server. Always asks, whatever 'Delete without confirmation' is set to."
msgstr "Når en film eller episode er slut, så spørg, om den skal slettes fra serveren. Spørger altid, uanset hvad »Slet uden bekræftelse« er indstillet til."

msgctxt "#30079"
msgid "Who's watching shortlist"
msgstr "Kortliste til »Hvem ser med?«"

msgctxt "#30080"
msgid "Choose which server users the addon's Who's watching? entry offers. \"All\" offers everyone. With nothing selected the entry is hidden and anyone already on the session is removed."
msgstr "Vælg, hvilke serverbrugere tilføjelsens »Hvem ser med?«-post tilbyder. \"Alle\" tilbyder alle. Er intet valgt, skjules posten, og enhver der allerede er på sessionen, fjernes."

# 30030-30049 — browse nodes

msgctxt "#30030"
msgid "All"
msgstr "Alle"

msgctxt "#30031"
msgid "Recently added"
msgstr "Sidst tilføjet"

msgctxt "#30032"
msgid "Next up"
msgstr "Næste"

msgctxt "#30033"
msgid "In progress"
msgstr "Påbegyndt"

msgctxt "#30034"
msgid "Unwatched"
msgstr "Usete"

msgctxt "#30035"
msgid "Favourites"
msgstr "Favoritter"

msgctxt "#30036"
msgid "Genres"
msgstr "Genrer"

msgctxt "#30037"
msgid "Random"
msgstr "Tilfældig"

msgctxt "#30038"
msgid "Sets"
msgstr "Filmsamlinger"

msgctxt "#30039"
msgid "Artists"
msgstr "Kunstnere"

msgctxt "#30040"
msgid "Albums"
msgstr "Album"

msgctxt "#30049"
msgid "Continue watching"
msgstr "Fortsæt med at se"

# 30100-30203 — Transcoding tab (30150+ are option labels)

msgctxt "#30100"
msgid "Transcoding"
msgstr "Transkodning"

msgctxt "#30101"
msgid "When and how the server converts media for this device."
msgstr "Hvornår og hvordan serveren konverterer medier til denne enhed."

msgctxt "#30102"
msgid "Force direct play"
msgstr "Tving direkte afspilning"

msgctxt "#30103"
msgid "Always play the original video file. Overrides every other video transcoding setting; playback fails if the device cannot handle the media. Music is unaffected — see 'Transcode music'."
msgstr "Afspil altid den originale videofil. Tilsidesætter alle andre indstillinger for videotranskodning; afspilningen mislykkes, hvis enheden ikke kan håndtere mediet. Musik påvirkes ikke — se »Transkod musik«."

msgctxt "#30104"
msgid "Force remux"
msgstr "Tving remuxning"

msgctxt "#30105"
msgid "Repackage the stream without re-encoding video. Use when the container causes problems but the codecs are fine."
msgstr "Ompak streamen uden at genkode videoen. Brug det, når containeren giver problemer, men codecs er i orden."

msgctxt "#30106"
msgid "Force transcode"
msgstr "Tving transkodning"

msgctxt "#30107"
msgid "Always re-encode on the server. Highest server load; use for troubleshooting or very constrained clients."
msgstr "Genkod altid på serveren. Højeste serverbelastning; brug det til fejlfinding eller meget begrænsede klienter."

msgctxt "#30108"
msgid "Direct play video codecs"
msgstr "Videocodecs til direkte afspilning"

msgctxt "#30109"
msgid "Video formats this device can decode. Media using formats not selected here is transcoded."
msgstr "Videoformater, denne enhed kan afkode. Medier i formater, der ikke er valgt her, transkodes."

msgctxt "#30110"
msgid "Direct play audio codecs"
msgstr "Lydcodecs til direkte afspilning"

msgctxt "#30111"
msgid "Audio formats this device can decode or pass through. Others are transcoded."
msgstr "Lydformater, denne enhed kan afkode eller sende uændret igennem. Andre transkodes."

msgctxt "#30112"
msgid "Allowed HDR types"
msgstr "Tilladte HDR-typer"

msgctxt "#30113"
msgid "HDR formats the display accepts. Media in formats not selected is tone-mapped or transcoded to SDR/HDR10 by the server."
msgstr "HDR-formater, som skærmen accepterer. Medier i formater, der ikke er valgt, tonemappes eller transkodes til SDR/HDR10 af serveren."

msgctxt "#30114"
msgid "Preferred video codec"
msgstr "Foretrukken videocodec"

msgctxt "#30115"
msgid "The codec the server targets when it must transcode video."
msgstr "Den codec, serveren sigter mod, når den skal transkode video."

msgctxt "#30116"
msgid "Preferred audio codec"
msgstr "Foretrukken lydcodec"

msgctxt "#30117"
msgid "The codec the server targets when it must transcode audio."
msgstr "Den codec, serveren sigter mod, når den skal transkode lyd."

msgctxt "#30118"
msgid "Maximum audio channels"
msgstr "Maksimalt antal lydkanaler"

msgctxt "#30119"
msgid "Maximum number of audio channels allowed when transcoding. Streams with more channels will be downmixed. No effect on direct playback."
msgstr "Maksimalt antal lydkanaler, der er tilladt ved transkodning. Streams med flere kanaler nedmixes. Ingen effekt på direkte afspilning."

msgctxt "#30120"
msgid "Maximum streaming bitrate"
msgstr "Maksimal streaming-bithastighed"

msgctxt "#30121"
msgid "Media above this bitrate is transcoded down to it. Unlimited suits LAN playback."
msgstr "Medier over denne bithastighed transkodes ned til den. Ubegrænset passer til afspilning på lokalnettet."

msgctxt "#30122"
msgid "Maximum resolution"
msgstr "Maksimal opløsning"

msgctxt "#30123"
msgid "Wider media is downscaled by the server."
msgstr "Bredere medier nedskaleres af serveren."

msgctxt "#30124"
msgid "Transcode audio bitrate"
msgstr "Bithastighed for transkodet lyd"

msgctxt "#30125"
msgid "Bitrate for the audio track when video is transcoded."
msgstr "Bithastighed for lydsporet, når videoen transkodes."

msgctxt "#30126"
msgid "Context menu bitrates"
msgstr "Bithastigheder i kontekstmenuen"

msgctxt "#30127"
msgid "Bitrates offered by 'Play with transcoding'. With exactly one selected the popup is skipped."
msgstr "Bithastigheder, som »Afspil med transkodning« tilbyder. Med præcis én valgt springes dialogen over."

msgctxt "#30128"
msgid "Music"
msgstr "Musik"

msgctxt "#30129"
msgid "Maximum music bitrate"
msgstr "Maksimal musikbithastighed"

msgctxt "#30130"
msgid "Music above this bitrate is transcoded using the codec and bitrate below. Unlimited never transcodes."
msgstr "Musik over denne bithastighed transkodes med codec'en og bithastigheden nedenfor. Ubegrænset transkoder aldrig."

msgctxt "#30131"
msgid "Music transcode codec"
msgstr "Codec til musiktranskodning"

msgctxt "#30132"
msgid "Codec for transcoded music streams."
msgstr "Codec til transkodede musikstreams."

msgctxt "#30133"
msgid "Music transcode bitrate"
msgstr "Bithastighed for musiktranskodning"

msgctxt "#30134"
msgid "Bitrate for transcoded music streams."
msgstr "Bithastighed for transkodede musikstreams."

msgctxt "#30135"
msgid "Transcode music"
msgstr "Transkod musik"

msgctxt "#30136"
msgid "Route music playback through the add-on so the settings below apply. Off, songs stream straight from the server untouched. Changing this needs a library repair of your music libraries to rewrite their paths."
msgstr "Send musikafspilningen gennem tilføjelsen, så indstillingerne nedenfor gælder. Slået fra streames sangene direkte fra serveren, uændret. Ændres dette, kræver det en biblioteksreparation af dine musikbiblioteker for at omskrive deres stier."

