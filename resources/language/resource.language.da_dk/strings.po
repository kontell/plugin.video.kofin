# 30650-30665 — Clean databases (the logged-out migration cleaner)
msgctxt "#30650"
msgid "Clean databases"
msgstr "Ryd databaserne"

msgctxt "#30651"
msgid "Remove all Kofin and Jellyfin for Kodi library data, nodes and playlists from this Kodi profile. For migrating from Jellyfin for Kodi, or before uninstalling Kofin. The Jellyfin server is not touched."
msgstr "Fjern alle biblioteksdata, noder og afspilningslister fra Kofin og Jellyfin for Kodi fra denne Kodi-profil. Til migrering fra Jellyfin for Kodi eller før afinstallation af Kofin. Jellyfin-serveren berøres ikke."

msgctxt "#30652"
msgid "Sign out before cleaning the databases."
msgstr "Log ud, før du rydder databaserne."

msgctxt "#30653"
msgid "A sync is still running — try again when it finishes."
msgstr "En synkronisering kører stadig — prøv igen, når den er færdig."

msgctxt "#30654"
msgid "Disable or uninstall the Jellyfin for Kodi add-on first: its background service would sync everything straight back."
msgstr "Deaktivér eller afinstallér tilføjelsen Jellyfin for Kodi først: dens baggrundstjeneste ville synkronisere det hele lige ind igen."

msgctxt "#30655"
msgid "Unsupported Kodi database: %s"
msgstr "Kodi-databasen understøttes ikke: %s"

msgctxt "#30656"
msgid "This removes EVERYTHING from Kodi's video library — including items added by other add-ons or local sources — together with watched states and resume points. The Jellyfin server is not touched. Continue?"
msgstr "Dette fjerner ALT fra Kodis videobibliotek — også elementer tilføjet af andre tilføjelser eller lokale kilder — sammen med set-status og genoptagelsespunkter. Jellyfin-serveren berøres ikke. Fortsæt?"

msgctxt "#30657"
msgid "Also clean the music library? Every song, album and artist in this profile's Kodi music library will be removed."
msgstr "Skal musikbiblioteket også ryddes? Hver sang, hvert album og hver kunstner i denne profils Kodi-musikbibliotek fjernes."

msgctxt "#30658"
msgid "Also remove ALL library nodes, including hand-made and node-editor files? Kodi's menus revert to their defaults. Choose No to remove only Kofin's and Jellyfin for Kodi's own nodes."
msgstr "Skal ALLE biblioteksnoder også fjernes, inklusive egne filer og filer fra nodeeditoren? Kodis menuer vender tilbage til standard. Vælg Nej for kun at fjerne Kofins og Jellyfin for Kodis egne noder."

msgctxt "#30659"
msgid "Also remove cached server artwork? Kodi re-downloads any images it still needs."
msgstr "Skal cachelagret billedmateriale fra serveren også fjernes? Kodi henter de billeder igen, som den stadig har brug for."

msgctxt "#30660"
msgid "Cleaning video library…"
msgstr "Rydder videobiblioteket…"

msgctxt "#30661"
msgid "Cleaning music library…"
msgstr "Rydder musikbiblioteket…"

msgctxt "#30662"
msgid "Removing add-on state…"
msgstr "Fjerner tilføjelsens tilstand…"

msgctxt "#30663"
msgid "Removing library nodes and playlists…"
msgstr "Fjerner biblioteksnoder og afspilningslister…"

msgctxt "#30664"
msgid "Removing cached artwork…"
msgstr "Fjerner cachelagret billedmateriale…"

msgctxt "#30665"
msgid "Clean complete. Kodi will now restart."
msgstr "Rydningen er fuldført. Kodi genstarter nu."

# 30666-30667 — critic ratings
msgctxt "#30666"
msgid "Movies: prefer critic rating"
msgstr "Film: foretræk anmelderbedømmelse"

msgctxt "#30667"
msgid "Show your server's critic rating (Rotten Tomatoes) instead of the community rating. Percentages are rescaled so 78% becomes 7.8."
msgstr "Vis din servers anmelderbedømmelse (Rotten Tomatoes) i stedet for fællesskabets bedømmelse. Procenter skaleres om, så 78% bliver 7,8."

# 30668-30673 — actor art pre-cache
msgctxt "#30668"
msgid "Pre-cache cast images when idle"
msgstr "Cachelagr billeder af medvirkende ved inaktivitet"

msgctxt "#30669"
msgid "Cache cast thumbnails while Kodi is idle, so an item's info dialog draws them instantly. Uses disk in Kodi's thumbnail cache — roughly 60 KB per person, which on a large library can reach gigabytes."
msgstr "Cachelagr miniaturer af de medvirkende, mens Kodi er inaktiv, så et elements infodialog tegner dem med det samme. Bruger diskplads i Kodis miniaturecache — omkring 60 KB pr. person, hvilket på et stort bibliotek kan løbe op i gigabyte."

msgctxt "#30670"
msgid "Pre-cache cast images now"
msgstr "Cachelagr billeder af medvirkende nu"

msgctxt "#30671"
msgid "Fetch every cast thumbnail that is not cached yet, without waiting for idle time."
msgstr "Hent alle miniaturer af medvirkende, der endnu ikke er cachelagret, uden at vente på inaktiv tid."

msgctxt "#30672"
msgid "Caching cast images"
msgstr "Cachelagrer billeder af medvirkende"

msgctxt "#30673"
msgid "Cached %d cast image(s)"
msgstr "Cachelagrede %d billede(r) af medvirkende"


msgctxt "#30700"
msgid "Downloads"
msgstr "Downloads"

msgctxt "#30701"
msgid "Download items for offline playback"
msgstr "Hent elementer til offlineafspilning"

msgctxt "#30702"
msgid "Enable downloads"
msgstr "Aktivér downloads"

msgctxt "#30703"
msgid "Adds Download to the Jellyfin actions menu and runs the download manager. Only for libraries you sync with Kofin."
msgstr "Tilføjer Hent i menuen Jellyfin-handlinger og kører downloadhåndteringen. Kun for biblioteker, du synkroniserer med Kofin."

msgctxt "#30704"
msgid "Download location"
msgstr "Downloadmappe"

msgctxt "#30705"
msgid "Where downloaded files are kept. Leave empty for the addon profile folder"
msgstr "Hvor hentede filer gemmes. Lad stå tom for tilføjelsens profilmappe"

msgctxt "#30706"
msgid "Parallel video downloads"
msgstr "Parallelle videodownloads"

msgctxt "#30707"
msgid "How many movies and episodes download at the same time"
msgstr "Hvor mange film og episoder der hentes samtidigt"

msgctxt "#30708"
msgid "Download"
msgstr "Hent"

msgctxt "#30709"
msgid "Cancel download"
msgstr "Annullér download"

msgctxt "#30710"
msgid "Delete download"
msgstr "Slet download"

msgctxt "#30711"
msgid "%s download(s) queued"
msgstr "%s download(s) i kø"

msgctxt "#30712"
msgid "Download complete: %s"
msgstr "Download fuldført: %s"

msgctxt "#30713"
msgid "Download failed: %s"
msgstr "Download mislykkedes: %s"

msgctxt "#30714"
msgid "Delete the download of %s?"
msgstr "Slet downloaden af %s?"

msgctxt "#30715"
msgid "Not enough free space for %s"
msgstr "Ikke nok ledig plads til %s"

msgctxt "#30716"
msgid "Download %s item(s) (%s)?"
msgstr "Hent %s element(er) (%s)?"

msgctxt "#30717"
msgid "The downloads folder is not writable"
msgstr "Der kan ikke skrives til downloadmappen"

msgctxt "#30718"
msgid "Downloaded movies"
msgstr "Hentede film"

msgctxt "#30719"
msgid "Downloaded shows"
msgstr "Hentede serier"

msgctxt "#30720"
msgid "Not available offline"
msgstr "Ikke tilgængelig offline"

msgctxt "#30721"
msgid "Downloaded episodes"
msgstr "Hentede episoder"

msgctxt "#30722"
msgid "Transcode videos"
msgstr "Transkod videoer"

msgctxt "#30723"
msgid "Transcode when the original exceeds a limit below or when triggered by settings in the Transcoding tab (HDR, codec, etc)"
msgstr "Transkod, når originalen overskrider en grænse nedenfor, eller når det udløses af indstillinger under fanen Transkodning (HDR, codec osv.)"

msgctxt "#30724"
msgid "Maximum download bitrate"
msgstr "Maksimal downloadbithastighed"

msgctxt "#30725"
msgid "Videos over this total bitrate are transcoded down to it. Unlimited transcodes only for codec, HDR or resolution reasons."
msgstr "Videoer over denne samlede bithastighed transkodes ned til den. Ubegrænset transkoder kun af hensyn til codec, HDR eller opløsning."

msgctxt "#30726"
msgid "Maximum download resolution"
msgstr "Maksimal downloadopløsning"

msgctxt "#30727"
msgid "Videos wider than this are scaled down. Unlimited never scales."
msgstr "Videoer, der er bredere end dette, skaleres ned. Ubegrænset skalerer aldrig."

msgctxt "#30728"
msgid "Transcode music"
msgstr "Transkod musik"

msgctxt "#30729"
msgid "Transcode a track only when it is lossless or over the bitrate limit below. Compliant tracks download as the original file with their tags intact."
msgstr "Transkod kun et spor, når det er tabsfrit eller over bithastighedsgrænsen nedenfor. Spor, der overholder kravene, hentes som originalfilen med deres tags intakte."

msgctxt "#30730"
msgid "Transcode music over"
msgstr "Transkod musik over"

msgctxt "#30731"
msgid "Tracks over this bitrate, and all lossless tracks, are transcoded. Unlimited transcodes only lossless tracks."
msgstr "Spor over denne bithastighed, og alle tabsfrie spor, transkodes. Ubegrænset transkoder kun tabsfrie spor."

msgctxt "#30732"
msgid "Transcode music to"
msgstr "Transkod musik til"

msgctxt "#30733"
msgid "The codec transcoded tracks are encoded with. Opus gives the best quality per megabyte."
msgstr "Den codec, transkodede spor kodes med. Opus giver den bedste kvalitet pr. megabyte."

msgctxt "#30734"
msgid "Transcoded music bitrate"
msgstr "Bithastighed for transkodet musik"

msgctxt "#30735"
msgid "The bitrate transcoded tracks are encoded at. 128 kbps Opus is transparent for most listening."
msgstr "Den bithastighed, transkodede spor kodes med. 128 kbps Opus er transparent for de fleste lyttesituationer."

msgctxt "#30736"
msgid "Downloaded music"
msgstr "Hentet musik"

msgctxt "#30737"
msgid "Kofin downloads"
msgstr "Kofin-downloads"

msgctxt "#30738"
msgid "Download the next episodes automatically"
msgstr "Hent de næste episoder automatisk"

msgctxt "#30739"
msgid "While watching a downloaded episode, the next unwatched episodes of the show are queued for download at the 80% mark."
msgstr "Mens du ser en hentet episode, sættes seriens næste usete episoder i kø til download ved 80%-mærket."

msgctxt "#30740"
msgid "Episodes to keep ahead"
msgstr "Episoder at ligge foran med"

msgctxt "#30741"
msgid "How many unwatched episodes ahead of the one playing are kept downloaded."
msgstr "Hvor mange usete episoder foran den, der afspilles, der holdes hentet."

msgctxt "#30742"
msgid "Download newly added movies"
msgstr "Hent nyligt tilføjede film"

msgctxt "#30743"
msgid "Movies newly added to a synced library are downloaded automatically. A bulk import of more than a few movies at once is skipped, with a notification."
msgstr "Film, der netop er føjet til et synkroniseret bibliotek, hentes automatisk. En masseimport af mere end et par film ad gangen springes over, med en notifikation."

# 30744-30745, 30748-30750 — retired with downloadsAutoCleanup and the
# three-way downloadsDeleteAfterPlay spinner. Kept, never reused: an id that
# changes meaning silently mistranslates every language that already shipped
# it.
msgctxt "#30744"
msgid "Remove watched automatic downloads"
msgstr "Fjern sete automatiske downloads"

msgctxt "#30745"
msgid "Automatically downloaded items are removed once you have watched them. Downloads you queued yourself are never removed automatically."
msgstr "Automatisk hentede elementer fjernes, når du har set dem. Downloads, du selv har sat i kø, fjernes aldrig automatisk."

msgctxt "#30746"
msgid "Delete download after watching"
msgstr "Slet download efter visning"

msgctxt "#30747"
msgid "When you finish watching a downloaded item, its local copy is removed. The item stays on the server and in your library."
msgstr "Når du er færdig med at se et hentet element, fjernes den lokale kopi. Elementet bliver på serveren og i dit bibliotek."

msgctxt "#30748"
msgid "Keep it"
msgstr "Behold den"

msgctxt "#30749"
msgid "Ask to remove it"
msgstr "Spørg, om den skal fjernes"

msgctxt "#30750"
msgid "Remove it without asking"
msgstr "Fjern den uden at spørge"

msgctxt "#30751"
msgid "%s new movies were not downloaded automatically"
msgstr "%s nye film blev ikke hentet automatisk"

msgctxt "#30752"
msgid "Export NFO files and artwork"
msgstr "Eksportér NFO-filer og billedmateriale"

msgctxt "#30753"
msgid "Write NFO metadata and artwork beside downloaded files, so other apps can scan the download folder as a library."
msgstr "Skriv NFO-metadata og billedmateriale ved siden af hentede filer, så andre apps kan skanne downloadmappen som et bibliotek."

msgctxt "#30754"
msgid "Download all new episodes"
msgstr "Hent alle nye episoder"

msgctxt "#30755"
msgid "Every episode newly added to a synced library is downloaded automatically. A bulk import of many episodes at once is skipped, with a notification."
msgstr "Hver episode, der netop føjes til et synkroniseret bibliotek, hentes automatisk. En masseimport af mange episoder ad gangen springes over, med en notifikation."

msgctxt "#30756"
msgid "Download new albums"
msgstr "Hent nye album"

msgctxt "#30757"
msgid "Albums newly added to a synced library are downloaded automatically. A bulk import of many albums at once is skipped, with a notification."
msgstr "Album, der netop føjes til et synkroniseret bibliotek, hentes automatisk. En masseimport af mange album ad gangen springes over, med en notifikation."

msgctxt "#30758"
msgid "Shows downloading new episodes"
msgstr "Serier, der henter nye episoder"

msgctxt "#30759"
msgid "Review the shows set to download their new episodes automatically, and untick any to stop."
msgstr "Gennemgå de serier, der er sat til at hente deres nye episoder automatisk, og fjern fluebenet ved dem, du vil stoppe."

msgctxt "#30760"
msgid "Download new episodes"
msgstr "Hent nye episoder"

msgctxt "#30761"
msgid "Stop downloading new episodes"
msgstr "Stop med at hente nye episoder"

msgctxt "#30762"
msgid "New episodes of %s will download automatically"
msgstr "Nye episoder af %s hentes automatisk"

msgctxt "#30763"
msgid "New episodes of %s will no longer download automatically"
msgstr "Nye episoder af %s hentes ikke længere automatisk"

msgctxt "#30764"
msgid "%s new episodes were not downloaded automatically"
msgstr "%s nye episoder blev ikke hentet automatisk"

msgctxt "#30765"
msgid "%s new albums were not downloaded automatically"
msgstr "%s nye album blev ikke hentet automatisk"

msgctxt "#30766"
msgid "No shows are set to download new episodes"
msgstr "Ingen serier er sat til at hente nye episoder"

msgctxt "#30767"
msgid "Show download notifications"
msgstr "Vis downloadnotifikationer"

msgctxt "#30768"
msgid "Announce queued and completed downloads. Failures and warnings are always shown."
msgstr "Bekendtgør downloads, der sættes i kø og fuldføres. Fejl og advarsler vises altid."

msgctxt "#30769"
msgid "Delete download automatically"
msgstr "Slet download automatisk"

msgctxt "#30770"
msgid "Remove the local copy without asking. With this off, Kofin asks first each time."
msgstr "Fjern den lokale kopi uden at spørge. Med dette slået fra spørger Kofin først hver gang."

msgctxt "#30771"
msgid "Download %s item(s), about %s? %s free"
msgstr "Hent %s element(er), ca. %s? %s ledig"

msgctxt "#30772"
msgid "Parallel music downloads"
msgstr "Parallelle musikdownloads"

msgctxt "#30773"
msgid "How many tracks download at the same time. Tracks are small and mostly overhead, so this can sit well above the video figure."
msgstr "Hvor mange spor der hentes samtidigt. Spor er små og består mest af overhead, så dette kan ligge et godt stykke over tallet for video."

# 30774 — retired with the Delete download confirmation. Kept, never reused,
# for the reason given at #30744. #30714 stays live: the finished-watching
# offer in service/player.py still asks.
msgctxt "#30774"
msgid "Delete %s download(s) of %s?"
msgstr "Slet %s download(s) af %s?"

# 30775-30776 — the other half of #30617: a text subtitle a transcode did not
# attach is fetched onto the running playback, not burned in and not restarted
msgctxt "#30775"
msgid "downloaded from the server"
msgstr "hentet fra serveren"

msgctxt "#30776"
msgid "Downloading subtitle..."
msgstr "Henter undertekst..."

# 30777-30797 — Jellyfin account settings: the server-side user preferences
# that resolve every playback's default audio and subtitle track, edited from
# the Account tab (plugin/userprefs.py)
msgctxt "#30777"
msgid "Jellyfin account settings"
msgstr "Indstillinger for Jellyfin-kontoen"

msgctxt "#30778"
msgid "Audio and subtitle preferences stored on the server against your Jellyfin account. They apply to every client you sign in from, not just this one."
msgstr "Indstillinger for lyd og undertekster, der gemmes på serveren for din Jellyfin-konto. De gælder alle klienter, du logger ind fra, ikke kun denne."

msgctxt "#30779"
msgid "Jellyfin settings for %s"
msgstr "Jellyfin-indstillinger for %s"

msgctxt "#30780"
msgid "Preferred audio language"
msgstr "Foretrukket lydsprog"

msgctxt "#30781"
msgid "Play default audio track"
msgstr "Afspil standardlydspor"

msgctxt "#30782"
msgid "Preferred subtitle language"
msgstr "Foretrukket undertekstsprog"

msgctxt "#30783"
msgid "Subtitle mode"
msgstr "Underteksttilstand"

msgctxt "#30784"
msgid "Remember audio selections"
msgstr "Husk valg af lydspor"

msgctxt "#30785"
msgid "Remember subtitle selections"
msgstr "Husk valg af undertekster"

msgctxt "#30786"
msgid "Enabled"
msgstr "Aktiveret"

msgctxt "#30787"
msgid "Disabled"
msgstr "Deaktiveret"

msgctxt "#30788"
msgid "Any"
msgstr "Alle"

msgctxt "#30789"
msgid "Default"
msgstr "Standard"

msgctxt "#30790"
msgid "Always"
msgstr "Altid"

msgctxt "#30791"
msgid "Only forced"
msgstr "Kun tvungne"

msgctxt "#30792"
msgid "None"
msgstr "Ingen"

msgctxt "#30793"
msgid "Smart"
msgstr "Smart"

msgctxt "#30794"
msgid "Not applied here: \"Use Jellyfin's default tracks\" is off"
msgstr "Gælder ikke her: \"Brug Jellyfins standardspor\" er slået fra"

msgctxt "#30795"
msgid "Could not load your Jellyfin settings"
msgstr "Dine Jellyfin-indstillinger kunne ikke indlæses"

msgctxt "#30796"
msgid "Could not save to the server"
msgstr "Kunne ikke gemme på serveren"

msgctxt "#30797"
msgid "Your Jellyfin account is not allowed to change these settings"
msgstr "Din Jellyfin-konto har ikke lov til at ændre disse indstillinger"

# 30798-30803 — the bulk-import guard, one threshold per automatic arm. Over
# the number the whole batch is skipped rather than trimmed: an arbitrary few
# of hundreds is worse than asking.
msgctxt "#30798"
msgid "Skip movie imports larger than"
msgstr "Spring filmimporter over, der er større end"

msgctxt "#30799"
msgid "When a sync adds more new movies than this at once, none of them are downloaded — a bulk import is rarely a request to fill the disk. Raise it if you want big additions pulled automatically."
msgstr "Når en synkronisering tilføjer flere nye film end dette på én gang, hentes ingen af dem — en masseimport er sjældent en anmodning om at fylde disken. Hæv værdien, hvis du vil have store tilføjelser hentet automatisk."

msgctxt "#30800"
msgid "Skip episode imports larger than"
msgstr "Spring episodeimporter over, der er større end"

msgctxt "#30801"
msgid "When a sync adds more new episodes than this at once, none of them are downloaded. Shows you have subscribed to are exempt — a subscription is a standing order."
msgstr "Når en synkronisering tilføjer flere nye episoder end dette på én gang, hentes ingen af dem. Serier, du har abonneret på, er undtaget — et abonnement er en stående ordre."

msgctxt "#30802"
msgid "Skip album imports larger than"
msgstr "Spring albumimporter over, der er større end"

msgctxt "#30803"
msgid "When a sync adds more new albums than this at once, none of them are downloaded. Counted in albums, not tracks."
msgstr "Når en synkronisering tilføjer flere nye album end dette på én gang, hentes ingen af dem. Tælles i album, ikke spor."

# 30810 — the aggregate refusal, before anything is queued. Distinct from
# #30715, which the manager raises per item once a transfer is under way.
#
# Kept short deliberately. A Kodi notification fits about 33 characters and
# *scrolls* the rest, so a longer line is read a window at a time — measured
# live, "Not enough free space: 5.7 GB needed, 4.2 GB free" was caught
# mid-scroll as "enough free space: 5.7 GB needed,", which says the opposite
# of what it means. The warning glyph and the Kofin heading carry the rest.
msgctxt "#30810"
msgid "Needs %s, only %s free"
msgstr "Kræver %s, kun %s ledig"

# 30804-30807 — the settings button that clears every download at once. The
# confirmation states what is on disk rather than what was promised: a queued
# row has fetched nothing yet, and a transcode usually lands under its source.
msgctxt "#30804"
msgid "Delete all downloads"
msgstr "Slet alle downloads"

msgctxt "#30805"
msgid "Delete every downloaded file from this device. The items stay in your library and play from the server again."
msgstr "Slet alle hentede filer fra denne enhed. Elementerne bliver i dit bibliotek og afspilles fra serveren igen."

msgctxt "#30806"
msgid "Delete all %s download(s), freeing about %s?"
msgstr "Slet alle %s download(s), og frigør ca. %s?"

msgctxt "#30807"
msgid "There are no downloads to delete"
msgstr "Der er ingen downloads at slette"

# 30808-30809 — the playback gate. It holds the queue, not a transfer in
# flight: stopping mid-file would strand a .part for the length of a film.
msgctxt "#30808"
msgid "Pause downloads during playback"
msgstr "Pause downloads under afspilning"

msgctxt "#30809"
msgid "Do not start new downloads while something is playing, video or music. A file already downloading finishes; the rest wait until playback stops."
msgstr "Start ikke nye downloads, mens noget afspilles, hverken video eller musik. En fil, der allerede hentes, gøres færdig; resten venter, til afspilningen stopper."

# 30811-30814 — the stale sweep. Its help text has to carry the resume-point
# exemption: an unfinished film sitting untouched for months is exactly what
# a user expects an age-based rule to eat, and the promise that it will not
# is the reason the setting is safe to leave on.
msgctxt "#30811"
msgid "Delete stale downloads"
msgstr "Slet gamle downloads"

msgctxt "#30812"
msgid "Remove downloaded files nobody has played for a while. Anything you are part-way through is kept, however long it sits. The items stay in your library and play from the server again."
msgstr "Fjern hentede filer, som ingen har afspillet i et stykke tid. Alt, du er midt i, beholdes, uanset hvor længe det ligger. Elementerne bliver i dit bibliotek og afspilles fra serveren igen."

msgctxt "#30813"
msgid "Delete after (days)"
msgstr "Slet efter (dage)"

msgctxt "#30814"
msgid "How long a download may sit unplayed before it is removed. Playing it again starts the count over."
msgstr "Hvor længe en download må ligge uafspillet, før den fjernes. Afspilles den igen, starter tællingen forfra."

# 30815-30816 — the Clean databases downloads prompt. It has to say what
# happens if you decline: the clean deletes kofin.db, and the download table
# lives there, so files kept behind are files nothing will ever manage again.
msgctxt "#30815"
msgid "Also delete your %s downloaded file(s)? Cleaning removes Kofin's record of them, so any you keep are left on disk for you to manage yourself."
msgstr "Skal dine %s hentede fil(er) også slettes? Rydning fjerner Kofins oversigt over dem, så dem, du beholder, bliver liggende på disken, som du selv må håndtere."

msgctxt "#30816"
msgid "Removing downloaded files…"
msgstr "Fjerner hentede filer…"

# 30817 — the shortlist's first row. Not #30030's "All": that one labels a
# browse node ("all movies"), and the languages that decline the word render
# the two differently — French wants "Tout" there and "Tous" for a list of
# people. #30080 quotes this label verbatim, which pocheck.py enforces.
msgctxt "#30817"
msgid "All"
msgstr "Alle"
