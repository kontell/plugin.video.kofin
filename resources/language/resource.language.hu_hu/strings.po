msgctxt "Addon Summary"
msgid "Jellyfin client for seamless Kodi integration"
msgstr "Jellyfin-kliens zökkenőmentes Kodi-integrációval"

msgctxt "Addon Description"
msgid "Play movies, shows & music from a Jellyfin server."
msgstr "Filmek, sorozatok és zene lejátszása Jellyfin-kiszolgálóról."

msgctxt "#30010"
msgid "Play with transcoding"
msgstr "Lejátszás átkódolással"

msgctxt "#30011"
msgid "Quick Connect"
msgstr "Quick Connect"

msgctxt "#30012"
msgid "Username and password"
msgstr "Felhasználónév és jelszó"

msgctxt "#30013"
msgid "Username"
msgstr "Felhasználónév"

msgctxt "#30014"
msgid "Password"
msgstr "Jelszó"

msgctxt "#30015"
msgid "Enter code [B]%s[/B] in the Jellyfin app or web interface."
msgstr "Írja be a(z) [B]%s[/B] kódot a Jellyfin alkalmazásban vagy a webes felületen."

msgctxt "#30016"
msgid "Logged in as %s"
msgstr "Bejelentkezve mint %s"

msgctxt "#30017"
msgid "Login failed: wrong username or password"
msgstr "Sikertelen bejelentkezés: hibás felhasználónév vagy jelszó"

msgctxt "#30018"
msgid "Server unreachable"
msgstr "A kiszolgáló nem érhető el"

msgctxt "#30019"
msgid "Log out from %s?"
msgstr "Kijelentkezés innen: %s?"

msgctxt "#30020"
msgid "Logged out"
msgstr "Kijelentkezve"

msgctxt "#30021"
msgid "Connection OK — %s (%s)"
msgstr "A kapcsolat rendben — %s (%s)"

msgctxt "#30022"
msgid "Session rejected — log in again from the Account tab"
msgstr "A munkamenet elutasítva — jelentkezzen be újra a Fiók lapon"

msgctxt "#30023"
msgid "Restarting the Kofin service"
msgstr "A Kofin szolgáltatás újraindul"

msgctxt "#30024"
msgid "Quick Connect timed out"
msgstr "A Quick Connect túllépte az időkorlátot"

msgctxt "#30025"
msgid "Already logged in"
msgstr "Már be van jelentkezve"

msgctxt "#30026"
msgid "Not logged in"
msgstr "Nincs bejelentkezve"

msgctxt "#30027"
msgid "Log in to %s"
msgstr "Bejelentkezés ide: %s"

msgctxt "#30050"
msgid "Account"
msgstr "Fiók"

msgctxt "#30051"
msgid "Connect to your Jellyfin server and manage the session."
msgstr "Csatlakozás a Jellyfin-kiszolgálóhoz és a munkamenet kezelése."

msgctxt "#30052"
msgid "Server address"
msgstr "Kiszolgáló címe"

msgctxt "#30053"
msgid "Host name, IP address or full URL of the Jellyfin server. A bare host uses http on port 8096."
msgstr "A Jellyfin-kiszolgáló gépneve, IP-címe vagy teljes URL-címe. Puszta gépnév esetén http és a 8096-os port az alapértelmezés."

msgctxt "#30054"
msgid "Log in…"
msgstr "Bejelentkezés…"

msgctxt "#30055"
msgid "Connect to the server above using Quick Connect or a username and password."
msgstr "Csatlakozás a fenti kiszolgálóhoz Quick Connecttel vagy felhasználónévvel és jelszóval."

msgctxt "#30056"
msgid "Server"
msgstr "Kiszolgáló"

msgctxt "#30057"
msgid "The connected Jellyfin server."
msgstr "A csatlakoztatott Jellyfin-kiszolgáló."

msgctxt "#30058"
msgid "Logged-in user"
msgstr "Bejelentkezett felhasználó"

msgctxt "#30059"
msgid "The Jellyfin user this device plays and reports as."
msgstr "Az a Jellyfin-felhasználó, akiként ez az eszköz lejátszik és jelent."

msgctxt "#30060"
msgid "Test connection"
msgstr "Kapcsolat tesztelése"

msgctxt "#30061"
msgid "Check that the server is reachable and the session is still valid."
msgstr "Annak ellenőrzése, hogy a kiszolgáló elérhető-e és a munkamenet még érvényes-e."

msgctxt "#30062"
msgid "Log out"
msgstr "Kijelentkezés"

msgctxt "#30063"
msgid "End the session on the server and forget it on this device. The server address is kept."
msgstr "A munkamenet lezárása a kiszolgálón és elfelejtése ezen az eszközön. A kiszolgáló címe megmarad."

msgctxt "#30064"
msgid "Restart Kofin"
msgstr "A Kofin újraindítása"

msgctxt "#30065"
msgid "Restart the background service without restarting Kodi."
msgstr "A háttérszolgáltatás újraindítása a Kodi újraindítása nélkül."

msgctxt "#30066"
msgid "Verify SSL certificate"
msgstr "SSL-tanúsítvány ellenőrzése"

msgctxt "#30067"
msgid "Disable only for servers with self-signed certificates."
msgstr "Csak saját aláírású tanúsítvánnyal rendelkező kiszolgálóknál kapcsolja ki."

msgctxt "#30068"
msgid "Device name"
msgstr "Eszköz neve"

msgctxt "#30069"
msgid "How this device appears in the Jellyfin dashboard and cast menus."
msgstr "Így jelenik meg ez az eszköz a Jellyfin vezérlőpultján és az átküldési menükben."

msgctxt "#30070"
msgid "Connection"
msgstr "Kapcsolat"

msgctxt "#30071"
msgid "Advanced"
msgstr "Speciális"

msgctxt "#30072"
msgid "SSL verification and other advanced options."
msgstr "SSL-ellenőrzés és további speciális beállítások."

msgctxt "#30073"
msgid "Enable Delete from server"
msgstr "Törlés a kiszolgálóról engedélyezése"

msgctxt "#30074"
msgid "Adds a Delete entry to an item's 'Jellyfin actions' context menu. Deletion is permanent: the file itself is removed on the Jellyfin server, for every user."
msgstr "Törlés bejegyzést ad az elem „Jellyfin műveletek” helyi menüjéhez. A törlés végleges: maga a fájl törlődik a Jellyfin-kiszolgálón, minden felhasználó számára."

msgctxt "#30075"
msgid "Delete without confirmation"
msgstr "Törlés megerősítés nélkül"

msgctxt "#30076"
msgid "Delete the item as soon as the entry is picked, with no 'are you sure?' prompt. The deletion is still permanent and applies on the server."
msgstr "Az elem törlése azonnal, amint kiválasztja a bejegyzést, „biztos benne?” kérdés nélkül. A törlés továbbra is végleges, és a kiszolgálón történik."

msgctxt "#30077"
msgid "Offer to delete after watching"
msgstr "Törlés felajánlása megtekintés után"

msgctxt "#30078"
msgid "When a movie or episode finishes, ask whether to delete it from the server. Always asks, whatever 'Delete without confirmation' is set to."
msgstr "Ha egy film vagy epizód véget ér, rákérdez, hogy törölje-e a kiszolgálóról. Mindig rákérdez, a „Törlés megerősítés nélkül” beállítástól függetlenül."

msgctxt "#30079"
msgid "Who's watching shortlist"
msgstr "A Ki néz? szűkített listája"

msgctxt "#30080"
msgid "Choose which server users the addon's Who's watching? entry offers. \"All\" offers everyone. With nothing selected the entry is hidden and anyone already on the session is removed."
msgstr "Válassza ki, mely kiszolgálófelhasználókat kínálja fel a kiegészítő Ki néz? bejegyzése. Az \"Összes\" mindenkit felkínál. Ha semmi sincs kiválasztva, a bejegyzés eltűnik, és aki már a munkamenetben van, azt eltávolítja."

msgctxt "#30030"
msgid "All"
msgstr "Összes"

msgctxt "#30031"
msgid "Recently added"
msgstr "Nemrég hozzáadott"

msgctxt "#30032"
msgid "Next up"
msgstr "Következik"

msgctxt "#30033"
msgid "In progress"
msgstr "Folyamatban"

msgctxt "#30034"
msgid "Unwatched"
msgstr "Megtekintetlen"

msgctxt "#30035"
msgid "Favourites"
msgstr "Kedvencek"

msgctxt "#30036"
msgid "Genres"
msgstr "Műfajok"

msgctxt "#30037"
msgid "Random"
msgstr "Véletlenszerű"

msgctxt "#30038"
msgid "Sets"
msgstr "Gyűjtemények"

msgctxt "#30039"
msgid "Artists"
msgstr "Előadók"

msgctxt "#30040"
msgid "Albums"
msgstr "Albumok"

msgctxt "#30049"
msgid "Continue watching"
msgstr "Nézés folytatása"

msgctxt "#30100"
msgid "Transcoding"
msgstr "Átkódolás"

msgctxt "#30101"
msgid "When and how the server converts media for this device."
msgstr "Mikor és hogyan alakítsa át a kiszolgáló a médiát ehhez az eszközhöz."

msgctxt "#30102"
msgid "Force direct play"
msgstr "Közvetlen lejátszás kényszerítése"

msgctxt "#30103"
msgid "Always play the original video file. Overrides every other video transcoding setting; playback fails if the device cannot handle the media. Music is unaffected — see 'Transcode music'."
msgstr "Mindig az eredeti videofájl lejátszása. Felülbírál minden más videoátkódolási beállítást; a lejátszás meghiúsul, ha az eszköz nem tudja kezelni a médiát. A zenét nem érinti — lásd a „Zene átkódolása” beállítást."

msgctxt "#30104"
msgid "Force remux"
msgstr "Remuxolás kényszerítése"

msgctxt "#30105"
msgid "Repackage the stream without re-encoding video. Use when the container causes problems but the codecs are fine."
msgstr "Az adatfolyam újracsomagolása a videó újrakódolása nélkül. Akkor használja, ha a konténer okoz gondot, de a kodekek megfelelők."

msgctxt "#30106"
msgid "Force transcode"
msgstr "Átkódolás kényszerítése"

msgctxt "#30107"
msgid "Always re-encode on the server. Highest server load; use for troubleshooting or very constrained clients."
msgstr "Mindig újrakódolás a kiszolgálón. Ez terheli legjobban a kiszolgálót; hibakereséshez vagy erősen korlátozott klienseknél használja."

msgctxt "#30108"
msgid "Direct play video codecs"
msgstr "Közvetlen lejátszású videokodekek"

msgctxt "#30109"
msgid "Video formats this device can decode. Media using formats not selected here is transcoded."
msgstr "Azok a videoformátumok, amelyeket ez az eszköz dekódolni tud. Az itt nem kiválasztott formátumú média átkódolásra kerül."

msgctxt "#30110"
msgid "Direct play audio codecs"
msgstr "Közvetlen lejátszású hangkodekek"

msgctxt "#30111"
msgid "Audio formats this device can decode or pass through. Others are transcoded."
msgstr "Azok a hangformátumok, amelyeket ez az eszköz dekódolni vagy továbbítani tud. A többi átkódolásra kerül."

msgctxt "#30112"
msgid "Allowed HDR types"
msgstr "Engedélyezett HDR-típusok"

msgctxt "#30113"
msgid "HDR formats the display accepts. Media in formats not selected is tone-mapped or transcoded to SDR/HDR10 by the server."
msgstr "A kijelző által elfogadott HDR-formátumok. A nem kiválasztott formátumú médiát a kiszolgáló tónusleképezéssel vagy átkódolással SDR-be, illetve HDR10-be alakítja."

msgctxt "#30114"
msgid "Preferred video codec"
msgstr "Előnyben részesített videokodek"

msgctxt "#30115"
msgid "The codec the server targets when it must transcode video."
msgstr "Az a kodek, amelyet a kiszolgáló céloz, ha át kell kódolnia a videót."

msgctxt "#30116"
msgid "Preferred audio codec"
msgstr "Előnyben részesített hangkodek"

msgctxt "#30117"
msgid "The codec the server targets when it must transcode audio."
msgstr "Az a kodek, amelyet a kiszolgáló céloz, ha át kell kódolnia a hangot."

msgctxt "#30118"
msgid "Maximum audio channels"
msgstr "Hangcsatornák maximális száma"

msgctxt "#30119"
msgid "Maximum number of audio channels allowed when transcoding. Streams with more channels will be downmixed. No effect on direct playback."
msgstr "Az átkódoláskor engedélyezett hangcsatornák maximális száma. A több csatornát tartalmazó adatfolyamok lekeverésre kerülnek. Nincs hatása a közvetlen lejátszásra."

msgctxt "#30120"
msgid "Maximum streaming bitrate"
msgstr "Maximális streamelési bitráta"

msgctxt "#30121"
msgid "Media above this bitrate is transcoded down to it. Unlimited suits LAN playback."
msgstr "Az ennél nagyobb bitrátájú média erre a szintre lesz átkódolva. A korlátlan a helyi hálózati lejátszáshoz való."

msgctxt "#30122"
msgid "Maximum resolution"
msgstr "Maximális felbontás"

msgctxt "#30123"
msgid "Wider media is downscaled by the server."
msgstr "A szélesebb médiát a kiszolgáló leskálázza."

msgctxt "#30124"
msgid "Transcode audio bitrate"
msgstr "Átkódolt hang bitrátája"

msgctxt "#30125"
msgid "Bitrate for the audio track when video is transcoded."
msgstr "A hangsáv bitrátája, ha a videó átkódolásra kerül."

msgctxt "#30126"
msgid "Context menu bitrates"
msgstr "Helyi menü bitrátái"

msgctxt "#30127"
msgid "Bitrates offered by 'Play with transcoding'. With exactly one selected the popup is skipped."
msgstr "A „Lejátszás átkódolással” által felkínált bitráták. Ha pontosan egy van kiválasztva, a felugró ablak kimarad."

msgctxt "#30128"
msgid "Music"
msgstr "Zene"

msgctxt "#30129"
msgid "Maximum music bitrate"
msgstr "Maximális zenebitráta"

msgctxt "#30130"
msgid "Music above this bitrate is transcoded using the codec and bitrate below. Unlimited never transcodes."
msgstr "Az ennél nagyobb bitrátájú zene az alábbi kodekkel és bitrátával lesz átkódolva. A korlátlan sosem kódol át."

msgctxt "#30131"
msgid "Music transcode codec"
msgstr "Zene átkódolási kodeke"

msgctxt "#30132"
msgid "Codec for transcoded music streams."
msgstr "Az átkódolt zenei adatfolyamok kodeke."

msgctxt "#30133"
msgid "Music transcode bitrate"
msgstr "Zene átkódolási bitrátája"

msgctxt "#30134"
msgid "Bitrate for transcoded music streams."
msgstr "Az átkódolt zenei adatfolyamok bitrátája."

msgctxt "#30135"
msgid "Transcode music"
msgstr "Zene átkódolása"

msgctxt "#30136"
msgid "Route music playback through the add-on so the settings below apply. Off, songs stream straight from the server untouched. Changing this needs a library repair of your music libraries to rewrite their paths."
msgstr "A zenelejátszás átvezetése a kiegészítőn, hogy az alábbi beállítások érvényesüljenek. Kikapcsolva a dalok érintetlenül, közvetlenül a kiszolgálóról streamelnek. A módosítás után a zenei médiatárak javítása szükséges az útvonalaik újraírásához."

