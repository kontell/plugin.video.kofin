msgctxt "#30041"
msgid "Who's watching?"
msgstr "Ki néz?"

msgctxt "#30042"
msgid "Add a user"
msgstr "Felhasználó hozzáadása"

msgctxt "#30043"
msgid "Remove a user"
msgstr "Felhasználó eltávolítása"

msgctxt "#30044"
msgid "Select user"
msgstr "Válasszon felhasználót"

msgctxt "#30045"
msgid "No active session on the server yet"
msgstr "Még nincs aktív munkamenet a kiszolgálón"

msgctxt "#30046"
msgid "Who's watching? (%s)"
msgstr "Ki néz? (%s)"

msgctxt "#30047"
msgid "Who's watching with %s?"
msgstr "Ki néz %s mellett?"

msgctxt "#30048"
msgid "Who can be added to the session"
msgstr "Ki adható hozzá a munkamenethez"

msgctxt "#30250"
msgid "Library"
msgstr "Médiatár"

msgctxt "#30251"
msgid "Select and manage the Jellyfin libraries mirrored into Kodi's own database."
msgstr "A Kodi saját adatbázisába tükrözött Jellyfin-médiatárak kiválasztása és kezelése."

msgctxt "#30252"
msgid "Select libraries to sync"
msgstr "Szinkronizálandó médiatárak kiválasztása"

msgctxt "#30253"
msgid "Choose which server libraries are mirrored into the Kodi library. Changes apply when you confirm the selection."
msgstr "Válassza ki, mely kiszolgálói médiatárak tükröződjenek a Kodi médiatárába. A módosítások a kiválasztás megerősítésekor lépnek életbe."

msgctxt "#30254"
msgid "Synced libraries"
msgstr "Szinkronizált médiatárak"

msgctxt "#30255"
msgid "The libraries currently mirrored into the Kodi database."
msgstr "A Kodi adatbázisába jelenleg tükrözött médiatárak."

msgctxt "#30256"
msgid "Update libraries"
msgstr "Médiatárak frissítése"

msgctxt "#30257"
msgid "Catch up with server changes and prune removed items from the libraries you pick. Runs when you confirm the selection."
msgstr "A kiválasztott médiatárak felzárkóztatása a kiszolgáló változásaihoz, az eltávolított elemek kiselejtezésével. A kiválasztás megerősítésekor fut le."

msgctxt "#30258"
msgid "Repair libraries"
msgstr "Médiatárak javítása"

msgctxt "#30259"
msgid "Remove and re-sync the libraries you pick from scratch, restoring watched state from the server. Runs when you confirm the selection."
msgstr "A kiválasztott médiatárak eltávolítása és újraszinkronizálása a nulláról, a megtekintettségi állapot visszaállításával a kiszolgálóról. A kiválasztás megerősítésekor fut le."

msgctxt "#30260"
msgid "Refresh boxsets"
msgstr "Gyűjtemények frissítése"

msgctxt "#30261"
msgid "Rebuild movie set links from the server's collections. Runs immediately."
msgstr "A filmgyűjtemény-hivatkozások újraépítése a kiszolgáló kollekciói alapján. Azonnal lefut."

msgctxt "#30262"
msgid "Sync status"
msgstr "Szinkronizálás állapota"

msgctxt "#30263"
msgid "Companion plugin tier and schema-gate state."
