msgctxt "#30250"
msgid "Library"
msgstr "Libreria"

msgctxt "#30251"
msgid "Select and manage the Jellyfin libraries mirrored into Kodi's own database."
msgstr "Seleziona e gestisci le librerie Jellyfin rispecchiate nel database di Kodi."

msgctxt "#30252"
msgid "Select libraries to sync"
msgstr "Seleziona le librerie da sincronizzare"

msgctxt "#30253"
msgid "Choose which server libraries are mirrored into the Kodi library. Changes apply when you confirm the selection."
msgstr "Scegli quali librerie del server vengono rispecchiate nella libreria di Kodi. Le modifiche vengono applicate quando confermi la selezione."

msgctxt "#30256"
msgid "Update libraries"
msgstr "Aggiorna le librerie"

msgctxt "#30258"
msgid "Repair libraries"
msgstr "Ripara le librerie"

msgctxt "#30259"
msgid "Remove and re-sync the libraries you pick from scratch, restoring watched state from the server. Runs when you confirm the selection."
msgstr "Rimuove e risincronizza da zero le librerie che scegli, ripristinando lo stato di visione dal server. Viene eseguito quando confermi la selezione."

msgctxt "#30262"
msgid "Sync status"
msgstr "Stato della sincronizzazione"

msgctxt "#30264"
msgid "Remove synced library?"
msgstr "Rimuovere la libreria sincronizzata?"

msgctxt "#30265"
msgid "Remove %s from the Kodi library? The items are deleted from this device only."
msgstr "Rimuovere %s dalla libreria di Kodi? Gli elementi vengono eliminati solo da questo dispositivo."

msgctxt "#30266"
msgid "Repair which libraries?"
msgstr "Quali librerie riparare?"

msgctxt "#30267"
msgid "All"
msgstr "Tutte"

msgctxt "#30268"
msgid "Select libraries"
msgstr "Seleziona le librerie"

msgctxt "#30269"
msgid "No libraries available"
msgstr "Nessuna libreria disponibile"

msgctxt "#30302"
msgid "Hide update status below (items)"
msgstr "Nascondi lo stato di aggiornamento sotto (elementi)"

msgctxt "#30303"
msgid "Hide Kodi's library-update progress for syncs smaller than this. 0 always shows it."
msgstr "Nasconde l'avanzamento dell'aggiornamento libreria di Kodi per le sincronizzazioni più piccole di questo valore. 0 lo mostra sempre."

msgctxt "#30318"
msgid "Compress artwork"
msgstr "Comprimi le immagini"

msgctxt "#30319"
msgid "Re-encode capped artwork at JPEG quality 90. No effect without a resolution cap."
msgstr "Ricodifica le immagini ridimensionate con qualità JPEG 90. Nessun effetto senza un limite di risoluzione."

msgctxt "#30320"
msgid "Maximum artwork resolution"
msgstr "Risoluzione massima delle immagini"

msgctxt "#30321"
msgid "Cap the height of synced artwork. Original keeps the server size."
msgstr "Limita l'altezza delle immagini sincronizzate. Originale mantiene la dimensione del server."

msgctxt "#30322"
msgid "Original"
msgstr "Originale"

msgctxt "#30323"
msgid "720p"
msgstr "720p"

msgctxt "#30324"
msgid "1080p"
msgstr "1080p"

msgctxt "#30325"
msgid "2160p"
msgstr "2160p"

msgctxt "#30326"
msgid "Notify on server connection changes"
msgstr "Notifica i cambi di connessione al server"

msgctxt "#30327"
msgid "Show a notification when the server connects, disconnects or restarts."
msgstr "Mostra una notifica quando il server si connette, si disconnette o si riavvia."

msgctxt "#30350"
msgid "Recently added"
msgstr "Aggiunti di recente"

msgctxt "#30351"
msgid "In progress"
msgstr "In corso"

msgctxt "#30352"
msgid "Unwatched"
msgstr "Non visti"

msgctxt "#30353"
msgid "Random"
msgstr "Casuali"

msgctxt "#30354"
msgid "Recommended"
msgstr "Consigliati"

msgctxt "#30355"
msgid "Recently added episodes"
msgstr "Episodi aggiunti di recente"

msgctxt "#30356"
msgid "In progress episodes"
msgstr "Episodi in corso"

msgctxt "#30358"
msgid "Favorite movies"
msgstr "Film preferiti"

msgctxt "#30359"
msgid "Favorite shows"
msgstr "Serie preferite"

msgctxt "#30360"
msgid "Favorite episodes"
msgstr "Episodi preferiti"

msgctxt "#30401"
msgid "Updating media"
msgstr "Aggiornamento dei media"

msgctxt "#30403"
msgid "Sync incomplete; retrying shortly"
msgstr "Sincronizzazione incompleta, riprovo"

msgctxt "#30408"
msgid "Removing library"
msgstr "Rimozione della libreria"

msgctxt "#30415"
msgid "Connected to %s"
msgstr "Connesso a %s"

msgctxt "#30416"
msgid "Lost connection to the server"
msgstr "Connessione al server persa"

msgctxt "#30417"
msgid "Server is restarting"
msgstr "Il server si sta riavviando"

msgctxt "#30418"
msgid "Server is shutting down"
msgstr "Il server si sta spegnendo"

msgctxt "#30420"
msgid "Library sync is off: %s"
msgstr "Sincronizzazione disattivata: %s"

msgctxt "#30450"
msgid "Skipping & Play next"
msgstr "Salta e riproduci il prossimo"

msgctxt "#30451"
msgid "Media segment skipping and the Play Next prompt."
msgstr "Salto dei segmenti multimediali e richiesta «Riproduci il prossimo»."

msgctxt "#30453"
msgid "Skip media segments"
msgstr "Salta i segmenti multimediali"

msgctxt "#30454"
msgid "Fetch Jellyfin media segments (intro, credits, recap, preview, commercial) during playback and act on them per type."
msgstr "Recupera i segmenti multimediali di Jellyfin (intro, titoli di coda, riepilogo, anteprima, pubblicità) durante la riproduzione e agisci in base al tipo."

msgctxt "#30455"
msgid "Intros"
msgstr "Intro"

msgctxt "#30456"
msgid "Off ignores intro segments, Auto skips past them, Ask shows a skip button."
msgstr "Off ignora i segmenti di intro, Auto li salta, Chiedi mostra un pulsante di salto."

msgctxt "#30457"
msgid "Credits"
msgstr "Titoli di coda"

msgctxt "#30458"
msgid "Off ignores credits, Auto seeks past them, Ask offers Skip Outro — with Play Next when a next episode exists."
msgstr "Off ignora i titoli di coda, Auto li supera, Chiedi propone «Salta i titoli» — con «Riproduci il prossimo» quando esiste un episodio successivo."

msgctxt "#30459"
msgid "Recaps"
