msgstr "in buffering"

msgctxt "#30578"
msgid "Could not join the group"
msgstr "Impossibile entrare nel gruppo"

msgctxt "#30579"
msgid "You don't have access to some items in the group's queue"
msgstr "Non hai accesso ad alcuni elementi nella coda del gruppo"

msgctxt "#30580"
msgid "Become a spectator (group won't wait for me)"
msgstr "Diventa spettatore (il gruppo non mi aspetta)"

msgctxt "#30581"
msgid "Wait for me again (leave spectator mode)"
msgstr "Aspettami di nuovo (esci dalla modalità spettatore)"

msgctxt "#30582"
