msgid "Settings"
msgstr "Impostazioni"

msgctxt "#30505"
msgid "Permanently delete \"%s\" from the server? This cannot be undone."
msgstr "Eliminare definitivamente \"%s\" dal server? L'operazione non può essere annullata."

msgctxt "#30506"
msgid "Finished \"%s\". Permanently delete it from the server? This cannot be undone."
msgstr "Hai finito \"%s\". Eliminarlo definitivamente dal server? L'operazione non può essere annullata."

msgctxt "#30507"
