msgid "Add a user"
msgstr "Aggiungi un utente"

msgctxt "#30043"
msgid "Remove a user"
msgstr "Rimuovi un utente"

msgctxt "#30044"
msgid "Select user"
msgstr "Seleziona l'utente"

msgctxt "#30045"
msgid "No active session on the server yet"
msgstr "Ancora nessuna sessione attiva sul server"

msgctxt "#30046"
msgid "Who's watching? (%s)"
msgstr "Chi sta guardando? (%s)"

msgctxt "#30047"
msgid "Who's watching with %s?"
msgstr "Chi sta guardando con %s?"

msgctxt "#30048"
msgid "Who can be added to the session"
msgstr "Chi può essere aggiunto alla sessione"

msgctxt "#30250"
msgid "Library"
msgstr "Libreria"

msgctxt "#30251"
msgid "Select and manage the Jellyfin libraries mirrored into Kodi's own database."
msgstr "Seleziona e gestisci le librerie Jellyfin rispecchiate nel database di Kodi."

msgctxt "#30252"
msgid "Select libraries to sync"
msgstr "Seleziona le librerie da sincronizzare"

msgctxt "#30253"
msgid "Choose which server libraries are mirrored into the Kodi library. Changes apply when you confirm the selection."
msgstr "Scegli quali librerie del server vengono rispecchiate nella libreria di Kodi. Le modifiche vengono applicate quando confermi la selezione."

msgctxt "#30254"
msgid "Synced libraries"
msgstr "Librerie sincronizzate"

msgctxt "#30255"
msgid "The libraries currently mirrored into the Kodi database."
msgstr "Le librerie attualmente rispecchiate nel database di Kodi."

msgctxt "#30256"
msgid "Update libraries"
msgstr "Aggiorna le librerie"

msgctxt "#30257"
msgid "Catch up with server changes and prune removed items from the libraries you pick. Runs when you confirm the selection."
msgstr "Recupera le modifiche dal server ed elimina gli elementi rimossi dalle librerie che scegli. Viene eseguito quando confermi la selezione."

msgctxt "#30258"
msgid "Repair libraries"
msgstr "Ripara le librerie"

msgctxt "#30259"
msgid "Remove and re-sync the libraries you pick from scratch, restoring watched state from the server. Runs when you confirm the selection."
msgstr "Rimuove e risincronizza da zero le librerie che scegli, ripristinando lo stato di visione dal server. Viene eseguito quando confermi la selezione."

msgctxt "#30260"
msgid "Refresh boxsets"
msgstr "Aggiorna le collezioni"

msgctxt "#30261"
msgid "Rebuild movie set links from the server's collections. Runs immediately."
msgstr "Ricostruisce i collegamenti alle collezioni di film a partire dalle raccolte del server. Viene eseguito subito."

msgctxt "#30262"
msgid "Sync status"
msgstr "Stato della sincronizzazione"

msgctxt "#30263"
msgid "Companion plugin tier and schema-gate state."
msgstr "Livello del plugin companion e stato del controllo di schema."

msgctxt "#30264"
msgid "Remove synced library?"
msgstr "Rimuovere la libreria sincronizzata?"

msgctxt "#30265"
msgid "Remove %s from the Kodi library? The items are deleted from this device only."
msgstr "Rimuovere %s dalla libreria di Kodi? Gli elementi vengono eliminati solo da questo dispositivo."

msgctxt "#30266"
msgid "Repair which libraries?"
msgstr "Quali librerie riparare?"

msgctxt "#30267"
msgid "All"
msgstr "Tutte"

msgctxt "#30268"
msgid "Select libraries"
msgstr "Seleziona le librerie"

msgctxt "#30269"
msgid "No libraries available"
msgstr "Nessuna libreria disponibile"

msgctxt "#30270"
msgid "Update which libraries?"
msgstr "Quali librerie aggiornare?"

msgctxt "#30300"
msgid "Sync"
msgstr "Sincronizzazione"

msgctxt "#30301"
msgid "How library changes are downloaded and written."
msgstr "Come vengono scaricate e scritte le modifiche alla libreria."

msgctxt "#30302"
msgid "Hide update status below (items)"
msgstr "Nascondi lo stato di aggiornamento sotto (elementi)"

msgctxt "#30303"
msgid "Hide Kodi's library-update progress for syncs smaller than this. 0 always shows it."
msgstr "Nasconde l'avanzamento dell'aggiornamento libreria di Kodi per le sincronizzazioni più piccole di questo valore. 0 lo mostra sempre."

msgctxt "#30306"
msgid "Sync during video playback"
msgstr "Sincronizza durante la riproduzione video"

msgctxt "#30307"
msgid "Keep applying library updates while a video is playing."
msgstr "Continua ad applicare gli aggiornamenti della libreria mentre un video è in riproduzione."

msgctxt "#30310"
msgid "Items per request"
msgstr "Elementi per richiesta"

msgctxt "#30311"
msgid "Page size for library downloads. Recommended: 50."
msgstr "Dimensione della pagina per i download della libreria. Consigliato: 50."

msgctxt "#30312"
msgid "Download threads"
msgstr "Thread di download"

msgctxt "#30313"
msgid "Parallel download connections during sync. Recommended: 3; raise only for a fast server."
msgstr "Connessioni di download parallele durante la sincronizzazione. Consigliato: 3; aumentalo solo con un server veloce."

msgctxt "#30314"
msgid "Artwork"
msgstr "Immagini"

msgctxt "#30318"
msgid "Compress artwork"
msgstr "Comprimi le immagini"

msgctxt "#30319"
msgid "Re-encode capped artwork at JPEG quality 90. No effect without a resolution cap."
msgstr "Ricodifica le immagini ridimensionate con qualità JPEG 90. Nessun effetto senza un limite di risoluzione."

msgctxt "#30320"
msgid "Maximum artwork resolution"
msgstr "Risoluzione massima delle immagini"

msgctxt "#30321"
msgid "Cap the height of synced artwork. Original keeps the server size."
msgstr "Limita l'altezza delle immagini sincronizzate. Originale mantiene la dimensione del server."

msgctxt "#30322"
msgid "Original"
msgstr "Originale"

msgctxt "#30323"
msgid "720p"
msgstr "720p"

msgctxt "#30324"
msgid "1080p"
msgstr "1080p"

msgctxt "#30325"
msgid "2160p"
msgstr "2160p"

msgctxt "#30326"
msgid "Notify on server connection changes"
msgstr "Notifica i cambi di connessione al server"

msgctxt "#30327"
msgid "Show a notification when the server connects, disconnects or restarts."
msgstr "Mostra una notifica quando il server si connette, si disconnette o si riavvia."

msgctxt "#30350"
