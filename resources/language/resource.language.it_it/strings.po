msgctxt "Addon Summary"
msgid "Jellyfin client for seamless Kodi integration"
msgstr "Client Jellyfin per un'integrazione perfetta con Kodi"

msgctxt "Addon Description"
msgid "Play movies, shows & music from a Jellyfin server."
msgstr "Riproduci film, serie e musica da un server Jellyfin."

msgctxt "#30010"
msgid "Play with transcoding"
msgstr "Riproduci con transcodifica"

msgctxt "#30011"
msgid "Quick Connect"
msgstr "Quick Connect"

msgctxt "#30012"
msgid "Username and password"
msgstr "Nome utente e password"

msgctxt "#30013"
msgid "Username"
msgstr "Nome utente"

msgctxt "#30014"
msgid "Password"
msgstr "Password"

msgctxt "#30015"
msgid "Enter code [B]%s[/B] in the Jellyfin app or web interface."
msgstr "Inserisci il codice [B]%s[/B] nell'app Jellyfin o nell'interfaccia web."

msgctxt "#30016"
msgid "Logged in as %s"
msgstr "Accesso effettuato come %s"

msgctxt "#30017"
msgid "Login failed: wrong username or password"
msgstr "Accesso non riuscito: nome utente o password errati"

msgctxt "#30018"
msgid "Server unreachable"
msgstr "Server irraggiungibile"

msgctxt "#30019"
msgid "Log out from %s?"
msgstr "Uscire da %s?"

msgctxt "#30020"
msgid "Logged out"
msgstr "Disconnesso"

msgctxt "#30021"
msgid "Connection OK — %s (%s)"
msgstr "Connessione OK — %s (%s)"

msgctxt "#30022"
msgid "Session rejected — log in again from the Account tab"
msgstr "Sessione rifiutata — accedi di nuovo dalla scheda Account"

msgctxt "#30023"
msgid "Restarting the Kofin service"
msgstr "Riavvio del servizio Kofin"

msgctxt "#30024"
msgid "Quick Connect timed out"
msgstr "Timeout di Quick Connect"

msgctxt "#30025"
msgid "Already logged in"
msgstr "Accesso già effettuato"

msgctxt "#30026"
msgid "Not logged in"
msgstr "Accesso non effettuato"

msgctxt "#30027"
msgid "Log in to %s"
msgstr "Accedi a %s"

msgctxt "#30050"
msgid "Account"
msgstr "Account"

msgctxt "#30051"
msgid "Connect to your Jellyfin server and manage the session."
msgstr "Connettiti al tuo server Jellyfin e gestisci la sessione."

msgctxt "#30052"
msgid "Server address"
msgstr "Indirizzo del server"

msgctxt "#30053"
msgid "Host name, IP address or full URL of the Jellyfin server. A bare host uses http on port 8096."
msgstr "Nome host, indirizzo IP o URL completo del server Jellyfin. Un host da solo usa http sulla porta 8096."

msgctxt "#30054"
msgid "Log in…"
msgstr "Accedi…"

msgctxt "#30055"
msgid "Connect to the server above using Quick Connect or a username and password."
msgstr "Connettiti al server indicato sopra con Quick Connect oppure con nome utente e password."

msgctxt "#30056"
msgid "Server"
msgstr "Server"

msgctxt "#30057"
msgid "The connected Jellyfin server."
msgstr "Il server Jellyfin connesso."

msgctxt "#30058"
msgid "Logged-in user"
msgstr "Utente connesso"

msgctxt "#30059"
msgid "The Jellyfin user this device plays and reports as."
msgstr "L'utente Jellyfin con cui questo dispositivo riproduce e riporta l'attività."

msgctxt "#30060"
msgid "Test connection"
msgstr "Prova la connessione"

msgctxt "#30061"
msgid "Check that the server is reachable and the session is still valid."
msgstr "Verifica che il server sia raggiungibile e che la sessione sia ancora valida."

msgctxt "#30062"
msgid "Log out"
msgstr "Esci"

msgctxt "#30063"
msgid "End the session on the server and forget it on this device. The server address is kept."
msgstr "Termina la sessione sul server e dimenticala su questo dispositivo. L'indirizzo del server viene mantenuto."

msgctxt "#30064"
msgid "Restart Kofin"
msgstr "Riavvia Kofin"

msgctxt "#30065"
msgid "Restart the background service without restarting Kodi."
msgstr "Riavvia il servizio in background senza riavviare Kodi."

msgctxt "#30066"
msgid "Verify SSL certificate"
msgstr "Verifica il certificato SSL"

msgctxt "#30067"
msgid "Disable only for servers with self-signed certificates."
msgstr "Disattivalo solo per server con certificati autofirmati."

msgctxt "#30071"
msgid "Advanced"
msgstr "Avanzate"

msgctxt "#30072"
msgid "SSL verification and other advanced options."
msgstr "Verifica SSL e altre opzioni avanzate."

msgctxt "#30073"
msgid "Enable Delete from server"
msgstr "Attiva «Elimina dal server»"

msgctxt "#30074"
msgid "Adds a Delete entry to an item's 'Jellyfin actions' context menu. Deletion is permanent: the file itself is removed on the Jellyfin server, for every user."
msgstr "Aggiunge una voce Elimina al menu contestuale «Azioni Jellyfin» di un elemento. L'eliminazione è definitiva: il file stesso viene rimosso dal server Jellyfin, per tutti gli utenti."

msgctxt "#30075"
msgid "Delete without confirmation"
msgstr "Elimina senza conferma"

msgctxt "#30076"
msgid "Delete the item as soon as the entry is picked, with no 'are you sure?' prompt. The deletion is still permanent and applies on the server."
msgstr "Elimina l'elemento non appena scegli la voce, senza chiedere «sei sicuro?». L'eliminazione resta comunque definitiva e vale sul server."

msgctxt "#30077"
msgid "Offer to delete after watching"
msgstr "Proponi l'eliminazione dopo la visione"

msgctxt "#30078"
msgid "When a movie or episode finishes, ask whether to delete it from the server. Always asks, whatever 'Delete without confirmation' is set to."
msgstr "Quando un film o un episodio finisce, chiede se eliminarlo dal server. Chiede sempre, qualunque sia l'impostazione di «Elimina senza conferma»."

msgctxt "#30079"
msgid "Who's watching shortlist"
msgstr "Elenco per «Chi sta guardando»"

msgctxt "#30080"
msgid "Choose which server users the addon's Who's watching? entry offers. \"All\" offers everyone. With nothing selected the entry is hidden and anyone already on the session is removed."
msgstr "Scegli quali utenti del server propone la voce «Chi sta guardando?» dell'add-on. \"Tutti\" li propone tutti. Se non selezioni nulla, la voce viene nascosta e chi è già nella sessione viene rimosso."

msgctxt "#30030"
msgid "All"
msgstr "Tutti"

msgctxt "#30031"
msgid "Recently added"
msgstr "Aggiunti di recente"

msgctxt "#30032"
msgid "Next up"
msgstr "Prossimi"

msgctxt "#30033"
msgid "In progress"
msgstr "In corso"

msgctxt "#30034"
msgid "Unwatched"
msgstr "Non visti"

msgctxt "#30035"
msgid "Favourites"
msgstr "Preferiti"

msgctxt "#30036"
msgid "Genres"
msgstr "Generi"

msgctxt "#30037"
msgid "Random"
msgstr "Casuali"

msgctxt "#30038"
msgid "Sets"
msgstr "Collezioni"

msgctxt "#30039"
msgid "Artists"
msgstr "Artisti"

msgctxt "#30040"
msgid "Albums"
msgstr "Album"

msgctxt "#30049"
msgid "Continue watching"
msgstr "Continua a guardare"

msgctxt "#30100"
msgid "Transcoding"
msgstr "Transcodifica"

msgctxt "#30101"
msgid "When and how the server converts media for this device."
msgstr "Quando e come il server converte i media per questo dispositivo."

msgctxt "#30102"
msgid "Force direct play"
msgstr "Forza la riproduzione diretta"

msgctxt "#30103"
msgid "Always play the original video file. Overrides every other video transcoding setting; playback fails if the device cannot handle the media. Music is unaffected — see 'Transcode music'."
msgstr "Riproduce sempre il file video originale. Ha la precedenza su ogni altra impostazione di transcodifica video; la riproduzione fallisce se il dispositivo non è in grado di gestire il media. La musica non è interessata — vedi «Transcodifica la musica»."

msgctxt "#30104"
msgid "Force remux"
msgstr "Forza il remux"

msgctxt "#30105"
msgid "Remux into HLS and copy the source codecs. Does not use Maximum audio channels, Maximum streaming bitrate or Transcode audio bitrate below — those would re-encode a listed codec. Direct play codecs, Allowed HDR types and Maximum resolution still apply."
msgstr "Esegue il remux in HLS e copia i codec sorgente. Non usa «Numero massimo di canali audio», «Bitrate massimo di streaming» o «Bitrate audio in transcodifica» più sotto: ricodificherebbero un codec in elenco. I codec di riproduzione diretta, «Tipi di HDR consentiti» e «Risoluzione massima» restano validi."

msgctxt "#30106"
msgid "Force transcode"
msgstr "Forza la transcodifica"

msgctxt "#30107"
msgid "Always re-encode video and audio to the preferred codecs. Honours the bitrate cap, the channel cap, allowed codecs, HDR types and resolution."
msgstr "Ricodifica sempre video e audio nei codec preferiti. Rispetta il limite di bitrate, il limite di canali, i codec consentiti, i tipi di HDR e la risoluzione."

msgctxt "#30108"
msgid "Direct play video codecs"
msgstr "Codec video per riproduzione diretta"

msgctxt "#30109"
msgid "Video formats this device can decode. Media using formats not selected here is transcoded."
msgstr "Formati video che questo dispositivo sa decodificare. I media che usano formati non selezionati qui vengono transcodificati."

msgctxt "#30110"
msgid "Direct play audio codecs"
msgstr "Codec audio per riproduzione diretta"

msgctxt "#30111"
msgid "Audio formats this device can decode or pass through. Others are transcoded."
msgstr "Formati audio che questo dispositivo sa decodificare o inoltrare in passthrough. Gli altri vengono transcodificati."

msgctxt "#30112"
msgid "Allowed HDR types"
msgstr "Tipi di HDR consentiti"

msgctxt "#30113"
msgid "HDR formats the display accepts. Media in formats not selected is tone-mapped or transcoded to SDR/HDR10 by the server."
msgstr "Formati HDR accettati dallo schermo. I media in formati non selezionati vengono convertiti dal server in SDR/HDR10 tramite tone mapping o transcodifica."

msgctxt "#30114"
msgid "Preferred video codec"
msgstr "Codec video preferito"

msgctxt "#30115"
msgid "The codec the client asks for when video must be transcoded."
msgstr "Il codec richiesto dal client quando il video deve essere transcodificato."

msgctxt "#30116"
msgid "Preferred audio codec"
msgstr "Codec audio preferito"

msgctxt "#30117"
msgid "The codec the client asks for when audio must be transcoded."
msgstr "Il codec richiesto dal client quando l'audio deve essere transcodificato."

msgctxt "#30118"
msgid "Maximum audio channels"
msgstr "Numero massimo di canali audio"

msgctxt "#30119"
msgid "Maximum number of audio channels allowed when transcoding. Streams with more channels will be downmixed. No effect on direct playback."
msgstr "Numero massimo di canali audio consentiti durante la transcodifica. I flussi con più canali verranno ridotti (downmix). Nessun effetto sulla riproduzione diretta."

msgctxt "#30120"
msgid "Maximum streaming bitrate"
msgstr "Bitrate massimo di streaming"

msgctxt "#30121"
msgid "Media above this bitrate is transcoded down to it."
msgstr "I media con bitrate superiore vengono transcodificati fino a questo valore."

msgctxt "#30122"
msgid "Maximum resolution"
msgstr "Risoluzione massima"

msgctxt "#30123"
msgid "Wider media is downscaled by the server."
msgstr "I media più larghi vengono ridimensionati dal server."

msgctxt "#30124"
msgid "Transcode audio bitrate"
msgstr "Bitrate audio in transcodifica"

msgctxt "#30125"
msgid "Bitrate for the audio track when video is transcoded."
msgstr "Bitrate della traccia audio quando il video viene transcodificato."

msgctxt "#30126"
msgid "Context menu bitrates"
msgstr "Bitrate del menu contestuale"

msgctxt "#30127"
msgid "Bitrates offered by 'Play with transcoding'. With one selected the popup is skipped."
msgstr "I bitrate proposti da «Riproduci con transcodifica». Con uno solo selezionato la finestra viene saltata."

msgctxt "#30129"
msgid "Maximum music bitrate"
msgstr "Bitrate massimo per la musica"

msgctxt "#30130"
msgid "Music above this bitrate is transcoded using the codec and bitrate below. Unlimited never transcodes."
msgstr "La musica con bitrate superiore viene transcodificata con il codec e il bitrate indicati sotto. Illimitato non transcodifica mai."

msgctxt "#30131"
msgid "Music transcode codec"
msgstr "Codec di transcodifica musicale"

msgctxt "#30132"
msgid "Codec for transcoded music streams."
msgstr "Codec per i flussi musicali transcodificati."

msgctxt "#30133"
msgid "Music transcode bitrate"
msgstr "Bitrate di transcodifica musicale"

msgctxt "#30134"
msgid "Bitrate for transcoded music streams."
msgstr "Bitrate per i flussi musicali transcodificati."

msgctxt "#30135"
msgid "Transcode music"
msgstr "Transcodifica la musica"

