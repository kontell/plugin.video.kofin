msgstr "Nuovo film: %s"

msgctxt "#30625"
msgid "%s movies added to library"
msgstr "%s film aggiunti alla libreria"

msgctxt "#30626"
msgid "%s show added to library"
msgstr "Nuova serie: %s"

msgctxt "#30627"
msgid "%s new shows added to library"
msgstr "%s nuove serie in libreria"

