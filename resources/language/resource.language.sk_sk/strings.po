msgstr "Reagovať na segmenty médií"

msgctxt "#30454"
msgid "Fetch Jellyfin media segments (intro, credits, recap, preview, commercial) during playback and act on them per type."
msgstr "Počas prehrávania načíta segmenty médií z Jellyfinu (úvod, záverečné titulky, zhrnutie, ukážka, reklama) a podľa typu na ne zareaguje."

msgctxt "#30455"
msgid "Intros"
msgstr "Úvody"

msgctxt "#30456"
msgid "Off ignores intro segments, Auto skips past them, Ask shows a skip button."
msgstr "Vypnuté ignoruje segmenty úvodu, Automaticky ich preskočí, Opýtať sa zobrazí tlačidlo na preskočenie."

msgctxt "#30457"
msgid "Credits"
msgstr "Záverečné titulky"

msgctxt "#30458"
msgid "Off ignores credits, Auto seeks past them, Ask offers Skip Outro — with Play Next when a next episode exists."
msgstr "Vypnuté ignoruje záverečné titulky, Automaticky ich preskočí, Opýtať sa ponúkne Preskočiť koniec — a Prehrať ďalšie, keď existuje ďalšia epizóda."

msgctxt "#30459"
msgid "Recaps"
msgstr "Zhrnutia"

msgctxt "#30460"
msgid "Off ignores recap segments, Auto skips past them, Ask shows a skip button."
msgstr "Vypnuté ignoruje segmenty zhrnutia, Automaticky ich preskočí, Opýtať sa zobrazí tlačidlo na preskočenie."

msgctxt "#30461"
msgid "Previews"
msgstr "Ukážky"

msgctxt "#30462"
msgid "Off ignores preview segments, Auto skips past them, Ask shows a skip button."
msgstr "Vypnuté ignoruje segmenty ukážok, Automaticky ich preskočí, Opýtať sa zobrazí tlačidlo na preskočenie."

msgctxt "#30463"
msgid "Commercials"
msgstr "Reklamy"

msgctxt "#30464"
msgid "Off ignores commercial segments, Auto skips past them, Ask shows a skip button."
msgstr "Vypnuté ignoruje reklamné segmenty, Automaticky ich preskočí, Opýtať sa zobrazí tlačidlo na preskočenie."

