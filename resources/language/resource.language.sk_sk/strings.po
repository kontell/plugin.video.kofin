msgctxt "#30041"
msgid "Who's watching?"
msgstr "Kto pozerá?"

msgctxt "#30042"
msgid "Add a user"
msgstr "Pridať používateľa"

msgctxt "#30043"
msgid "Remove a user"
msgstr "Odobrať používateľa"

msgctxt "#30044"
msgid "Select user"
msgstr "Vyberte používateľa"

msgctxt "#30045"
msgid "No active session on the server yet"
msgstr "Na serveri zatiaľ nie je aktívna relácia"

msgctxt "#30046"
msgid "Who's watching? (%s)"
msgstr "Kto pozerá? (%s)"

msgctxt "#30047"
msgid "Who's watching with %s?"
msgstr "Kto pozerá spolu s %s?"

msgctxt "#30048"
msgid "Who can be added to the session"
msgstr "Kto sa dá pridať do relácie"

msgctxt "#30250"
msgid "Library"
msgstr "Knižnica"

msgctxt "#30251"
msgid "Select and manage the Jellyfin libraries mirrored into Kodi's own database."
msgstr "Vyberte a spravujte knižnice Jellyfin zrkadlené do vlastnej databázy Kodi."

msgctxt "#30252"
msgid "Select libraries to sync"
msgstr "Vyberte knižnice na synchronizáciu"

msgctxt "#30253"
msgid "Choose which server libraries are mirrored into the Kodi library. Changes apply when you confirm the selection."
msgstr "Vyberte, ktoré serverové knižnice sa zrkadlia do knižnice Kodi. Zmeny sa použijú po potvrdení výberu."

msgctxt "#30254"
msgid "Synced libraries"
msgstr "Synchronizované knižnice"

msgctxt "#30255"
msgid "The libraries currently mirrored into the Kodi database."
msgstr "Knižnice momentálne zrkadlené do databázy Kodi."

msgctxt "#30256"
msgid "Update libraries"
msgstr "Aktualizovať knižnice"

msgctxt "#30257"
msgid "Catch up with server changes and prune removed items from the libraries you pick. Runs when you confirm the selection."
msgstr "Doplní zmeny zo servera a odstráni zmazané položky z knižníc, ktoré vyberiete. Spustí sa po potvrdení výberu."

msgctxt "#30258"
msgid "Repair libraries"
msgstr "Opraviť knižnice"

msgctxt "#30259"
msgid "Remove and re-sync the libraries you pick from scratch, restoring watched state from the server. Runs when you confirm the selection."
msgstr "Odstráni a nanovo synchronizuje knižnice, ktoré vyberiete, a obnoví stav zhliadnutia zo servera. Spustí sa po potvrdení výberu."

msgctxt "#30260"
msgid "Refresh boxsets"
msgstr "Obnoviť kolekcie"

msgctxt "#30261"
msgid "Rebuild movie set links from the server's collections. Runs immediately."
msgstr "Znova zostaví prepojenia filmových kolekcií zo zbierok na serveri. Spustí sa ihneď."

msgctxt "#30262"
msgid "Sync status"
msgstr "Stav synchronizácie"

msgctxt "#30263"
msgid "Companion plugin tier and schema-gate state."
msgstr "Úroveň sprievodného doplnku a stav kontroly schémy databázy."

msgctxt "#30264"
msgid "Remove synced library?"
msgstr "Odstrániť synchronizovanú knižnicu?"

msgctxt "#30265"
msgid "Remove %s from the Kodi library? The items are deleted from this device only."
msgstr "Odstrániť %s z knižnice Kodi? Položky sa zmažú len z tohto zariadenia."

msgctxt "#30266"
msgid "Repair which libraries?"
msgstr "Ktoré knižnice opraviť?"

msgctxt "#30267"
msgid "All"
msgstr "Všetky"

msgctxt "#30268"
msgid "Select libraries"
msgstr "Vybrať knižnice"

msgctxt "#30269"
msgid "No libraries available"
msgstr "Nie sú dostupné žiadne knižnice"

msgctxt "#30270"
msgid "Update which libraries?"
msgstr "Ktoré knižnice aktualizovať?"

msgctxt "#30300"
msgid "Sync"
msgstr "Synchronizácia"

msgctxt "#30301"
msgid "How library changes are downloaded and written."
msgstr "Ako sa zmeny v knižnici sťahujú a zapisujú."

msgctxt "#30302"
msgid "Hide update status below (items)"
msgstr "Skryť stav aktualizácie pod (položiek)"

msgctxt "#30303"
msgid "Hide Kodi's library-update progress for syncs smaller than this. 0 always shows it."
msgstr "Skryje priebeh aktualizácie knižnice v Kodi pri synchronizáciách menších ako toto. 0 ho zobrazí vždy."

msgctxt "#30306"
msgid "Sync during video playback"
msgstr "Synchronizovať počas prehrávania videa"

msgctxt "#30307"
msgid "Keep applying library updates while a video is playing."
