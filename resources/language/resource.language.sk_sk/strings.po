msgctxt "#30612"
msgid "Download Jellyfin music playlists into Kodi as native playlists under Music → Playlists → Kofin."
msgstr "Stiahne hudobné zoznamy skladieb z Jellyfinu do Kodi ako natívne zoznamy skladieb v Hudba → Zoznamy skladieb → Kofin."

