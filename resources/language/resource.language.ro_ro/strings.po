msgctxt "#30042"
msgid "Add a user"
msgstr "Adaugă un utilizator"

msgctxt "#30043"
msgid "Remove a user"
msgstr "Elimină un utilizator"

msgctxt "#30044"
msgid "Select user"
msgstr "Selectați utilizatorul"

msgctxt "#30045"
msgid "No active session on the server yet"
msgstr "Încă nu există nicio sesiune activă pe server"

msgctxt "#30046"
msgid "Who's watching? (%s)"
msgstr "Cine se uită? (%s)"

msgctxt "#30047"
msgid "Who's watching with %s?"
msgstr "Cine se uită împreună cu %s?"

msgctxt "#30048"
msgid "Who can be added to the session"
msgstr "Cine poate fi adăugat la sesiune"

msgctxt "#30250"
msgid "Library"
msgstr "Bibliotecă"

msgctxt "#30251"
msgid "Select and manage the Jellyfin libraries mirrored into Kodi's own database."
msgstr "Selectați și gestionați bibliotecile Jellyfin oglindite în baza de date proprie a Kodi."

msgctxt "#30252"
msgid "Select libraries to sync"
msgstr "Selectați bibliotecile de sincronizat"

msgctxt "#30253"
msgid "Choose which server libraries are mirrored into the Kodi library. Changes apply when you confirm the selection."
msgstr "Alegeți ce biblioteci ale serverului sunt oglindite în biblioteca Kodi. Modificările se aplică la confirmarea selecției."

msgctxt "#30254"
msgid "Synced libraries"
msgstr "Biblioteci sincronizate"

msgctxt "#30255"
msgid "The libraries currently mirrored into the Kodi database."
msgstr "Bibliotecile oglindite în prezent în baza de date Kodi."

msgctxt "#30256"
msgid "Update libraries"
msgstr "Actualizează bibliotecile"

msgctxt "#30257"
msgid "Catch up with server changes and prune removed items from the libraries you pick. Runs when you confirm the selection."
msgstr "Recuperează modificările de pe server și elimină elementele șterse din bibliotecile alese. Rulează la confirmarea selecției."

msgctxt "#30258"
msgid "Repair libraries"
msgstr "Repară bibliotecile"

msgctxt "#30259"
msgid "Remove and re-sync the libraries you pick from scratch, restoring watched state from the server. Runs when you confirm the selection."
msgstr "Elimină și resincronizează de la zero bibliotecile alese, restaurând starea de vizionare de pe server. Rulează la confirmarea selecției."

msgctxt "#30260"
msgid "Refresh boxsets"
msgstr "Reîmprospătează seturile de filme"

msgctxt "#30261"
msgid "Rebuild movie set links from the server's collections. Runs immediately."
msgstr "Reconstruiește legăturile seturilor de filme din colecțiile serverului. Rulează imediat."

msgctxt "#30262"
msgid "Sync status"
msgstr "Stare sincronizare"

msgctxt "#30263"
msgid "Companion plugin tier and schema-gate state."
msgstr "Nivelul suplimentului companion și starea porții de schemă."

msgctxt "#30264"
msgid "Remove synced library?"
msgstr "Eliminați biblioteca sincronizată?"

msgctxt "#30265"
msgid "Remove %s from the Kodi library? The items are deleted from this device only."
msgstr "Eliminați %s din biblioteca Kodi? Elementele sunt șterse doar de pe acest dispozitiv."

msgctxt "#30266"
msgid "Repair which libraries?"
msgstr "Ce biblioteci se repară?"

msgctxt "#30267"
msgid "All"
msgstr "Toate"

msgctxt "#30268"
msgid "Select libraries"
msgstr "Selectați bibliotecile"

msgctxt "#30269"
msgid "No libraries available"
msgstr "Nicio bibliotecă disponibilă"

msgctxt "#30270"
msgid "Update which libraries?"
msgstr "Ce biblioteci se actualizează?"

msgctxt "#30300"
msgid "Sync"
msgstr "Sincronizare"

msgctxt "#30301"
msgid "How library changes are downloaded and written."
msgstr "Cum sunt descărcate și scrise modificările bibliotecii."

msgctxt "#30302"
msgid "Hide update status below (items)"
msgstr "Ascunde starea actualizării sub (elemente)"

msgctxt "#30303"
msgid "Hide Kodi's library-update progress for syncs smaller than this. 0 always shows it."
msgstr "Ascunde progresul actualizării bibliotecii Kodi pentru sincronizări mai mici de atât. 0 îl afișează întotdeauna."

msgctxt "#30306"
msgid "Sync during video playback"
msgstr "Sincronizează în timpul redării video"

msgctxt "#30307"
msgid "Keep applying library updates while a video is playing."
msgstr "Continuă aplicarea actualizărilor bibliotecii în timp ce se redă un fișier video."

msgctxt "#30310"
msgid "Items per request"
msgstr "Elemente per cerere"

msgctxt "#30311"
msgid "Page size for library downloads. Recommended: 50."
msgstr "Dimensiunea paginii pentru descărcările bibliotecii. Recomandat: 50."

msgctxt "#30312"
msgid "Download threads"
msgstr "Fire de descărcare"

msgctxt "#30313"
msgid "Parallel download connections during sync. Recommended: 3; raise only for a fast server."
msgstr "Conexiuni de descărcare paralele în timpul sincronizării. Recomandat: 3; măriți doar pentru un server rapid."

msgctxt "#30314"
msgid "Artwork"
msgstr "Grafică"

msgctxt "#30318"
msgid "Compress artwork"
msgstr "Comprimă grafica"

msgctxt "#30319"
msgid "Re-encode capped artwork at JPEG quality 90. No effect without a resolution cap."
msgstr "Recodează grafica limitată la calitatea JPEG 90. Niciun efect fără o limită de rezoluție."

msgctxt "#30320"
msgid "Maximum artwork resolution"
