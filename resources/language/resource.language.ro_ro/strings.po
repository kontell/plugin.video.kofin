msgctxt "Addon Summary"
msgid "Jellyfin client for seamless Kodi integration"
msgstr "Client Jellyfin pentru o integrare perfectă în Kodi"

msgctxt "Addon Description"
msgid "Play movies, shows & music from a Jellyfin server."
msgstr "Redați filme, seriale și muzică de pe un server Jellyfin."

msgctxt "#30010"
msgid "Play with transcoding"
msgstr "Redă cu transcodare"

msgctxt "#30011"
msgid "Quick Connect"
msgstr "Quick Connect"

msgctxt "#30012"
msgid "Username and password"
msgstr "Nume de utilizator și parolă"

msgctxt "#30013"
msgid "Username"
msgstr "Nume de utilizator"

msgctxt "#30014"
msgid "Password"
msgstr "Parolă"

msgctxt "#30015"
msgid "Enter code [B]%s[/B] in the Jellyfin app or web interface."
msgstr "Introduceți codul [B]%s[/B] în aplicația Jellyfin sau în interfața web."

msgctxt "#30016"
msgid "Logged in as %s"
msgstr "Autentificat ca %s"

msgctxt "#30017"
msgid "Login failed: wrong username or password"
msgstr "Autentificare eșuată: nume de utilizator sau parolă greșite"

msgctxt "#30018"
msgid "Server unreachable"
msgstr "Server inaccesibil"

msgctxt "#30019"
msgid "Log out from %s?"
msgstr "Vă deconectați de la %s?"

msgctxt "#30020"
msgid "Logged out"
msgstr "Deconectat"

msgctxt "#30021"
msgid "Connection OK — %s (%s)"
msgstr "Conexiune OK — %s (%s)"

msgctxt "#30022"
msgid "Session rejected — log in again from the Account tab"
msgstr "Sesiune respinsă — autentificați-vă din nou din fila Cont"

msgctxt "#30023"
msgid "Restarting the Kofin service"
msgstr "Se repornește serviciul Kofin"

msgctxt "#30024"
msgid "Quick Connect timed out"
msgstr "Quick Connect a expirat"

msgctxt "#30025"
msgid "Already logged in"
msgstr "Sunteți deja autentificat"

msgctxt "#30026"
msgid "Not logged in"
msgstr "Nu sunteți autentificat"

msgctxt "#30027"
msgid "Log in to %s"
msgstr "Autentificare la %s"

msgctxt "#30050"
msgid "Account"
msgstr "Cont"

msgctxt "#30051"
msgid "Connect to your Jellyfin server and manage the session."
msgstr "Conectați-vă la serverul Jellyfin și gestionați sesiunea."

msgctxt "#30052"
msgid "Server address"
msgstr "Adresa serverului"

msgctxt "#30053"
msgid "Host name, IP address or full URL of the Jellyfin server. A bare host uses http on port 8096."
msgstr "Numele de gazdă, adresa IP sau URL-ul complet al serverului Jellyfin. O gazdă simplă folosește http pe portul 8096."

msgctxt "#30054"
msgid "Log in…"
msgstr "Autentificare…"

msgctxt "#30055"
msgid "Connect to the server above using Quick Connect or a username and password."
msgstr "Conectați-vă la serverul de mai sus folosind Quick Connect sau un nume de utilizator și o parolă."

msgctxt "#30056"
msgid "Server"
msgstr "Server"

msgctxt "#30057"
msgid "The connected Jellyfin server."
msgstr "Serverul Jellyfin conectat."

msgctxt "#30058"
msgid "Logged-in user"
msgstr "Utilizator autentificat"

msgctxt "#30059"
msgid "The Jellyfin user this device plays and reports as."
msgstr "Utilizatorul Jellyfin sub care acest dispozitiv redă și raportează."

msgctxt "#30060"
msgid "Test connection"
msgstr "Testează conexiunea"

msgctxt "#30061"
msgid "Check that the server is reachable and the session is still valid."
msgstr "Verifică dacă serverul este accesibil și dacă sesiunea este încă validă."

msgctxt "#30062"
msgid "Log out"
msgstr "Deconectare"

msgctxt "#30063"
msgid "End the session on the server and forget it on this device. The server address is kept."
msgstr "Încheie sesiunea pe server și o uită pe acest dispozitiv. Adresa serverului este păstrată."

msgctxt "#30064"
msgid "Restart Kofin"
msgstr "Repornește Kofin"

msgctxt "#30065"
msgid "Restart the background service without restarting Kodi."
msgstr "Repornește serviciul din fundal fără a reporni Kodi."

msgctxt "#30066"
msgid "Verify SSL certificate"
msgstr "Verifică certificatul SSL"

msgctxt "#30067"
msgid "Disable only for servers with self-signed certificates."
msgstr "Dezactivați doar pentru servere cu certificate autosemnate."

msgctxt "#30068"
msgid "Device name"
msgstr "Numele dispozitivului"

msgctxt "#30069"
msgid "How this device appears in the Jellyfin dashboard and cast menus."
msgstr "Cum apare acest dispozitiv în panoul Jellyfin și în meniurile de difuzare."

msgctxt "#30070"
msgid "Connection"
msgstr "Conexiune"

msgctxt "#30071"
msgid "Advanced"
msgstr "Avansat"

msgctxt "#30072"
msgid "SSL verification and other advanced options."
msgstr "Verificarea SSL și alte opțiuni avansate."

msgctxt "#30073"
msgid "Enable Delete from server"
msgstr "Activează Șterge de pe server"

msgctxt "#30074"
msgid "Adds a Delete entry to an item's 'Jellyfin actions' context menu. Deletion is permanent: the file itself is removed on the Jellyfin server, for every user."
msgstr "Adaugă o intrare Șterge în meniul contextual „Acțiuni Jellyfin” al unui element. Ștergerea este definitivă: fișierul este eliminat de pe serverul Jellyfin, pentru toți utilizatorii."

msgctxt "#30075"
msgid "Delete without confirmation"
msgstr "Șterge fără confirmare"

msgctxt "#30076"
msgid "Delete the item as soon as the entry is picked, with no 'are you sure?' prompt. The deletion is still permanent and applies on the server."
msgstr "Șterge elementul imediat ce intrarea este aleasă, fără întrebarea „sigur?”. Ștergerea rămâne definitivă și se aplică pe server."

msgctxt "#30077"
msgid "Offer to delete after watching"
msgstr "Propune ștergerea după vizionare"

msgctxt "#30078"
msgid "When a movie or episode finishes, ask whether to delete it from the server. Always asks, whatever 'Delete without confirmation' is set to."
msgstr "Când un film sau un episod se termină, întreabă dacă să fie șters de pe server. Întreabă întotdeauna, indiferent de setarea „Șterge fără confirmare”."

msgctxt "#30079"
msgid "Who's watching shortlist"
msgstr "Listă scurtă pentru Cine se uită?"

msgctxt "#30080"
msgid "Choose which server users the addon's Who's watching? entry offers. \"All\" offers everyone. With nothing selected the entry is hidden and anyone already on the session is removed."
msgstr "Alegeți ce utilizatori ai serverului sunt oferiți de intrarea Cine se uită? a suplimentului. \"Toți\" îi oferă pe toți. Fără nicio selecție, intrarea este ascunsă și oricine se află deja în sesiune este eliminat."

msgctxt "#30030"
msgid "All"
msgstr "Toate"

msgctxt "#30031"
msgid "Recently added"
msgstr "Adăugate recent"

msgctxt "#30032"
msgid "Next up"
msgstr "Urmează"

msgctxt "#30033"
msgid "In progress"
msgstr "În curs"

msgctxt "#30034"
msgid "Unwatched"
msgstr "Nevizionate"

msgctxt "#30035"
msgid "Favourites"
msgstr "Favorite"

msgctxt "#30036"
msgid "Genres"
msgstr "Genuri"

msgctxt "#30037"
msgid "Random"
msgstr "Aleatoriu"

msgctxt "#30038"
msgid "Sets"
msgstr "Seturi"

msgctxt "#30039"
msgid "Artists"
msgstr "Artiști"

msgctxt "#30040"
msgid "Albums"
msgstr "Albume"

msgctxt "#30049"
msgid "Continue watching"
msgstr "Continuă vizionarea"

msgctxt "#30100"
msgid "Transcoding"
msgstr "Transcodare"

msgctxt "#30101"
msgid "When and how the server converts media for this device."
msgstr "Când și cum convertește serverul fișierele media pentru acest dispozitiv."

msgctxt "#30102"
msgid "Force direct play"
msgstr "Forțează redarea directă"

msgctxt "#30103"
msgid "Always play the original video file. Overrides every other video transcoding setting; playback fails if the device cannot handle the media. Music is unaffected — see 'Transcode music'."
msgstr "Redă întotdeauna fișierul video original. Are prioritate față de orice altă setare de transcodare video; redarea eșuează dacă dispozitivul nu poate gestiona fișierul. Muzica nu este afectată — vedeți „Transcodează muzica”."

msgctxt "#30104"
msgid "Force remux"
msgstr "Forțează remultiplexarea"

msgctxt "#30105"
msgid "Repackage the stream without re-encoding video. Use when the container causes problems but the codecs are fine."
msgstr "Reîmpachetează fluxul fără a recoda video. Folosiți când containerul creează probleme, dar codecurile sunt în regulă."

msgctxt "#30106"
msgid "Force transcode"
msgstr "Forțează transcodarea"

msgctxt "#30107"
msgid "Always re-encode on the server. Highest server load; use for troubleshooting or very constrained clients."
msgstr "Recodează întotdeauna pe server. Cea mai mare încărcare a serverului; folosiți pentru depanare sau pentru clienți foarte limitați."

msgctxt "#30108"
msgid "Direct play video codecs"
msgstr "Codecuri video pentru redare directă"

msgctxt "#30109"
msgid "Video formats this device can decode. Media using formats not selected here is transcoded."
msgstr "Formatele video pe care acest dispozitiv le poate decoda. Fișierele în formate neselectate aici sunt transcodate."

msgctxt "#30110"
msgid "Direct play audio codecs"
msgstr "Codecuri audio pentru redare directă"

msgctxt "#30111"
msgid "Audio formats this device can decode or pass through. Others are transcoded."
msgstr "Formatele audio pe care acest dispozitiv le poate decoda sau transmite mai departe. Restul sunt transcodate."

msgctxt "#30112"
msgid "Allowed HDR types"
msgstr "Tipuri HDR permise"

msgctxt "#30113"
msgid "HDR formats the display accepts. Media in formats not selected is tone-mapped or transcoded to SDR/HDR10 by the server."
msgstr "Formatele HDR acceptate de afișaj. Fișierele în formate neselectate sunt mapate tonal sau transcodate la SDR/HDR10 de către server."

msgctxt "#30114"
msgid "Preferred video codec"
msgstr "Codec video preferat"

msgctxt "#30115"
msgid "The codec the server targets when it must transcode video."
msgstr "Codecul pe care serverul îl vizează când trebuie să transcodeze video."

msgctxt "#30116"
msgid "Preferred audio codec"
msgstr "Codec audio preferat"

msgctxt "#30117"
msgid "The codec the server targets when it must transcode audio."
msgstr "Codecul pe care serverul îl vizează când trebuie să transcodeze audio."

msgctxt "#30118"
msgid "Maximum audio channels"
msgstr "Număr maxim de canale audio"

msgctxt "#30119"
msgid "Maximum number of audio channels allowed when transcoding. Streams with more channels will be downmixed. No effect on direct playback."
msgstr "Numărul maxim de canale audio permise la transcodare. Fluxurile cu mai multe canale vor fi reduse (downmix). Niciun efect asupra redării directe."

msgctxt "#30120"
msgid "Maximum streaming bitrate"
msgstr "Rată de biți maximă pentru streaming"

msgctxt "#30121"
msgid "Media above this bitrate is transcoded down to it. Unlimited suits LAN playback."
msgstr "Fișierele peste această rată de biți sunt transcodate până la ea. Nelimitat este potrivit pentru redarea în rețeaua locală."

msgctxt "#30122"
msgid "Maximum resolution"
msgstr "Rezoluție maximă"

msgctxt "#30123"
msgid "Wider media is downscaled by the server."
msgstr "Fișierele mai late sunt reduse ca scală de către server."

msgctxt "#30124"
msgid "Transcode audio bitrate"
msgstr "Rată de biți audio la transcodare"

msgctxt "#30125"
msgid "Bitrate for the audio track when video is transcoded."
msgstr "Rata de biți a pistei audio când video este transcodat."

msgctxt "#30126"
msgid "Context menu bitrates"
msgstr "Rate de biți în meniul contextual"

msgctxt "#30127"
msgid "Bitrates offered by 'Play with transcoding'. With exactly one selected the popup is skipped."
msgstr "Ratele de biți oferite de „Redă cu transcodare”. Cu exact una selectată, fereastra este omisă."

msgctxt "#30128"
msgid "Music"
msgstr "Muzică"

msgctxt "#30129"
msgid "Maximum music bitrate"
msgstr "Rată de biți maximă pentru muzică"

msgctxt "#30130"
msgid "Music above this bitrate is transcoded using the codec and bitrate below. Unlimited never transcodes."
msgstr "Muzica peste această rată de biți este transcodată cu codecul și rata de biți de mai jos. Nelimitat nu transcodează niciodată."

msgctxt "#30131"
msgid "Music transcode codec"
msgstr "Codec de transcodare pentru muzică"

msgctxt "#30132"
msgid "Codec for transcoded music streams."
msgstr "Codecul pentru fluxurile de muzică transcodate."

msgctxt "#30133"
msgid "Music transcode bitrate"
msgstr "Rată de biți de transcodare pentru muzică"

msgctxt "#30134"
msgid "Bitrate for transcoded music streams."
msgstr "Rata de biți pentru fluxurile de muzică transcodate."

msgctxt "#30135"
msgid "Transcode music"
msgstr "Transcodează muzica"

msgctxt "#30136"
msgid "Route music playback through the add-on so the settings below apply. Off, songs stream straight from the server untouched. Changing this needs a library repair of your music libraries to rewrite their paths."
msgstr "Direcționează redarea muzicii prin supliment, astfel încât setările de mai jos să se aplice. Dezactivat, piesele sunt transmise direct de pe server, neatinse. Schimbarea acestei setări necesită o reparare a bibliotecilor dvs. de muzică pentru a le rescrie căile."

