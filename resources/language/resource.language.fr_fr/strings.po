msgctxt "#30042"
msgid "Add a user"
msgstr "Ajouter un utilisateur"

msgctxt "#30043"
msgid "Remove a user"
msgstr "Retirer un utilisateur"

msgctxt "#30044"
msgid "Select user"
msgstr "Sélectionner un utilisateur"

msgctxt "#30045"
msgid "No active session on the server yet"
msgstr "Aucune session active sur le serveur pour l'instant"

msgctxt "#30046"
