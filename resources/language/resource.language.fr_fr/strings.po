msgstr "Qui regarde ? (%s)"

msgctxt "#30047"
msgid "Who's watching with %s?"
msgstr "Qui regarde avec %s ?"

msgctxt "#30048"
msgid "Who can be added to the session"
msgstr "Qui peut être ajouté à la session"

msgctxt "#30250"
msgid "Library"
msgstr "Bibliothèque"

msgctxt "#30251"
msgid "Select and manage the Jellyfin libraries mirrored into Kodi's own database."
msgstr "Sélectionnez et gérez les bibliothèques Jellyfin répliquées dans la base de données de Kodi."

msgctxt "#30252"
msgid "Select libraries to sync"
msgstr "Sélectionner les bibliothèques à synchroniser"

msgctxt "#30253"
msgid "Choose which server libraries are mirrored into the Kodi library. Changes apply when you confirm the selection."
msgstr "Choisissez quelles bibliothèques du serveur sont répliquées dans la bibliothèque Kodi. Les modifications s'appliquent à la validation de la sélection."

msgctxt "#30254"
msgid "Synced libraries"
msgstr "Bibliothèques synchronisées"

msgctxt "#30255"
msgid "The libraries currently mirrored into the Kodi database."
msgstr "Les bibliothèques actuellement répliquées dans la base de données Kodi."

msgctxt "#30256"
msgid "Update libraries"
msgstr "Mettre à jour les bibliothèques"

msgctxt "#30257"
msgid "Catch up with server changes and prune removed items from the libraries you pick. Runs when you confirm the selection."
msgstr "Récupère les changements du serveur et élimine les éléments supprimés des bibliothèques que vous choisissez. S'exécute à la validation de la sélection."

msgctxt "#30258"
msgid "Repair libraries"
msgstr "Réparer les bibliothèques"

msgctxt "#30259"
msgid "Remove and re-sync the libraries you pick from scratch, restoring watched state from the server. Runs when you confirm the selection."
msgstr "Supprime et resynchronise de zéro les bibliothèques que vous choisissez, en restaurant l'état de visionnage depuis le serveur. S'exécute à la validation de la sélection."

msgctxt "#30260"
msgid "Refresh boxsets"
msgstr "Actualiser les sagas"

msgctxt "#30261"
msgid "Rebuild movie set links from the server's collections. Runs immediately."
msgstr "Reconstruit les liens des sagas de films à partir des collections du serveur. S'exécute immédiatement."

msgctxt "#30262"
msgid "Sync status"
msgstr "État de la synchronisation"

msgctxt "#30263"
msgid "Companion plugin tier and schema-gate state."
msgstr "Niveau du plugin compagnon et état du contrôle de schéma."

msgctxt "#30264"
msgid "Remove synced library?"
msgstr "Retirer la bibliothèque synchronisée ?"

msgctxt "#30265"
msgid "Remove %s from the Kodi library? The items are deleted from this device only."
msgstr "Retirer %s de la bibliothèque Kodi ? Les éléments ne sont supprimés que sur cet appareil."

msgctxt "#30266"
msgid "Repair which libraries?"
msgstr "Quelles bibliothèques réparer ?"

msgctxt "#30267"
msgid "All"
msgstr "Toutes"

msgctxt "#30268"
msgid "Select libraries"
msgstr "Sélectionner les bibliothèques"

msgctxt "#30269"
msgid "No libraries available"
msgstr "Aucune bibliothèque disponible"

msgctxt "#30270"
msgid "Update which libraries?"
msgstr "Quelles bibliothèques mettre à jour ?"

msgctxt "#30300"
msgid "Sync"
msgstr "Synchronisation"

msgctxt "#30301"
msgid "How library changes are downloaded and written."
msgstr "Comment les modifications de bibliothèque sont téléchargées et écrites."

msgctxt "#30302"
msgid "Hide update status below (items)"
msgstr "Masquer l'état de mise à jour en dessous de (éléments)"

msgctxt "#30303"
msgid "Hide Kodi's library-update progress for syncs smaller than this. 0 always shows it."
msgstr "Masque la progression de la mise à jour de bibliothèque de Kodi pour les synchronisations plus petites que cette valeur. 0 l'affiche toujours."

msgctxt "#30306"
msgid "Sync during video playback"
msgstr "Synchroniser pendant la lecture vidéo"

msgctxt "#30307"
msgid "Keep applying library updates while a video is playing."
msgstr "Continue d'appliquer les mises à jour de bibliothèque pendant la lecture d'une vidéo."

msgctxt "#30310"
msgid "Items per request"
msgstr "Éléments par requête"

msgctxt "#30311"
msgid "Page size for library downloads. Recommended: 50."
msgstr "Taille de page pour les téléchargements de bibliothèque. Recommandé : 50."

msgctxt "#30312"
msgid "Download threads"
msgstr "Fils de téléchargement"

msgctxt "#30313"
msgid "Parallel download connections during sync. Recommended: 3; raise only for a fast server."
msgstr "Connexions de téléchargement parallèles pendant la synchronisation. Recommandé : 3 ; à augmenter seulement pour un serveur rapide."

msgctxt "#30314"
msgid "Artwork"
msgstr "Illustrations"

msgctxt "#30318"
msgid "Compress artwork"
msgstr "Compresser les illustrations"

msgctxt "#30319"
msgid "Re-encode capped artwork at JPEG quality 90. No effect without a resolution cap."
msgstr "Réencode les illustrations redimensionnées en JPEG qualité 90. Sans effet s'il n'y a pas de limite de résolution."

msgctxt "#30320"
msgid "Maximum artwork resolution"
msgstr "Résolution maximale des illustrations"

msgctxt "#30321"
msgid "Cap the height of synced artwork. Original keeps the server size."
msgstr "Limite la hauteur des illustrations synchronisées. Original conserve la taille du serveur."

msgctxt "#30322"
msgid "Original"
msgstr "Original"

msgctxt "#30323"
msgid "720p"
msgstr "720p"

