msgctxt "#30041"
msgid "Who's watching?"
msgstr "Kuka katsoo?"

msgctxt "#30042"
msgid "Add a user"
msgstr "Lisää käyttäjä"

msgctxt "#30043"
msgid "Remove a user"
msgstr "Poista käyttäjä"

msgctxt "#30044"
msgid "Select user"
msgstr "Valitse käyttäjä"

msgctxt "#30045"
msgid "No active session on the server yet"
msgstr "Palvelimella ei ole vielä aktiivista istuntoa"

msgctxt "#30046"
msgid "Who's watching? (%s)"
msgstr "Kuka katsoo? (%s)"

msgctxt "#30047"
msgid "Who's watching with %s?"
msgstr "Kuka katsoo yhdessä käyttäjän %s kanssa?"

msgctxt "#30048"
msgid "Who can be added to the session"
msgstr "Ketkä voidaan lisätä istuntoon"

msgctxt "#30250"
msgid "Library"
msgstr "Kirjasto"

msgctxt "#30251"
msgid "Select and manage the Jellyfin libraries mirrored into Kodi's own database."
msgstr "Valitse ja hallitse Kodin omaan tietokantaan peilattavia Jellyfin-kirjastoja."

msgctxt "#30252"
msgid "Select libraries to sync"
msgstr "Valitse synkronoitavat kirjastot"

msgctxt "#30253"
msgid "Choose which server libraries are mirrored into the Kodi library. Changes apply when you confirm the selection."
msgstr "Valitse, mitkä palvelimen kirjastot peilataan Kodin kirjastoon. Muutokset tulevat voimaan, kun vahvistat valinnan."

msgctxt "#30254"
msgid "Synced libraries"
msgstr "Synkronoidut kirjastot"

msgctxt "#30255"
msgid "The libraries currently mirrored into the Kodi database."
msgstr "Tällä hetkellä Kodin tietokantaan peilatut kirjastot."

msgctxt "#30256"
msgid "Update libraries"
msgstr "Päivitä kirjastot"

msgctxt "#30257"
msgid "Catch up with server changes and prune removed items from the libraries you pick. Runs when you confirm the selection."
msgstr "Hae palvelimen muutokset ja karsi poistetut kohteet valitsemistasi kirjastoista. Suoritetaan, kun vahvistat valinnan."

msgctxt "#30258"
msgid "Repair libraries"
msgstr "Korjaa kirjastot"

msgctxt "#30259"
msgid "Remove and re-sync the libraries you pick from scratch, restoring watched state from the server. Runs when you confirm the selection."
msgstr "Poista valitsemasi kirjastot ja synkronoi ne alusta uudelleen sekä palauta katselutila palvelimelta. Suoritetaan, kun vahvistat valinnan."

msgctxt "#30260"
msgid "Refresh boxsets"
msgstr "Päivitä kokoelmat"

msgctxt "#30261"
msgid "Rebuild movie set links from the server's collections. Runs immediately."
msgstr "Rakenna elokuvakokoelmien linkitykset uudelleen palvelimen kokoelmista. Suoritetaan heti."

msgctxt "#30262"
msgid "Sync status"
msgstr "Synkronoinnin tila"

msgctxt "#30263"
msgid "Companion plugin tier and schema-gate state."
msgstr "Apulisäosan taso ja skeemaportin tila."

msgctxt "#30264"
msgid "Remove synced library?"
msgstr "Poistetaanko synkronoitu kirjasto?"

msgctxt "#30265"
msgid "Remove %s from the Kodi library? The items are deleted from this device only."
msgstr "Poistetaanko %s Kodin kirjastosta? Kohteet poistetaan vain tältä laitteelta."

msgctxt "#30266"
msgid "Repair which libraries?"
msgstr "Mitkä kirjastot korjataan?"

msgctxt "#30267"
msgid "All"
msgstr "Kaikki"

msgctxt "#30268"
msgid "Select libraries"
msgstr "Valitse kirjastot"

msgctxt "#30269"
msgid "No libraries available"
msgstr "Ei kirjastoja saatavilla"

msgctxt "#30270"
msgid "Update which libraries?"
msgstr "Mitkä kirjastot päivitetään?"

msgctxt "#30300"
msgid "Sync"
msgstr "Synkronointi"

msgctxt "#30301"
msgid "How library changes are downloaded and written."
msgstr "Miten kirjaston muutokset ladataan ja kirjoitetaan."

msgctxt "#30302"
msgid "Hide update status below (items)"
msgstr "Piilota päivityksen tila alle (kohdetta)"

msgctxt "#30303"
msgid "Hide Kodi's library-update progress for syncs smaller than this. 0 always shows it."
msgstr "Piilota Kodin kirjastopäivityksen edistyminen tätä pienemmiltä synkronoinneilta. 0 näyttää sen aina."

msgctxt "#30306"
msgid "Sync during video playback"
msgstr "Synkronoi videon toiston aikana"

msgctxt "#30307"
msgid "Keep applying library updates while a video is playing."
msgstr "Jatka kirjastopäivitysten kirjoittamista videon toiston aikana."

msgctxt "#30310"
msgid "Items per request"
msgstr "Kohteita pyyntöä kohden"

msgctxt "#30311"
msgid "Page size for library downloads. Recommended: 50."
msgstr "Kirjastolatausten sivukoko. Suositus: 50."

msgctxt "#30312"
msgid "Download threads"
msgstr "Lataussäikeet"

msgctxt "#30313"
msgid "Parallel download connections during sync. Recommended: 3; raise only for a fast server."
