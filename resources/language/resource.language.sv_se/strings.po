# 30250-30299 — Library tab

msgctxt "#30250"
msgid "Library"
msgstr "Bibliotek"

msgctxt "#30251"
msgid "Select and manage the Jellyfin libraries mirrored into Kodi's own database."
msgstr "Välj och hantera de Jellyfin-bibliotek som speglas till Kodis egen databas."

msgctxt "#30252"
msgid "Select libraries to sync"
msgstr "Välj bibliotek att synka"

msgctxt "#30253"
msgid "Choose which server libraries are mirrored into the Kodi library. Changes apply when you confirm the selection."
msgstr "Välj vilka serverbibliotek som speglas till Kodi-biblioteket. Ändringarna tillämpas när du bekräftar valet."

msgctxt "#30254"
msgid "Synced libraries"
msgstr "Synkade bibliotek"

msgctxt "#30255"
msgid "The libraries currently mirrored into the Kodi database."
msgstr "Biblioteken som just nu speglas till Kodi-databasen."

msgctxt "#30256"
msgid "Update libraries"
msgstr "Uppdatera bibliotek"

msgctxt "#30257"
msgid "Catch up with server changes and prune removed items from the libraries you pick. Runs when you confirm the selection."
msgstr "Hämta ikapp serverns ändringar och rensa bort borttagna objekt i de bibliotek du väljer. Körs när du bekräftar valet."

msgctxt "#30258"
msgid "Repair libraries"
msgstr "Reparera bibliotek"

msgctxt "#30259"
msgid "Remove and re-sync the libraries you pick from scratch, restoring watched state from the server. Runs when you confirm the selection."
msgstr "Ta bort och synka om de bibliotek du väljer från grunden, med sett-status återställd från servern. Körs när du bekräftar valet."

msgctxt "#30260"
msgid "Refresh boxsets"
msgstr "Uppdatera filmsamlingar"

msgctxt "#30261"
msgid "Rebuild movie set links from the server's collections. Runs immediately."
msgstr "Bygg om länkarna till filmsamlingar utifrån serverns samlingar. Körs direkt."

msgctxt "#30262"
msgid "Sync status"
msgstr "Synkstatus"

msgctxt "#30263"
msgid "Companion plugin tier and schema-gate state."
msgstr "Nivå på hjälpplugin och status för schemaspärren."

msgctxt "#30264"
msgid "Remove synced library?"
msgstr "Ta bort synkat bibliotek?"

msgctxt "#30265"
msgid "Remove %s from the Kodi library? The items are deleted from this device only."
msgstr "Ta bort %s från Kodi-biblioteket? Objekten raderas endast på den här enheten."

msgctxt "#30266"
msgid "Repair which libraries?"
msgstr "Vilka bibliotek ska repareras?"

msgctxt "#30267"
msgid "All"
msgstr "Alla"

msgctxt "#30268"
msgid "Select libraries"
msgstr "Välj bibliotek"

msgctxt "#30269"
msgid "No libraries available"
msgstr "Inga bibliotek tillgängliga"

msgctxt "#30270"
msgid "Update which libraries?"
msgstr "Vilka bibliotek ska uppdateras?"

# 30300-30349 — Sync tab

msgctxt "#30300"
msgid "Sync"
msgstr "Synk"

msgctxt "#30301"
msgid "How library changes are downloaded and written."
msgstr "Hur biblioteksändringar hämtas och skrivs."

msgctxt "#30302"
msgid "Hide update status below (items)"
msgstr "Dölj uppdateringsstatus under (objekt)"

msgctxt "#30303"
msgid "Hide Kodi's library-update progress for syncs smaller than this. 0 always shows it."
msgstr "Dölj Kodis förlopp för biblioteksuppdatering för synkningar mindre än detta. 0 visar det alltid."

msgctxt "#30306"
msgid "Sync during video playback"
msgstr "Synka under videouppspelning"

msgctxt "#30307"
msgid "Keep applying library updates while a video is playing."
msgstr "Fortsätt tillämpa biblioteksuppdateringar medan en video spelas upp."

msgctxt "#30310"
msgid "Items per request"
msgstr "Objekt per förfrågan"

msgctxt "#30311"
msgid "Page size for library downloads. Recommended: 50."
msgstr "Sidstorlek för bibliotekshämtningar. Rekommenderat: 50."

msgctxt "#30312"
msgid "Download threads"
msgstr "Hämtningstrådar"

msgctxt "#30313"
msgid "Parallel download connections during sync. Recommended: 3; raise only for a fast server."
msgstr "Parallella hämtningsanslutningar under synkning. Rekommenderat: 3; höj bara för en snabb server."

msgctxt "#30314"
msgid "Artwork"
msgstr "Bildmaterial"



msgctxt "#30318"
msgid "Compress artwork"
msgstr "Komprimera bildmaterial"

msgctxt "#30319"
msgid "Re-encode capped artwork at JPEG quality 90. No effect without a resolution cap."
msgstr "Koda om begränsat bildmaterial med JPEG-kvalitet 90. Ingen effekt utan en upplösningsgräns."

msgctxt "#30320"
msgid "Maximum artwork resolution"
msgstr "Maximal upplösning för bildmaterial"

msgctxt "#30321"
msgid "Cap the height of synced artwork. Original keeps the server size."
msgstr "Begränsa höjden på synkat bildmaterial. Original behåller serverns storlek."

msgctxt "#30322"
msgid "Original"
msgstr "Original"

msgctxt "#30323"
msgid "720p"
msgstr "720p"

msgctxt "#30324"
msgid "1080p"
msgstr "1080p"

