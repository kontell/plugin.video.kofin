# Add-on browser metadata. These must stay in step with the en_GB <summary> and
# <description> in addon.xml, which remain the fallback for untranslated locales.

msgctxt "Addon Summary"
msgid "Jellyfin client for seamless Kodi integration"
msgstr "Jellyfin-klient för sömlös Kodi-integration"

msgctxt "Addon Description"
msgid "Play movies, shows & music from a Jellyfin server."
msgstr "Spela upp filmer, serier och musik från en Jellyfin-server."

# 30000-30049 — general / dialogs

msgctxt "#30010"
msgid "Play with transcoding"
msgstr "Spela upp med omkodning"

msgctxt "#30011"
msgid "Quick Connect"
msgstr "Quick Connect"

msgctxt "#30012"
msgid "Username and password"
msgstr "Användarnamn och lösenord"

msgctxt "#30013"
msgid "Username"
msgstr "Användarnamn"

msgctxt "#30014"
msgid "Password"
msgstr "Lösenord"

msgctxt "#30015"
msgid "Enter code [B]%s[/B] in the Jellyfin app or web interface."
msgstr "Ange koden [B]%s[/B] i Jellyfin-appen eller webbgränssnittet."

msgctxt "#30016"
msgid "Logged in as %s"
msgstr "Inloggad som %s"

msgctxt "#30017"
msgid "Login failed: wrong username or password"
msgstr "Inloggningen misslyckades: fel användarnamn eller lösenord"

msgctxt "#30018"
msgid "Server unreachable"
msgstr "Servern är inte nåbar"

msgctxt "#30019"
msgid "Log out from %s?"
msgstr "Logga ut från %s?"

msgctxt "#30020"
msgid "Logged out"
msgstr "Utloggad"

msgctxt "#30021"
msgid "Connection OK — %s (%s)"
msgstr "Anslutning OK — %s (%s)"

msgctxt "#30022"
msgid "Session rejected — log in again from the Account tab"
msgstr "Sessionen avvisades — logga in igen på fliken Konto"

msgctxt "#30023"
msgid "Restarting the Kofin service"
msgstr "Startar om Kofin-tjänsten"

msgctxt "#30024"
msgid "Quick Connect timed out"
msgstr "Tidsgränsen för Quick Connect överskreds"

msgctxt "#30025"
msgid "Already logged in"
msgstr "Redan inloggad"

msgctxt "#30026"
msgid "Not logged in"
msgstr "Inte inloggad"

msgctxt "#30027"
msgid "Log in to %s"
msgstr "Logga in på %s"

# 30050-30099 — Account tab (30066-30067 and 30071-30080: Advanced tab)

msgctxt "#30050"
msgid "Account"
msgstr "Konto"

msgctxt "#30051"
msgid "Connect to your Jellyfin server and manage the session."
msgstr "Anslut till din Jellyfin-server och hantera sessionen."

msgctxt "#30052"
msgid "Server address"
msgstr "Serveradress"

msgctxt "#30053"
msgid "Host name, IP address or full URL of the Jellyfin server. A bare host uses http on port 8096."
msgstr "Värdnamn, IP-adress eller fullständig URL till Jellyfin-servern. Enbart ett värdnamn använder http på port 8096."

msgctxt "#30054"
msgid "Log in…"
msgstr "Logga in…"

msgctxt "#30055"
msgid "Connect to the server above using Quick Connect or a username and password."
msgstr "Anslut till servern ovan med Quick Connect eller med användarnamn och lösenord."

msgctxt "#30056"
msgid "Server"
msgstr "Server"

msgctxt "#30057"
msgid "The connected Jellyfin server."
msgstr "Den anslutna Jellyfin-servern."

msgctxt "#30058"
msgid "Logged-in user"
msgstr "Inloggad användare"

msgctxt "#30059"
msgid "The Jellyfin user this device plays and reports as."
msgstr "Jellyfin-användaren som den här enheten spelar upp och rapporterar som."

msgctxt "#30060"
msgid "Test connection"
msgstr "Testa anslutning"

msgctxt "#30061"
msgid "Check that the server is reachable and the session is still valid."
msgstr "Kontrollera att servern är nåbar och att sessionen fortfarande är giltig."

msgctxt "#30062"
msgid "Log out"
msgstr "Logga ut"

msgctxt "#30063"
msgid "End the session on the server and forget it on this device. The server address is kept."
msgstr "Avsluta sessionen på servern och glöm den på den här enheten. Serveradressen behålls."

msgctxt "#30064"
msgid "Restart Kofin"
msgstr "Starta om Kofin"

msgctxt "#30065"
msgid "Restart the background service without restarting Kodi."
msgstr "Starta om bakgrundstjänsten utan att starta om Kodi."

msgctxt "#30066"
msgid "Verify SSL certificate"
msgstr "Verifiera SSL-certifikat"

msgctxt "#30067"
msgid "Disable only for servers with self-signed certificates."
msgstr "Stäng bara av för servrar med självsignerade certifikat."

msgctxt "#30068"
msgid "Device name"
msgstr "Enhetsnamn"

msgctxt "#30069"
msgid "How this device appears in the Jellyfin dashboard and cast menus."
msgstr "Hur den här enheten visas i Jellyfins kontrollpanel och cast-menyer."

msgctxt "#30070"
msgid "Connection"
msgstr "Anslutning"

msgctxt "#30071"
msgid "Advanced"
msgstr "Avancerat"

msgctxt "#30072"
msgid "SSL verification and other advanced options."
msgstr "SSL-verifiering och andra avancerade alternativ."

msgctxt "#30073"
msgid "Enable Delete from server"
msgstr "Aktivera Ta bort från servern"

msgctxt "#30074"
msgid "Adds a Delete entry to an item's 'Jellyfin actions' context menu. Deletion is permanent: the file itself is removed on the Jellyfin server, for every user."
msgstr "Lägger till Ta bort i objektets snabbmeny ”Jellyfin-åtgärder”. Borttagningen är permanent: själva filen tas bort på Jellyfin-servern, för alla användare."

msgctxt "#30075"
msgid "Delete without confirmation"
msgstr "Ta bort utan bekräftelse"

msgctxt "#30076"
msgid "Delete the item as soon as the entry is picked, with no 'are you sure?' prompt. The deletion is still permanent and applies on the server."
msgstr "Ta bort objektet så snart posten väljs, utan någon ”är du säker?”-fråga. Borttagningen är fortfarande permanent och gäller på servern."

msgctxt "#30077"
msgid "Offer to delete after watching"
msgstr "Erbjud borttagning efter visning"

msgctxt "#30078"
msgid "When a movie or episode finishes, ask whether to delete it from the server. Always asks, whatever 'Delete without confirmation' is set to."
msgstr "När en film eller ett avsnitt är slut, fråga om det ska tas bort från servern. Frågar alltid, oavsett vad ”Ta bort utan bekräftelse” är inställt på."

msgctxt "#30079"
msgid "Who's watching shortlist"
msgstr "Urval för Vem tittar?"

msgctxt "#30080"
msgid "Choose which server users the addon's Who's watching? entry offers. Nothing selected offers everyone."
msgstr "Välj vilka serveranvändare som tilläggets Vem tittar?-post erbjuder. Inget valt erbjuder alla."

# 30030-30049 — browse nodes

msgctxt "#30030"
msgid "All"
msgstr "Alla"

msgctxt "#30031"
msgid "Recently added"
msgstr "Nyligen tillagt"

msgctxt "#30032"
msgid "Next up"
msgstr "Näst på tur"

msgctxt "#30033"
msgid "In progress"
msgstr "Påbörjade"

msgctxt "#30034"
msgid "Unwatched"
msgstr "Osedda"

msgctxt "#30035"
msgid "Favourites"
msgstr "Favoriter"

msgctxt "#30036"
msgid "Genres"
msgstr "Genrer"

msgctxt "#30037"
msgid "Random"
msgstr "Slumpmässigt"

msgctxt "#30038"
msgid "Sets"
msgstr "Filmsamlingar"

msgctxt "#30039"
msgid "Artists"
msgstr "Artister"

msgctxt "#30040"
msgid "Albums"
msgstr "Album"

msgctxt "#30049"
msgid "Continue watching"
msgstr "Fortsätt titta"

# 30100-30203 — Transcoding tab (30150+ are option labels)

msgctxt "#30100"
msgid "Transcoding"
msgstr "Omkodning"

msgctxt "#30101"
msgid "When and how the server converts media for this device."
msgstr "När och hur servern konverterar media för den här enheten."

msgctxt "#30102"
msgid "Force direct play"
msgstr "Tvinga direktuppspelning"

msgctxt "#30103"
msgid "Always play the original video file. Overrides every other video transcoding setting; playback fails if the device cannot handle the media. Music is unaffected — see 'Transcode music'."
msgstr "Spela alltid upp den ursprungliga videofilen. Åsidosätter alla andra inställningar för videoomkodning; uppspelningen misslyckas om enheten inte klarar mediet. Musik påverkas inte — se ”Koda om musik”."

msgctxt "#30104"
msgid "Force remux"
msgstr "Tvinga remuxning"

msgctxt "#30105"
msgid "Repackage the stream without re-encoding video. Use when the container causes problems but the codecs are fine."
msgstr "Packa om strömmen utan att koda om videon. Använd när behållaren orsakar problem men codecarna fungerar."

msgctxt "#30106"
msgid "Force transcode"
msgstr "Tvinga omkodning"

msgctxt "#30107"
msgid "Always re-encode on the server. Highest server load; use for troubleshooting or very constrained clients."
msgstr "Koda alltid om på servern. Högst serverbelastning; använd vid felsökning eller för mycket begränsade klienter."

msgctxt "#30108"
msgid "Direct play video codecs"
msgstr "Videocodecar för direktuppspelning"

msgctxt "#30109"
msgid "Video formats this device can decode. Media using formats not selected here is transcoded."
msgstr "Videoformat som den här enheten kan avkoda. Media med format som inte valts här kodas om."

msgctxt "#30110"
msgid "Direct play audio codecs"
msgstr "Ljudcodecar för direktuppspelning"

msgctxt "#30111"
msgid "Audio formats this device can decode or pass through. Others are transcoded."
msgstr "Ljudformat som den här enheten kan avkoda eller skicka vidare. Övriga kodas om."

msgctxt "#30112"
msgid "Allowed HDR types"
msgstr "Tillåtna HDR-typer"

msgctxt "#30113"
msgid "HDR formats the display accepts. Media in formats not selected is tone-mapped or transcoded to SDR/HDR10 by the server."
msgstr "HDR-format som skärmen accepterar. Media i format som inte valts tonmappas eller kodas om till SDR/HDR10 av servern."

msgctxt "#30114"
msgid "Preferred video codec"
msgstr "Föredragen videocodec"

msgctxt "#30115"
msgid "The codec the server targets when it must transcode video."
msgstr "Codecen som servern siktar på när video måste kodas om."

msgctxt "#30116"
msgid "Preferred audio codec"
msgstr "Föredragen ljudcodec"

msgctxt "#30117"
msgid "The codec the server targets when it must transcode audio."
msgstr "Codecen som servern siktar på när ljud måste kodas om."

msgctxt "#30118"
msgid "Maximum audio channels"
msgstr "Maximalt antal ljudkanaler"

msgctxt "#30119"
msgid "Maximum number of audio channels allowed when transcoding. Streams with more channels will be downmixed. No effect on direct playback."
msgstr "Maximalt antal ljudkanaler som tillåts vid omkodning. Strömmar med fler kanaler nedmixas. Ingen effekt på direktuppspelning."

msgctxt "#30120"
msgid "Maximum streaming bitrate"
msgstr "Maximal strömningsbithastighet"

msgctxt "#30121"
msgid "Media above this bitrate is transcoded down to it. Unlimited suits LAN playback."
msgstr "Media över den här bithastigheten kodas om ned till den. Obegränsat passar uppspelning i lokalt nätverk."

msgctxt "#30122"
msgid "Maximum resolution"
msgstr "Maximal upplösning"

msgctxt "#30123"
msgid "Wider media is downscaled by the server."
msgstr "Bredare media skalas ned av servern."

msgctxt "#30124"
msgid "Transcode audio bitrate"
msgstr "Bithastighet för omkodat ljud"

msgctxt "#30125"
msgid "Bitrate for the audio track when video is transcoded."
msgstr "Bithastighet för ljudspåret när video kodas om."

msgctxt "#30126"
msgid "Context menu bitrates"
msgstr "Bithastigheter i snabbmenyn"

msgctxt "#30127"
msgid "Bitrates offered by 'Play with transcoding'. With exactly one selected the popup is skipped."
msgstr "Bithastigheter som ”Spela upp med omkodning” erbjuder. Med exakt en vald hoppas popupen över."

msgctxt "#30128"
msgid "Music"
msgstr "Musik"

msgctxt "#30129"
msgid "Maximum music bitrate"
msgstr "Maximal bithastighet för musik"

msgctxt "#30130"
msgid "Music above this bitrate is transcoded using the codec and bitrate below. Unlimited never transcodes."
msgstr "Musik över den här bithastigheten kodas om med codecen och bithastigheten nedan. Obegränsat kodar aldrig om."

msgctxt "#30131"
msgid "Music transcode codec"
msgstr "Codec för musikomkodning"

msgctxt "#30132"
msgid "Codec for transcoded music streams."
msgstr "Codec för omkodade musikströmmar."

msgctxt "#30133"
msgid "Music transcode bitrate"
msgstr "Bithastighet för musikomkodning"

msgctxt "#30134"
msgid "Bitrate for transcoded music streams."
msgstr "Bithastighet för omkodade musikströmmar."

msgctxt "#30135"
msgid "Transcode music"
msgstr "Koda om musik"

msgctxt "#30136"
msgid "Route music playback through the add-on so the settings below apply. Off, songs stream straight from the server untouched. Changing this needs a library repair of your music libraries to rewrite their paths."
msgstr "Led musikuppspelningen genom tillägget så att inställningarna nedan gäller. Av: låtar strömmas rakt från servern utan ändring. En ändring kräver en biblioteksreparation av dina musikbibliotek för att skriva om deras sökvägar."

