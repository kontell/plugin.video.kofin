# 30550-30599 — SyncPlay (settings group 30550-30558, menu/toasts 30560+;
# fork ids 33262-33302 remapped)

msgctxt "#30550"
msgid "SyncPlay"
msgstr "SyncPlay"

msgctxt "#30551"
msgid "Enable SyncPlay"
msgstr "Aktivera SyncPlay"

msgctxt "#30552"
msgid "Adds a SyncPlay entry to the addon root for watching in sync with other Jellyfin clients. Off means no group menu and no SyncPlay threads. Works best with Sync Playback to Display turned off in Kodi player settings"
msgstr "Lägger till en SyncPlay-post i tilläggets rot för att titta synkroniserat med andra Jellyfin-klienter. Av innebär ingen gruppmeny och inga SyncPlay-trådar. Fungerar bäst med ”Synkronisera uppspelning till skärm” avstängt i Kodis spelarinställningar"

msgctxt "#30553"
msgid "Drift correction"
msgstr "Driftkorrigering"

msgctxt "#30554"
msgid "Gently adjusts playback speed to hold position with the group (needs Kodi's 'Sync playback to display'). Off: follow scheduled commands only."
msgstr "Justerar uppspelningshastigheten varsamt för att hålla positionen med gruppen (kräver Kodis ”Synkronisera uppspelning till skärm”). Av: följ endast schemalagda kommandon."

msgctxt "#30555"
msgid "Sync tolerance (ms)"
msgstr "Synktolerans (ms)"

msgctxt "#30556"
msgid "Drift below this is left alone; correction engages only past it. Lower is tighter but corrects more often."
msgstr "Drift under detta lämnas ifred; korrigering slår till först därefter. Lägre är stramare men korrigerar oftare."

msgctxt "#30557"
msgid "Group notifications"
msgstr "Gruppaviseringar"

msgctxt "#30558"
msgid "Show member join/leave and group-waiting notifications. Errors are always shown."
msgstr "Visa aviseringar när medlemmar ansluter eller lämnar och när gruppen väntar. Fel visas alltid."

