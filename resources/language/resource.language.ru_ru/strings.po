msgctxt "#30041"
msgid "Who's watching?"
msgstr "Кто смотрит?"

msgctxt "#30042"
msgid "Add a user"
msgstr "Добавить пользователя"

msgctxt "#30043"
msgid "Remove a user"
msgstr "Убрать пользователя"

msgctxt "#30044"
msgid "Select user"
msgstr "Выберите пользователя"

msgctxt "#30045"
msgid "No active session on the server yet"
msgstr "На сервере ещё нет активного сеанса"

msgctxt "#30046"
msgid "Who's watching? (%s)"
msgstr "Кто смотрит? (%s)"

msgctxt "#30047"
msgid "Who's watching with %s?"
msgstr "Кто смотрит вместе с %s?"

msgctxt "#30048"
msgid "Who can be added to the session"
msgstr "Кого можно добавить к сеансу"

msgctxt "#30250"
msgid "Library"
msgstr "Библиотека"

msgctxt "#30251"
msgid "Select and manage the Jellyfin libraries mirrored into Kodi's own database."
msgstr "Выбор библиотек Jellyfin, зеркалируемых в собственную базу данных Kodi, и управление ими."

msgctxt "#30252"
msgid "Select libraries to sync"
msgstr "Выбрать библиотеки для синхронизации"

msgctxt "#30253"
msgid "Choose which server libraries are mirrored into the Kodi library. Changes apply when you confirm the selection."
msgstr "Выберите, какие библиотеки сервера зеркалируются в библиотеку Kodi. Изменения применяются после подтверждения выбора."

msgctxt "#30254"
msgid "Synced libraries"
msgstr "Синхронизированные библиотеки"

msgctxt "#30255"
msgid "The libraries currently mirrored into the Kodi database."
msgstr "Библиотеки, зеркалируемые в базу данных Kodi в настоящее время."

msgctxt "#30256"
msgid "Update libraries"
msgstr "Обновить библиотеки"

msgctxt "#30257"
msgid "Catch up with server changes and prune removed items from the libraries you pick. Runs when you confirm the selection."
msgstr "Догнать изменения на сервере и убрать удалённые элементы из выбранных вами библиотек. Выполняется после подтверждения выбора."

msgctxt "#30258"
msgid "Repair libraries"
msgstr "Восстановить библиотеки"

msgctxt "#30259"
msgid "Remove and re-sync the libraries you pick from scratch, restoring watched state from the server. Runs when you confirm the selection."
msgstr "Удалить и заново синхронизировать выбранные библиотеки с нуля, восстановив состояние просмотра с сервера. Выполняется после подтверждения выбора."

msgctxt "#30260"
msgid "Refresh boxsets"
msgstr "Обновить наборы фильмов"

msgctxt "#30261"
msgid "Rebuild movie set links from the server's collections. Runs immediately."
msgstr "Пересобрать связи наборов фильмов по коллекциям сервера. Выполняется сразу."

msgctxt "#30262"
msgid "Sync status"
msgstr "Состояние синхронизации"

