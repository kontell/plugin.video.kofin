msgstr "Синхронізуватися з групою"

msgctxt "#30574"
msgid "SyncPlay is unavailable (server not reachable?)"
msgstr "SyncPlay недоступний (сервер недосяжний?)"

msgctxt "#30575"
msgid "External players cannot be synchronized"
msgstr "Зовнішні програвачі неможливо синхронізувати"

msgctxt "#30576"
msgid "Playback could not be synchronized"
msgstr "Не вдалося синхронізувати відтворення"

msgctxt "#30577"
