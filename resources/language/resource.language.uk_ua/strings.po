msgid "Permanently delete \"%s\" from the server? This cannot be undone."
msgstr "Остаточно видалити \"%s\" із сервера? Це не можна скасувати."

msgctxt "#30506"
msgid "Finished \"%s\". Permanently delete it from the server? This cannot be undone."
msgstr "Перегляд \"%s\" завершено. Остаточно видалити його із сервера? Це не можна скасувати."

msgctxt "#30507"
msgid "Server request failed"
msgstr "Запит до сервера не вдався"

msgctxt "#30508"
