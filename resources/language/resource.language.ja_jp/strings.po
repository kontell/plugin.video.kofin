msgctxt "#30041"
msgid "Who's watching?"
msgstr "誰が視聴中？"

msgctxt "#30042"
msgid "Add a user"
msgstr "ユーザーを追加"

msgctxt "#30043"
msgid "Remove a user"
msgstr "ユーザーを削除"

msgctxt "#30044"
msgid "Select user"
msgstr "ユーザーを選択"

msgctxt "#30045"
msgid "No active session on the server yet"
msgstr "サーバーにアクティブなセッションがまだありません"

msgctxt "#30046"
msgid "Who's watching? (%s)"
msgstr "誰が視聴中？（%s）"

msgctxt "#30047"
msgid "Who's watching with %s?"
msgstr "%s と誰が一緒に視聴中？"

msgctxt "#30048"
msgid "Who can be added to the session"
msgstr "セッションに追加できるユーザー"

msgctxt "#30250"
msgid "Library"
msgstr "ライブラリ"

msgctxt "#30251"
msgid "Select and manage the Jellyfin libraries mirrored into Kodi's own database."
msgstr "Kodi のデータベースに取り込む Jellyfin ライブラリを選択し、管理します。"

msgctxt "#30252"
msgid "Select libraries to sync"
msgstr "同期するライブラリを選択"

msgctxt "#30253"
msgid "Choose which server libraries are mirrored into the Kodi library. Changes apply when you confirm the selection."
msgstr "Kodi のライブラリに取り込むサーバーのライブラリを選びます。選択を確定すると変更が適用されます。"

msgctxt "#30254"
msgid "Synced libraries"
msgstr "同期中のライブラリ"

msgctxt "#30255"
msgid "The libraries currently mirrored into the Kodi database."
msgstr "現在 Kodi のデータベースに取り込まれているライブラリ。"

msgctxt "#30256"
msgid "Update libraries"
msgstr "ライブラリを更新"

msgctxt "#30257"
msgid "Catch up with server changes and prune removed items from the libraries you pick. Runs when you confirm the selection."
msgstr "選んだライブラリについて、サーバー側の変更を取り込み、削除されたアイテムを整理します。選択を確定すると実行されます。"

msgctxt "#30258"
msgid "Repair libraries"
msgstr "ライブラリを修復"

msgctxt "#30259"
msgid "Remove and re-sync the libraries you pick from scratch, restoring watched state from the server. Runs when you confirm the selection."
msgstr "選んだライブラリを削除して最初から同期し直し、視聴済みの状態をサーバーから復元します。選択を確定すると実行されます。"

msgctxt "#30260"
msgid "Refresh boxsets"
msgstr "ボックスセットを再構築"

msgctxt "#30261"
msgid "Rebuild movie set links from the server's collections. Runs immediately."
msgstr "サーバーのコレクションから、映画セットのリンクを再構築します。すぐに実行されます。"

msgctxt "#30262"
msgid "Sync status"
msgstr "同期の状態"

msgctxt "#30263"
msgid "Companion plugin tier and schema-gate state."
msgstr "コンパニオンプラグインの種類とスキーマゲートの状態。"

msgctxt "#30264"
msgid "Remove synced library?"
msgstr "同期したライブラリを削除しますか？"

msgctxt "#30265"
msgid "Remove %s from the Kodi library? The items are deleted from this device only."
msgstr "%s を Kodi のライブラリから削除しますか？アイテムはこのデバイスからのみ削除されます。"

msgctxt "#30266"
msgid "Repair which libraries?"
msgstr "どのライブラリを修復しますか？"

