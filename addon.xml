<?xml version="1.0" encoding="UTF-8"?>
<addon id="plugin.video.kofin" name="Kofin" version="0.6.1" provider-name="kontell">
  <requires>
    <import addon="xbmc.python" version="3.0.1"/>
    <import addon="script.module.requests" version="2.22.0+matrix.1"/>
    <import addon="script.module.websocket" version="1.6.4"/>
    <!-- Renders the lyrics kofin publishes. Not optional: Kodi does not
         install optional dependencies, and lyrics are meant to work without
         the viewer hunting for a second addon. Served from the same
         repository as kofin, so it resolves. -->
    <import addon="script.kofin.lyrics" version="0.1.0"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="default.py">
    <provides>video audio image</provides>
    <reuselanguageinvoker>true</reuselanguageinvoker>
  </extension>
  <extension point="xbmc.service" library="service.py" start="login"/>
  <extension point="kodi.context.item">
    <menu id="kodi.core.main">
      <item library="context_manage.py">
        <label>30502</label>
        <!-- Jellyfin actions (favorites/delete/settings). kofin browse items
             carry kofin.id; synced video-library items resolve through
             kofin.db. Declared first so it sits above Play with transcoding. -->
        <visible>!String.IsEmpty(ListItem.Property(kofin.id)) | String.IsEqual(ListItem.DBTYPE,movie) | String.IsEqual(ListItem.DBTYPE,episode) | String.IsEqual(ListItem.DBTYPE,musicvideo) | String.IsEqual(ListItem.DBTYPE,tvshow) | String.IsEqual(ListItem.DBTYPE,season) | String.IsEqual(ListItem.DBTYPE,set)</visible>
      </item>
      <item library="context_play.py">
        <label>30010</label>
        <!-- kofin browse items carry kofin.id; synced library items are
             recognized by their DBTYPE and resolved through kofin.db. The
             trailing clause hides the item outright when no context bitrates
             are configured — there would be nothing to offer. The service
             mirrors that setting into the window property because a visible
             condition has no way to read an addon setting (core/state.py).
             Grouping is [square brackets]: parentheses are infolabel argument
             syntax, and using them here fails the whole expression to parse
             ("Error parsing boolean expression"), which reads as the item
             simply never appearing. -->
        <visible>[!String.IsEmpty(ListItem.Property(kofin.id)) | String.IsEqual(ListItem.DBTYPE,movie) | String.IsEqual(ListItem.DBTYPE,episode) | String.IsEqual(ListItem.DBTYPE,musicvideo)] + !String.IsEmpty(Window(Home).Property(kofin.context.bitrates))</visible>
      </item>
      <item library="context_extras.py">
        <label>30501</label>
        <!-- TV extras are a plugin browse (no native Kodi TV extras);
             library shows/seasons resolve through kofin.db. -->
        <visible>String.IsEqual(ListItem.DBTYPE,tvshow) | String.IsEqual(ListItem.DBTYPE,season)</visible>
      </item>
    </menu>
  </extension>
  <extension point="xbmc.addon.metadata">
    <platform>all</platform>
    <license>GPL-3.0-only</license>
    <source>https://github.com/kontell/plugin.video.kofin</source>
    <summary lang="en_GB">Jellyfin client with native Kodi integration</summary>
    <description lang="en_GB">Play media from a Jellyfin server.</description>
    <assets>
      <icon>resources/media/icon.png</icon>
    </assets>
  </extension>
</addon>
